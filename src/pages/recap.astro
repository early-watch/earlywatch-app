---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Recap — Early Watch" activePage="recap">

  <style is:global>
    /* ── Page Recap ──────────────────────────────────────────────── */
    /* is:global requis : les cartes/labels sont créés côté client (makeCard, JS),
       donc ils ne portent pas l'attribut de scope Astro — un <style> scopé
       laisserait ces éléments dynamiques sans style (cartes brutes). */
    .recap-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .recap-title {
      font-size: 22px;
      font-weight: 500;
      color: var(--ink);
      letter-spacing: -0.015em;
    }

    /* ── Onglets — alignés design system (.ew-tabs) ──────────────── */
    .recap-tabs {
      display: flex;
      gap: 24px;
      border-bottom: 0.5px solid var(--line);
      margin-bottom: 20px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .recap-tab {
      padding: 4px 0 14px;
      color: var(--mute);
      background: none;
      border: none;
      border-bottom: 1.5px solid transparent;
      margin-bottom: -0.5px;
      cursor: pointer;
      font-family: inherit;
      font-size: inherit;
      letter-spacing: inherit;
      text-transform: inherit;
      transition: color 0.12s;
      position: relative;
    }
    .recap-tab:hover { color: var(--ink-soft); }
    .recap-tab.active {
      color: var(--ink);
      font-weight: 500;
      border-bottom-color: var(--ew-kaki);
    }

    /* ── Barre date + publier ────────────────────────────────────── */
    .recap-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
      gap: 12px;
      flex-wrap: wrap;
    }
    .recap-date-select {
      font-family: var(--font);
      font-size: 13px;
      color: var(--ink);
      background: var(--bg-side);
      border: 0.5px solid var(--line-strong);
      border-radius: 4px;
      padding: 6px 10px;
      cursor: pointer;
      outline: none;
      transition: border-color 0.15s;
    }
    .recap-date-select:focus { border-color: var(--ew-kaki); }
    .recap-month-input {
      font-family: var(--font);
      font-size: 13px;
      color: var(--ink);
      background: var(--bg-side);
      border: 0.5px solid var(--line-strong);
      border-radius: 4px;
      padding: 6px 10px;
      cursor: pointer;
      outline: none;
      transition: border-color 0.15s;
    }
    .recap-month-input:focus { border-color: var(--ew-kaki); }
    .recap-period-label {
      font-size: 12px;
      color: var(--taupe);
    }
    .recap-published-badge {
      font-size: 11px;
      color: var(--ew-kaki);
      background: var(--ew-kaki-bg);
      border-radius: 4px;
      padding: 3px 8px;
      font-weight: 500;
      display: none;
    }
    .btn-publish {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 14px;
      font-size: 13px;
      font-weight: 500;
      font-family: var(--font);
      background: var(--ew-kaki);
      color: #fff;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: opacity 0.15s;
    }
    .btn-publish:hover:not(:disabled) { opacity: 0.88; }
    .btn-publish:disabled {
      background: var(--ghost);
      cursor: not-allowed;
    }

    /* ── Liste articles ──────────────────────────────────────────── */
    #recap-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    /* En-tête de jour = label de section kaki (cf. design system) */
    .recap-day-header {
      font-family: var(--font-mono);
      font-size: 10.5px;
      font-weight: 500;
      color: var(--ew-kaki);
      text-transform: uppercase;
      letter-spacing: 0.16em;
      padding: 4px 0 8px;
      margin-top: 20px;
    }
    .recap-day-header:first-child { margin-top: 4px; }

    /* ── Carte article ───────────────────────────────────────────── */
    .recap-card {
      background: var(--bg-side);
      border: 0.5px solid var(--line-strong);
      border-radius: 8px;                 /* valeur nommée par Maria (cf. incohérence tokens) */
      padding: 12px 14px;
      transition: opacity 0.2s, border-color 0.15s;
    }
    .recap-card.excluded { opacity: 0.38; }
    /* Le résumé étant repliable, la carte devient cliquable quand elle est dépliable */
    .recap-card.is-expandable { cursor: pointer; }
    .recap-card.is-expandable:hover { border-color: var(--ew-kaki-border-hover); }

    /* Ligne compacte : chevron | corps | bouton exclure */
    .recap-card-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
    }
    .recap-chevron {
      flex-shrink: 0;
      width: 16px;
      height: 16px;
      margin-top: 1px;
      color: var(--mute);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s, color 0.15s;
    }
    .recap-card.is-open .recap-chevron { transform: rotate(90deg); color: var(--ew-kaki); }
    /* Espace réservé quand la carte n'a pas de résumé (pas de chevron) */
    .recap-chevron-spacer { flex-shrink: 0; width: 16px; }
    .recap-card-body {
      flex: 1;
      min-width: 0;
    }
    .recap-card-title {
      font-size: 13px;
      font-weight: 500;
      color: var(--ink);
      text-decoration: none;
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .recap-card-title:hover { text-decoration: underline; }
    .recap-card-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }
    .recap-card-source {
      font-size: 11px;
      color: var(--taupe);
      font-weight: 500;
    }
    .recap-card-date {
      font-size: 11px;
      color: var(--mute);
    }

    /* Résumé replié par défaut, déplié via .is-open */
    .recap-card-summary {
      display: none;
      margin-top: 10px;
      padding-top: 10px;
      padding-left: 26px;               /* aligné sous le titre (largeur chevron + gap) */
      border-top: 0.5px solid var(--line);
      font-size: 12.5px;
      line-height: 1.6;
      color: var(--ink-soft);
    }
    .recap-card.is-open .recap-card-summary { display: block; }

    .btn-exclude {
      flex-shrink: 0;
      padding: 4px 10px;
      font-size: 11px;
      font-family: var(--font);
      color: var(--taupe);
      background: transparent;
      border: 0.5px solid var(--line-strong);
      border-radius: 4px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .btn-exclude:hover { background: var(--bg-hover); color: var(--ink); }
    .btn-exclude.is-excluded {
      color: var(--ew-kaki);
      border-color: var(--ew-kaki);
      background: var(--ew-kaki-bg);
    }

    /* ── États de chargement / vide ──────────────────────────────── */
    .recap-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 56px 32px;
      text-align: center;
      color: var(--mute);
      font-size: 13px;
      line-height: 1.55;
    }
    .recap-loading {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px;
      color: var(--mute);
      font-size: 13px;
    }
    .ew-spinner {
      width: 18px;
      height: 18px;
      border: 2px solid var(--line-strong);
      border-top-color: var(--ew-kaki);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      margin-right: 10px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Modal ───────────────────────────────────────────────────── */
    .ew-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(26,25,24,0.32);
      z-index: 100;
    }
    .ew-modal-box {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #fff;
      border: 1px solid var(--line-strong);
      border-radius: 8px;
      padding: 24px;
      width: 380px;
      max-width: calc(100vw - 40px);
      z-index: 101;
    }
    .ew-modal-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 10px;
    }
    .ew-modal-msg {
      font-size: 13px;
      color: var(--taupe);
      margin-bottom: 20px;
      line-height: 1.5;
    }
    .ew-modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }
    .btn-modal-cancel {
      padding: 7px 16px;
      font-size: 13px;
      font-family: var(--font);
      background: none;
      border: 1px solid var(--line-strong);
      border-radius: 4px;
      cursor: pointer;
      color: var(--taupe);
    }
    .btn-modal-cancel:hover { border-color: var(--ink); color: var(--ink); }
    .btn-modal-ok {
      padding: 7px 16px;
      font-size: 13px;
      font-weight: 500;
      font-family: var(--font);
      background: var(--ew-kaki);
      color: #fff;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: opacity 0.15s;
    }
    .btn-modal-ok:hover { opacity: 0.88; }
    .btn-modal-ok:disabled { opacity: 0.5; cursor: not-allowed; }
  </style>

  <div class="recap-header">
    <h1 class="recap-title">Recap</h1>
  </div>

  <!-- Onglets -->
  <div class="recap-tabs">
    <button class="recap-tab active" id="tab-quotidien" data-tab="quotidien">Quotidien</button>
    <button class="recap-tab" id="tab-hebdo" data-tab="hebdo">Hebdo</button>
    <button class="recap-tab" id="tab-mensuel" data-tab="mensuel">Mensuel</button>
  </div>

  <!-- Contrôles : sélecteur date + badge + bouton publier (injecté par JS) -->
  <div class="recap-controls" id="recap-controls"></div>

  <!-- Liste articles -->
  <div id="recap-list">
    <div class="recap-loading"><div class="ew-spinner"></div>Chargement…</div>
  </div>

  <!-- Modal confirmation publication -->
  <div id="modal-confirm" style="display:none" role="dialog" aria-modal="true">
    <div class="ew-modal-overlay" id="modal-confirm-overlay"></div>
    <div class="ew-modal-box">
      <p class="ew-modal-title" id="modal-confirm-title"></p>
      <p class="ew-modal-msg" id="modal-confirm-msg"></p>
      <div class="ew-modal-actions">
        <button class="btn-modal-cancel" id="btn-modal-cancel">Annuler</button>
        <button class="btn-modal-ok" id="btn-modal-ok">Publier</button>
      </div>
    </div>
  </div>

  <!-- Modal fallback presse-papier -->
  <div id="modal-clipboard" style="display:none" role="dialog" aria-modal="true">
    <div class="ew-modal-overlay" id="modal-clipboard-overlay"></div>
    <div class="ew-modal-box" style="width:560px">
      <p class="ew-modal-title">Copie manuelle</p>
      <p class="ew-modal-msg">La copie automatique a échoué. Sélectionnez et copiez le contenu ci-dessous :</p>
      <textarea id="clipboard-markdown"
        style="width:100%;height:200px;font-family:var(--font-mono);font-size:11px;
               border:1px solid var(--line-strong);border-radius:4px;padding:8px;
               resize:vertical;color:var(--ink)"
        readonly></textarea>
      <div class="ew-modal-actions" style="margin-top:12px">
        <button class="btn-modal-cancel" id="btn-clipboard-close">Fermer</button>
        <button class="btn-modal-ok" id="btn-clipboard-copy">Copier</button>
      </div>
    </div>
  </div>

</AppLayout>

<script>
  import { api, toast, formatDate } from '../scripts/api';
  import { bootstrapAuth } from '../scripts/bootstrap-auth';

  // ── Types & constantes ───────────────────────────────────────────────────
  type Mode = 'quotidien' | 'hebdo' | 'mensuel';

  // ── État global ──────────────────────────────────────────────────────────
  let mode: Mode = 'quotidien';

  // Quotidien
  let qDate: string = '';

  // Hebdo
  let hebdoWeekStart: string = '';
  let hebdoWeekEnd: string = '';

  // Mensuel
  let mensuelYear: number = 0;
  let mensuelMonth: number = 0;   // 1-12
  let mensuelPeriodStart: string = ''; // YYYY-MM-01 (pour exclusions)

  // Partagé
  let currentArticles: any[] = [];
  let currentMarkdown: string = '';
  let excludedIds = new Set<string>();
  let isPublished = false;
  let publishedAt: string | null = null;

  // ── Utilitaires ──────────────────────────────────────────────────────────
  function escHtml(s: string): string {
    return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  /** Extrait le texte lisible d'un summary HTML brut (flux RSS : <div>/<img>…).
   *  DOMParser parse dans un document détaché → n'exécute aucun script et ne charge
   *  aucune image ; on ne garde que textContent, espaces normalisés. Le summary brut
   *  reste intact côté API/DB (article_get) — on ne strip qu'à l'affichage. */
  function stripHtml(s: string): string {
    if (!s) return '';
    const doc = new DOMParser().parseFromString(s, 'text/html');
    return (doc.body.textContent || '').replace(/\s+/g, ' ').trim();
  }

  /** Retourne le lundi de la semaine écoulée (semaine précédente). */
  function lastWeekMonday(): Date {
    const today = new Date();
    // Lundi de la semaine courante
    const thisMonday = new Date(today);
    thisMonday.setDate(today.getDate() - ((today.getDay() + 6) % 7));
    // Lundi de la semaine précédente
    const last = new Date(thisMonday);
    last.setDate(thisMonday.getDate() - 7);
    return last;
  }

  /** Retourne les N derniers lundis (du plus récent au plus ancien). */
  function lastNMondays(n: number): Date[] {
    const mondays: Date[] = [];
    const today = new Date();
    // Lundi de la semaine courante (inclus comme max navigable)
    let d = new Date(today);
    d.setDate(today.getDate() - ((today.getDay() + 6) % 7));
    for (let i = 0; i < n; i++) {
      mondays.push(new Date(d));
      d.setDate(d.getDate() - 7);
    }
    return mondays;
  }

  function toISO(d: Date): string {
    return d.toISOString().slice(0, 10);
  }

  function addDays(d: Date, n: number): Date {
    const r = new Date(d);
    r.setDate(r.getDate() + n);
    return r;
  }

  function formatWeekLabel(monday: Date): string {
    const sunday = addDays(monday, 6);
    const opts: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'long' };
    const mLabel = monday.toLocaleDateString('fr-FR', opts);
    const sLabel = sunday.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    return `Semaine du ${mLabel} au ${sLabel}`;
  }

  function formatMonthLabel(y: number, m: number): string {
    const d = new Date(y, m - 1, 1);
    return d.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
  }

  /** Retourne "YYYY-MM" du mois écoulé (mois précédent). */
  function lastMonthValue(): string {
    const now = new Date();
    const y = now.getMonth() === 0 ? now.getFullYear() - 1 : now.getFullYear();
    const m = now.getMonth() === 0 ? 12 : now.getMonth();
    return `${y}-${String(m).padStart(2, '0')}`;
  }

  /** Retourne "YYYY-MM" du mois courant (max pour l'input). */
  function currentMonthValue(): string {
    const now = new Date();
    return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
  }

  // ── Initialisation des contrôles selon le mode ───────────────────────────
  function initControls(m: Mode): void {
    const ctrl = document.getElementById('recap-controls')!;

    if (m === 'quotidien') {
      // Sélecteur liste déroulante J (aujourd'hui) à J-30
      const sel = document.createElement('select');
      sel.id = 'recap-date-select';
      sel.className = 'recap-date-select';
      const now = new Date();
      for (let i = 0; i <= 30; i++) {
        const d = new Date(now);
        d.setDate(d.getDate() - i);
        const iso = toISO(d);
        const label = d.toLocaleDateString('fr-FR', {
          weekday: 'short', day: 'numeric', month: 'short', year: 'numeric',
        });
        const opt = document.createElement('option');
        opt.value = iso;
        opt.textContent = label;
        if (i === 0) opt.selected = true;
        sel.appendChild(opt);
      }
      qDate = sel.value;
      sel.addEventListener('change', () => { qDate = sel.value; loadData(); });

      ctrl.innerHTML = '';
      const left = document.createElement('div');
      left.style.cssText = 'display:flex;align-items:center;gap:10px';
      const label = document.createElement('label');
      label.htmlFor = 'recap-date-select';
      label.style.cssText = 'font-size:12px;color:var(--taupe)';
      label.textContent = 'Date :';
      const badge = document.createElement('span');
      badge.className = 'recap-published-badge';
      badge.id = 'published-badge';
      left.append(label, sel, badge);

      const btn = document.createElement('button');
      btn.className = 'btn-publish';
      btn.id = 'btn-publish';
      btn.disabled = true;
      btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 16 16" fill="none"><rect x="5" y="5" width="9" height="9" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M3 11H2a1 1 0 01-1-1V2a1 1 0 011-1h8a1 1 0 011 1v1" stroke="currentColor" stroke-width="1.5"/></svg> Copier Quotidien`;
      btn.addEventListener('click', () => publishQuotidien());

      ctrl.append(left, btn);

    } else if (m === 'hebdo') {
      const mondays = lastNMondays(13); // lundi courant + 12 semaines passées
      const sel = document.createElement('select');
      sel.id = 'recap-hebdo-select';
      sel.className = 'recap-date-select';
      mondays.forEach((mon, i) => {
        const opt = document.createElement('option');
        opt.value = toISO(mon);
        opt.textContent = formatWeekLabel(mon);
        if (i === 1) opt.selected = true; // semaine écoulée par défaut
        sel.appendChild(opt);
      });
      hebdoWeekStart = sel.value;
      sel.addEventListener('change', () => { hebdoWeekStart = sel.value; loadData(); });

      ctrl.innerHTML = '';
      const left = document.createElement('div');
      left.style.cssText = 'display:flex;align-items:center;gap:10px';
      left.append(sel);

      const btn = document.createElement('button');
      btn.className = 'btn-publish';
      btn.id = 'btn-publish';
      btn.disabled = true;
      btn.textContent = 'Publier Hebdo';
      btn.addEventListener('click', () => showPublishModal());

      ctrl.append(left, btn);

    } else { // mensuel
      const inp = document.createElement('input');
      inp.type = 'month';
      inp.id = 'recap-month-input';
      inp.className = 'recap-month-input';
      inp.max = currentMonthValue();
      inp.value = lastMonthValue();
      const [y, mo] = inp.value.split('-').map(Number);
      mensuelYear = y;
      mensuelMonth = mo;
      mensuelPeriodStart = `${inp.value}-01`;
      inp.addEventListener('change', () => {
        const [ny, nm] = inp.value.split('-').map(Number);
        mensuelYear = ny;
        mensuelMonth = nm;
        mensuelPeriodStart = `${inp.value}-01`;
        loadData();
      });

      ctrl.innerHTML = '';
      const left = document.createElement('div');
      left.style.cssText = 'display:flex;align-items:center;gap:10px';
      const lbl = document.createElement('label');
      lbl.htmlFor = 'recap-month-input';
      lbl.style.cssText = 'font-size:12px;color:var(--taupe)';
      lbl.textContent = 'Mois :';
      left.append(lbl, inp);

      const btn = document.createElement('button');
      btn.className = 'btn-publish';
      btn.id = 'btn-publish';
      btn.disabled = true;
      btn.textContent = 'Publier Mensuel';
      btn.addEventListener('click', () => showPublishModal());

      ctrl.append(left, btn);
    }
  }

  // ── Chargement données ───────────────────────────────────────────────────
  async function loadData(): Promise<void> {
    const listEl = document.getElementById('recap-list')!;
    listEl.innerHTML = '<div class="recap-loading"><div class="ew-spinner"></div>Chargement…</div>';
    excludedIds.clear();
    const publishBtn = document.getElementById('btn-publish') as HTMLButtonElement | null;
    if (publishBtn) publishBtn.disabled = true;
    if (mode === 'quotidien') {
      const badge = document.getElementById('published-badge');
      if (badge) badge.style.display = 'none';
    }

    try {
      if (mode === 'quotidien') {
        const data = await api(`/api/v1/recap/quotidien?date=${qDate}`);
        currentArticles = data.articles || [];
        currentMarkdown = data.markdown || '';
        isPublished = data.is_published || false;
        publishedAt = data.published_at || null;
        updatePublishedBadge(isPublished, publishedAt);

      } else if (mode === 'hebdo') {
        const data = await api(`/api/v1/recap/hebdo?week_start=${hebdoWeekStart}`);
        currentArticles = data.articles || [];
        currentMarkdown = data.markdown || '';
        hebdoWeekEnd = data.week_end || '';

      } else { // mensuel
        const data = await api(`/api/v1/recap/mensuel?year=${mensuelYear}&month=${mensuelMonth}`);
        currentArticles = data.articles || [];
        currentMarkdown = data.markdown || '';
      }

      renderArticles();

    } catch (e: any) {
      listEl.innerHTML = `<div class="recap-empty">Erreur de chargement : ${escHtml(e.message)}</div>`;
    }
  }

  // ── Rendu liste articles ─────────────────────────────────────────────────
  function renderArticles(): void {
    const listEl = document.getElementById('recap-list')!;
    const publishBtn = document.getElementById('btn-publish') as HTMLButtonElement | null;

    const included = currentArticles.filter(a => !excludedIds.has(a.id));

    if (currentArticles.length === 0) {
      const label = mode === 'quotidien' ? 'Quotidien'
                  : mode === 'hebdo'     ? 'Hebdo'
                  :                        'Mensuel';
      listEl.innerHTML = `
        <div class="recap-empty">
          <span style="font-size:14px;font-weight:500;color:var(--ink)">Aucun article ${escHtml(label)}</span>
          <span>Rien à publier pour cette période.</span>
        </div>`;
      if (publishBtn) publishBtn.disabled = true;
      return;
    }

    if (publishBtn) publishBtn.disabled = included.length === 0;

    listEl.innerHTML = '';

    // Grouper par jour (ordre chronologique)
    if (mode === 'hebdo') {
      renderGroupedByDay(listEl);
    } else if (mode === 'mensuel') {
      renderGroupedByWeek(listEl);
    } else {
      // Quotidien : pas de regroupement
      currentArticles.forEach(art => listEl.appendChild(makeCard(art)));
    }
  }

  function renderGroupedByDay(container: HTMLElement): void {
    const byDay = new Map<string, any[]>();
    currentArticles.forEach(art => {
      const day = art.published_at ? art.published_at.slice(0, 10) : 'sans-date';
      if (!byDay.has(day)) byDay.set(day, []);
      byDay.get(day)!.push(art);
    });
    // Trier par date croissante
    const sorted = [...byDay.entries()].sort(([a], [b]) => a.localeCompare(b));
    sorted.forEach(([day, arts]) => {
      const header = document.createElement('div');
      header.className = 'recap-day-header';
      if (day === 'sans-date') {
        header.textContent = 'Sans date';
      } else {
        const d = new Date(day + 'T12:00:00');
        header.textContent = d.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
      }
      container.appendChild(header);
      arts.forEach(art => container.appendChild(makeCard(art)));
    });
  }

  function renderGroupedByWeek(container: HTMLElement): void {
    // Pour le mensuel, grouper par semaine ISO
    const byWeek = new Map<string, any[]>();
    currentArticles.forEach(art => {
      const day = art.published_at ? art.published_at.slice(0, 10) : 'sans-date';
      let weekKey = day;
      if (day !== 'sans-date') {
        const d = new Date(day + 'T12:00:00');
        const mon = new Date(d);
        mon.setDate(d.getDate() - ((d.getDay() + 6) % 7));
        weekKey = toISO(mon);
      }
      if (!byWeek.has(weekKey)) byWeek.set(weekKey, []);
      byWeek.get(weekKey)!.push(art);
    });
    const sorted = [...byWeek.entries()].sort(([a], [b]) => a.localeCompare(b));
    sorted.forEach(([weekStart, arts]) => {
      const header = document.createElement('div');
      header.className = 'recap-day-header';
      if (weekStart === 'sans-date') {
        header.textContent = 'Sans date';
      } else {
        const mon = new Date(weekStart + 'T12:00:00');
        header.textContent = formatWeekLabel(mon);
      }
      container.appendChild(header);
      arts.forEach(art => container.appendChild(makeCard(art)));
    });
  }

  function makeCard(art: any): HTMLElement {
    const isExcluded = excludedIds.has(art.id);

    // Dégradation gracieuse : le champ `summary` n'arrive qu'après le deploy
    // de la PR backend #85. Si absent/vide → pas de chevron, carte non dépliable.
    // Option A : le summary de flux RSS contient souvent du HTML brut ; on affiche le
    // TEXTE lisible (balises retirées). hasSummary est calculé sur le texte strippé →
    // pas de chevron/carte dépliable vide pour un résumé qui ne serait qu'une image.
    const summary = stripHtml(typeof art.summary === 'string' ? art.summary : '');
    const hasSummary = summary.length > 0;

    const card = document.createElement('div');
    card.className = `recap-card${isExcluded ? ' excluded' : ''}${hasSummary ? ' is-expandable' : ''}`;
    card.dataset.id = art.id;

    const dateStr = art.published_at ? formatDate(art.published_at) : '—';

    // Chevron uniquement si un résumé est disponible ; sinon spacer pour aligner.
    const chevronHtml = hasSummary
      ? `<span class="recap-chevron" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 2.5L8 6l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>`
      : `<span class="recap-chevron-spacer" aria-hidden="true"></span>`;

    const summaryHtml = hasSummary
      ? `<div class="recap-card-summary">${escHtml(summary)}</div>`
      : '';

    card.innerHTML = `
      <div class="recap-card-head">
        ${chevronHtml}
        <div class="recap-card-body">
          <a class="recap-card-title" href="${escHtml(art.original_url || '#')}"
             target="_blank" rel="noopener" title="${escHtml(art.title)}">${escHtml(art.title)}</a>
          <div class="recap-card-meta">
            <span class="recap-card-source">${escHtml(art.source_name || '')}</span>
            <span class="recap-card-date">${dateStr}</span>
          </div>
        </div>
        <button class="btn-exclude${isExcluded ? ' is-excluded' : ''}" data-id="${art.id}">
          ${isExcluded ? 'Réinclure' : 'Exclure'}
        </button>
      </div>
      ${summaryHtml}
    `;

    // Exclure/Réinclure — comportement inchangé
    const excludeBtn = card.querySelector('.btn-exclude')!;
    excludeBtn.addEventListener('click', (e) => {
      e.stopPropagation(); // ne pas déplier/replier la carte en cliquant Exclure
      toggleExclude(art.id);
    });

    // Repli/dépli du résumé (interaction purement visuelle, aucun appel API)
    if (hasSummary) {
      card.addEventListener('click', (e) => {
        // Laisser passer les clics sur le lien du titre (ouvre l'article)
        if ((e.target as HTMLElement).closest('.recap-card-title')) return;
        card.classList.toggle('is-open');
      });
    }

    return card;
  }

  // ── Exclure / Réinclure ──────────────────────────────────────────────────
  async function toggleExclude(articleId: string): Promise<void> {
    const isCurrentlyExcluded = excludedIds.has(articleId);
    const endpoint = isCurrentlyExcluded ? '/api/v1/recap/include' : '/api/v1/recap/exclude';
    const recapPeriod = getExclusionPeriod();

    try {
      await api(endpoint, {
        method: 'POST',
        body: {
          article_id: articleId,
          recap_type: mode,
          recap_period: recapPeriod,
        },
      });
      if (isCurrentlyExcluded) {
        excludedIds.delete(articleId);
      } else {
        excludedIds.add(articleId);
      }
      renderArticles();
    } catch (e: any) {
      toast(e.message || 'Erreur', 'error');
    }
  }

  function getExclusionPeriod(): string {
    if (mode === 'quotidien') return qDate;
    if (mode === 'hebdo') return hebdoWeekStart;
    return mensuelPeriodStart; // YYYY-MM-01
  }

  // ── Publier Quotidien (comportement existant) ────────────────────────────
  async function publishQuotidien(): Promise<void> {
    const btn = document.getElementById('btn-publish') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const data = await api('/api/v1/recap/publish', {
        method: 'POST',
        body: { recap_type: 'quotidien', recap_period: qDate },
      });
      await copyMarkdownToClipboard(data.markdown || '');
      toast('Copié dans le presse-papier');
      isPublished = true;
      publishedAt = data.published_at || new Date().toISOString();
      updatePublishedBadge(true, publishedAt);
    } catch (e: any) {
      toast(e.message || 'Erreur lors de la publication', 'error');
    } finally {
      btn.disabled = currentArticles.length === 0;
    }
  }

  // ── Modal de confirmation Hebdo/Mensuel ──────────────────────────────────
  function showPublishModal(): void {
    const included = currentArticles.filter(a => !excludedIds.has(a.id));
    if (included.length === 0) return;

    const modal = document.getElementById('modal-confirm')!;
    const titleEl = document.getElementById('modal-confirm-title')!;
    const msgEl = document.getElementById('modal-confirm-msg')!;

    if (mode === 'hebdo') {
      const mon = new Date(hebdoWeekStart + 'T12:00:00');
      const sun = addDays(mon, 6);
      const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });
      titleEl.textContent = 'Publier le récap Hebdo';
      msgEl.textContent = `Publier le récap de la semaine du ${fmt(mon)} au ${fmt(sun)} ? ${included.length} article${included.length > 1 ? 's' : ''} sera${included.length > 1 ? 'ont' : ''} marqué${included.length > 1 ? 's' : ''} comme publié${included.length > 1 ? 's' : ''}.`;
    } else {
      titleEl.textContent = 'Publier le récap Mensuel';
      msgEl.textContent = `Publier le récap de ${formatMonthLabel(mensuelYear, mensuelMonth)} ? ${included.length} article${included.length > 1 ? 's' : ''} sera${included.length > 1 ? 'ont' : ''} marqué${included.length > 1 ? 's' : ''} comme publié${included.length > 1 ? 's' : ''}.`;
    }

    modal.style.display = 'block';
  }

  function hidePublishModal(): void {
    document.getElementById('modal-confirm')!.style.display = 'none';
  }

  // ── Confirmation → appel API publish ────────────────────────────────────
  async function confirmPublish(): Promise<void> {
    const okBtn = document.getElementById('btn-modal-ok') as HTMLButtonElement;
    okBtn.disabled = true;
    okBtn.textContent = 'Publication…';

    try {
      // Re-fetch pour obtenir le markdown à jour (reflète les exclusions en DB)
      let freshMarkdown = currentMarkdown;
      let freshIds: string[] = [];

      if (mode === 'hebdo') {
        const fresh = await api(`/api/v1/recap/hebdo?week_start=${hebdoWeekStart}`);
        freshMarkdown = fresh.markdown || '';
        freshIds = (fresh.articles || []).map((a: any) => a.id);
        // Retirer les exclusions client-side (au cas où l'API exclude n'aurait pas encore propagé)
        freshIds = freshIds.filter((id: string) => !excludedIds.has(id));
      } else {
        const fresh = await api(`/api/v1/recap/mensuel?year=${mensuelYear}&month=${mensuelMonth}`);
        freshMarkdown = fresh.markdown || '';
        freshIds = (fresh.articles || []).map((a: any) => a.id);
        freshIds = freshIds.filter((id: string) => !excludedIds.has(id));
      }

      if (freshIds.length === 0) {
        toast('Aucun article à publier.', 'error');
        hidePublishModal();
        return;
      }

      // Appel publish
      if (mode === 'hebdo') {
        await api('/api/v1/recap/hebdo/publish', {
          method: 'POST',
          body: { week_start: hebdoWeekStart, included_article_ids: freshIds },
        });
      } else {
        await api('/api/v1/recap/mensuel/publish', {
          method: 'POST',
          body: { year: mensuelYear, month: mensuelMonth, included_article_ids: freshIds },
        });
      }

      hidePublishModal();

      // Copier le markdown
      await copyMarkdownToClipboard(freshMarkdown);

      const label = mode === 'hebdo' ? 'Récap hebdo publié' : 'Récap mensuel publié';
      toast(`${label}. Markdown copié dans le presse-papier.`);

      // Vider la liste (articles publiés ne doivent plus apparaître)
      currentArticles = [];
      currentMarkdown = '';
      excludedIds.clear();
      renderArticles();

    } catch (e: any) {
      toast(e.message || 'Erreur lors de la publication', 'error');
      hidePublishModal();
    } finally {
      okBtn.disabled = false;
      okBtn.textContent = 'Publier';
    }
  }

  // ── Copie presse-papier avec fallback ────────────────────────────────────
  async function copyMarkdownToClipboard(markdown: string): Promise<void> {
    try {
      await navigator.clipboard.writeText(markdown);
    } catch {
      // Fallback : afficher dans textarea modale
      const modal = document.getElementById('modal-clipboard')!;
      const ta = document.getElementById('clipboard-markdown') as HTMLTextAreaElement;
      ta.value = markdown;
      modal.style.display = 'block';
      ta.select();
    }
  }

  // ── Badge "Publié" (Quotidien seulement) ─────────────────────────────────
  function updatePublishedBadge(pub: boolean, at: string | null): void {
    const badge = document.getElementById('published-badge');
    if (!badge) return;
    if (pub && at) {
      const dt = new Date(at);
      const hhmm = dt.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
      badge.textContent = `Publié à ${hhmm}`;
      badge.style.display = 'inline-flex';
    } else {
      badge.style.display = 'none';
    }
  }

  // ── Navigation entre onglets ─────────────────────────────────────────────
  function switchTab(newMode: Mode): void {
    if (newMode === mode) return;
    mode = newMode;

    // Mettre à jour les classes actives
    document.querySelectorAll('.recap-tab').forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.tab === newMode);
    });

    // Réinitialiser les contrôles et charger les données
    initControls(newMode);
    loadData();
  }

  // ── Bootstrap ────────────────────────────────────────────────────────────
  bootstrapAuth();

  // Activer les onglets
  document.querySelectorAll('.recap-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      switchTab((btn as HTMLElement).dataset.tab as Mode);
    });
  });

  // Modal confirm : boutons
  document.getElementById('btn-modal-cancel')!.addEventListener('click', hidePublishModal);
  document.getElementById('modal-confirm-overlay')!.addEventListener('click', hidePublishModal);
  document.getElementById('btn-modal-ok')!.addEventListener('click', confirmPublish);

  // Modal clipboard : boutons
  document.getElementById('btn-clipboard-close')!.addEventListener('click', () => {
    document.getElementById('modal-clipboard')!.style.display = 'none';
  });
  document.getElementById('modal-clipboard-overlay')!.addEventListener('click', () => {
    document.getElementById('modal-clipboard')!.style.display = 'none';
  });
  document.getElementById('btn-clipboard-copy')!.addEventListener('click', () => {
    const ta = document.getElementById('clipboard-markdown') as HTMLTextAreaElement;
    ta.select();
    try {
      navigator.clipboard.writeText(ta.value);
      toast('Copié');
    } catch {
      document.execCommand('copy');
    }
  });

  // Initialisation onglet Quotidien
  initControls('quotidien');
  loadData();
</script>
