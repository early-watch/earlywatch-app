---
import LandingLayout from '../layouts/LandingLayout.astro';
---

<LandingLayout title="Tableau de couverture — Early Watch">

<nav>
  <a href="/" class="logo">Early<em>Watch</em></a>
  <a href="mailto:maria@early.consulting" class="nav-cta">Demander une demo</a>
</nav>

<!-- HEADER -->
<div class="page-header">
  <div class="header-inner">
    <div class="header-label">Couverture</div>
    <h1>Tableau de surveillance des sources</h1>
    <p class="header-sub">
      Etat en temps reel des sources reglementaires surveillees par Early Watch.
      Mis a jour toutes les heures.
    </p>
    <div id="summary" class="summary" aria-live="polite"></div>
  </div>
</div>

<!-- SOURCES ACTIVES -->
<div class="section" id="active-section">
  <div class="section-inner">
    <div class="sec-label">Sources surveillees</div>
    <div id="categories-container">
      <div class="loading">Chargement en cours…</div>
    </div>
  </div>
</div>

<!-- SOURCES INACTIVES -->
<div class="section section-inactive" id="inactive-section" style="display:none">
  <div class="section-inner">
    <div class="sec-label">Sources desactivees</div>
    <p class="inactive-intro">
      Ces sources sont documentees pour la transparence mais ne sont pas surveillees activement.
    </p>
    <div id="inactive-container"></div>
  </div>
</div>

<!-- FOOTER -->
<footer>
  <div class="left">Early<em>Watch</em> — veille LCB-FT automatisee</div>
  <div class="right">
    <a href="/">Accueil</a>
    <a href="mailto:maria@early.consulting">Contact</a>
  </div>
  <div class="foot-infra">Scaleway Paris · RGPD-compliant · Donnees actualisees toutes les heures</div>
</footer>

<script type="module">
  import { API } from '../scripts/api.ts';

  const CATEGORY_ORDER = ['primaires', 'sanctions', 'organismes', 'international', 'presse'];
  const CATEGORY_LABELS = {
    primaires:     'Regulateurs et textes officiels',
    sanctions:     'Listes de sanctions',
    organismes:    'Organismes internationaux',
    international: 'Regulateurs internationaux',
    presse:        'Presse specialisee',
  };

  async function loadCoverage() {
    try {
      const res = await fetch(`${API}/api/v1/coverage/public`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      renderCoverage(data);
    } catch (err) {
      document.getElementById('categories-container').innerHTML =
        `<div class="error">Impossible de charger les donnees (${err.message}).<br>Reessayez dans quelques secondes.</div>`;
    }
  }

  function statusBadge(status) {
    const map = {
      active:   { label: 'actif',   cls: 'badge-active' },
      alerte:   { label: 'alerte',  cls: 'badge-alerte' },
      inactive: { label: 'inactif', cls: 'badge-inactive' },
    };
    const s = map[status] || map.inactive;
    return `<span class="badge ${s.cls}">${s.label}</span>`;
  }

  function renderCoverage(data) {
    // Summary bar
    const { counts } = data;
    const alerteText = counts.alerte > 0
      ? ` &nbsp;·&nbsp; <span class="alerte-count">${counts.alerte} en alerte</span>`
      : '';
    document.getElementById('summary').innerHTML =
      `<span class="count-pill">${counts.active} sources actives</span>${alerteText}` +
      ` &nbsp;·&nbsp; ${counts.inactive} sources desactivees`;

    // Group active sources by category
    const byCategory = {};
    for (const s of data.active) {
      if (!byCategory[s.category]) byCategory[s.category] = [];
      byCategory[s.category].push(s);
    }

    const order = CATEGORY_ORDER.filter(c => byCategory[c]);
    // Any categories not in our order list
    const rest = Object.keys(byCategory).filter(c => !CATEGORY_ORDER.includes(c));

    const container = document.getElementById('categories-container');
    container.innerHTML = '';

    for (const cat of [...order, ...rest]) {
      const sources = byCategory[cat];
      const label = CATEGORY_LABELS[cat] || cat;

      const group = document.createElement('div');
      group.className = 'cat-group';
      group.innerHTML = `<div class="cat-label">${label}</div>`;

      const list = document.createElement('div');
      list.className = 'source-list';
      for (const s of sources) {
        list.innerHTML += `
          <div class="source-row">
            <div class="source-meta">
              <span class="source-name">${s.official_url
                ? `<a href="${s.official_url}" target="_blank" rel="noopener noreferrer">${s.name}</a>`
                : s.name}</span>
              <span class="source-note">${s.public_note || ''}</span>
            </div>
            <div class="source-status">${statusBadge(s.status)}</div>
          </div>`;
      }
      group.appendChild(list);
      container.appendChild(group);
    }

    // Inactive sources
    if (data.inactive && data.inactive.length > 0) {
      const inactiveContainer = document.getElementById('inactive-container');
      inactiveContainer.innerHTML = '';
      for (const s of data.inactive) {
        inactiveContainer.innerHTML += `
          <div class="source-row source-row-inactive">
            <div class="source-meta">
              <span class="source-name">${s.official_url
                ? `<a href="${s.official_url}" target="_blank" rel="noopener noreferrer">${s.name}</a>`
                : s.name}</span>
              <span class="source-note">${s.deactivation_reason || s.public_note || ''}</span>
            </div>
            <div class="source-status">${statusBadge('inactive')}</div>
          </div>`;
      }
      document.getElementById('inactive-section').style.display = '';
    }
  }

  loadCoverage();
</script>

<style is:global>
  :root {
    --bg: #F5F0E8;
    --ink: #1C1C19;
    --dim: #6B6860;
    --kaki: #0F1115;   /* charte noir et blanc (nom historique) */
    --terra: #C4603A;
    --line: rgba(28,28,25,0.12);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'IBM Plex Sans', sans-serif;
    background: var(--bg); color: var(--ink);
    font-size: 16px; line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { text-decoration: none; color: inherit; }

  /* ── NAV ── */
  nav {
    position: sticky; top: 0; z-index: 100;
    padding: 0 60px; height: 56px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(245,240,232,0.94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .logo { font-size: 14px; font-weight: 500; letter-spacing: 0.02em; }
  .logo em { color: var(--terra); font-style: normal; }
  .nav-cta { font-size: 13px; color: var(--dim); border-bottom: 1px solid var(--dim); padding-bottom: 1px; transition: all .15s; }
  .nav-cta:hover { color: var(--kaki); border-color: var(--kaki); }

  /* ── PAGE HEADER ── */
  .page-header {
    border-bottom: 1px solid var(--line);
    padding: 72px 60px 64px;
  }
  .header-inner { max-width: 1200px; margin: 0 auto; }
  .header-label {
    font-size: 12px; font-weight: 500; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--kaki); margin-bottom: 20px;
  }
  .page-header h1 {
    font-size: clamp(26px, 3vw, 40px); font-weight: 300;
    letter-spacing: -1px; line-height: 1.15; margin-bottom: 20px;
  }
  .header-sub {
    font-size: 15px; color: var(--dim); font-weight: 300;
    line-height: 1.75; max-width: 560px; margin-bottom: 28px;
  }
  .summary {
    font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--dim);
  }
  .count-pill { color: var(--kaki); font-weight: 500; }
  .alerte-count { color: var(--terra); font-weight: 500; }

  /* ── SECTIONS ── */
  .section {
    padding: 64px 60px;
    border-bottom: 1px solid var(--line);
  }
  .section-inner { max-width: 1200px; margin: 0 auto; }
  .sec-label {
    font-size: 12px; font-weight: 500; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--kaki);
    margin-bottom: 40px;
  }
  .section-inactive { background: rgba(28,28,25,0.02); }
  .inactive-intro {
    font-size: 13px; color: var(--dim); font-weight: 300;
    line-height: 1.7; margin-bottom: 32px; max-width: 600px;
  }

  /* ── CATEGORY GROUPS ── */
  .cat-group { margin-bottom: 48px; }
  .cat-group:last-child { margin-bottom: 0; }
  .cat-label {
    font-size: 11px; font-weight: 500; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--dim);
    margin-bottom: 0; padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  /* ── SOURCE ROWS ── */
  .source-list { display: flex; flex-direction: column; }
  .source-row {
    display: grid; grid-template-columns: 1fr 80px;
    align-items: center; gap: 24px;
    padding: 16px 0; border-bottom: 1px solid var(--line);
  }
  .source-row:last-child { border-bottom: none; }
  .source-row-inactive { opacity: 0.65; }
  .source-meta { display: flex; flex-direction: column; gap: 3px; }
  .source-name { font-size: 14px; font-weight: 400; }
  .source-name a {
    color: inherit; border-bottom: 1px solid transparent;
    transition: border-color .15s;
  }
  .source-name a:hover { border-color: var(--kaki); color: var(--kaki); }
  .source-note { font-size: 12px; color: var(--dim); font-weight: 300; line-height: 1.5; }
  .source-status { text-align: right; }

  /* ── BADGES ── */
  .badge {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px; font-weight: 500;
    letter-spacing: 0.04em;
    padding: 3px 8px; border-radius: 3px;
  }
  .badge-active   { background: rgba(15, 17, 21, 0.10);  color: var(--kaki); }
  .badge-alerte   { background: rgba(196,96,58,0.12);   color: var(--terra); }
  .badge-inactive { background: rgba(28,28,25,0.06);    color: var(--dim); }

  /* ── STATES ── */
  .loading, .error {
    font-size: 14px; color: var(--dim); font-weight: 300;
    padding: 40px 0; line-height: 1.7;
  }
  .error { color: var(--terra); }

  /* ── FOOTER ── */
  footer {
    padding: 28px 60px;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
  }
  footer .left { font-size: 13px; }
  footer .left em { color: var(--terra); font-style: normal; }
  footer .right { display: flex; gap: 28px; }
  footer .right a { font-size: 12px; color: var(--dim); }
  footer .right a:hover { color: var(--kaki); }
  .foot-infra {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px; color: var(--dim); width: 100%;
  }

  @media (max-width: 900px) {
    nav, .page-header, .section, footer { padding-left: 24px; padding-right: 24px; }
    .source-row { grid-template-columns: 1fr 64px; gap: 12px; }
  }
</style>

</LandingLayout>
