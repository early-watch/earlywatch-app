---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Early Watch — Procedures" activePage="procedure">
  <div class="proc-layout">
    <div class="proc-left">
      <div id="prof-banner" class="prof-banner" style="display:none">
        <span>Votre profil organisation n'est pas encore renseigne. Les procedures generees seront generiques.</span>
        <a href=`${base}settings/` class="prof-link">Completer le profil &rarr;</a>
      </div>
      <div class="left-header">
        <div class="left-title">Procedures</div>
        <div class="left-subtitle" id="left-subtitle">Chargement...</div>
      </div>
      <div id="proc-obligatoires" class="proc-section"></div>
      <div id="proc-autres" class="proc-section">
        <button class="section-toggle" id="toggle-autres" style="display:none">
          <span class="toggle-arrow">&#9654;</span> Autres procedures disponibles
        </button>
        <div id="autres-list" style="display:none"></div>
      </div>
    </div>

    <main class="proc-right" id="result-area">
      <div class="proc-empty">
        <p class="proc-empty-text">Selectionnez une procedure pour lancer la generation.</p>
      </div>
    </main>
  </div>
</AppLayout>

<style>
  .proc-layout { display: flex; height: calc(100vh - 85px); }
  .proc-left {
    width: 420px; min-width: 420px; border-right: 0.5px solid var(--line-strong);
    overflow-y: auto; padding: 0; background: var(--bg);
  }
  .proc-right { flex: 1; overflow-y: auto; background: var(--bg); }

  .prof-banner {
    padding: 10px 16px; background: var(--bg-side); border-bottom: 0.5px solid var(--line-strong);
    font-size: 12px; color: var(--taupe); line-height: 1.4; border-radius: var(--radius);
  }
  .prof-link {
    display: inline-block; margin-top: 4px; font-size: 11px; font-weight: 600;
    color: var(--ink); text-decoration: underline;
  }

  .left-header { padding: 16px 20px 0; }
  .left-title { font-size: 15px; font-weight: 500; color: var(--ink); }
  .left-subtitle { font-size: 12px; color: var(--taupe); margin-top: 2px; }

  .proc-section { padding: 0 16px; }

  .section-toggle {
    display: flex; align-items: center; gap: 6px;
    width: 100%; padding: 10px 4px; background: none; border: none; border-top: 0.5px solid var(--line-strong);
    font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--taupe); cursor: pointer; font-family: var(--font); margin-top: 8px;
  }
  .section-toggle:hover { color: var(--taupe); }
  .toggle-arrow { font-size: 8px; transition: transform 0.2s; }
  .section-toggle.open .toggle-arrow { transform: rotate(90deg); }

  .proc-empty {
    display: flex; align-items: center; justify-content: center; height: 100%;
  }
  .proc-empty-text { font-size: 14px; color: var(--taupe); }
</style>

<style is:global>
  /* Procedure items in left column */
  .proc-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px; border: 0.5px solid var(--line-strong); border-radius: var(--radius);
    cursor: pointer; transition: all 0.12s; background: var(--bg); margin-bottom: 6px;
  }
  .proc-item:hover { border-color: var(--ink); background: var(--bg-side); }
  .proc-item.active { background: var(--bg-side); border-color: var(--ink); }
  .proc-item.active .pi-ref, .proc-item.active .pi-title { color: var(--ink); }
  .proc-item.active .pi-badge { background: var(--bg-side); color: var(--ink); border-color: var(--line); }
  .proc-item.generated { border-left: 3px solid var(--ink-soft); }

  .pi-left { flex: 1; min-width: 0; }
  .pi-ref {
    font-size: 10px; font-weight: 600; color: var(--taupe);
    font-family: var(--font-mono); letter-spacing: 0.04em;
  }
  .pi-title {
    font-size: 12px; color: var(--ink); font-weight: 500; margin-top: 1px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .pi-badge {
    font-size: 10px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    padding: 2px 7px; border-radius: var(--radius-sm); flex-shrink: 0; margin-left: 8px;
    border: 0.5px solid var(--line-strong); background: var(--bg); color: var(--taupe);
    font-family: var(--font-mono);
  }
  .pi-badge-psp { background: var(--bg-side); color: var(--ink); border-color: var(--ink); }
  .pi-badge-banque { background: var(--bg); color: var(--ink-soft); border-color: var(--ink-soft); }
  .pi-badge-casp { background: var(--bg); color: var(--ink-soft); border-color: var(--ink-soft); }
  .pi-badge-tous { background: var(--bg); color: var(--taupe); border-color: var(--taupe); }

  .section-label-oblig {
    font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--taupe); font-weight: 700; margin: 14px 0 8px; padding: 0 4px;
  }

  /* Result area */
  .result-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 20px;
  }
  .result-title { font-size: 18px; font-weight: 600; color: var(--ink); }
  .result-meta { font-size: 12px; color: var(--taupe); margin-top: 4px; }
  .result-badge {
    font-size: 10px; font-weight: 600; padding: 4px 10px; border-radius: var(--radius);
    letter-spacing: 0.04em;
  }
  .badge-perso { background: var(--ink); color: var(--ink-soft); }
  .badge-generic { background: var(--bg); color: var(--taupe); }

  .result-actions { display: flex; gap: 8px; margin-top: 16px; }
  .btn-docx, .btn-validate {
    flex: 1; padding: 9px 12px; font-size: 12px; font-weight: 600; border: none;
    border-radius: var(--radius); cursor: pointer; font-family: var(--font);
    transition: opacity 0.15s;
  }
  .btn-docx { background: var(--ink); color: var(--bg); }
  .btn-validate { background: var(--ink); color: var(--bg); }
  .btn-docx:hover, .btn-validate:hover { opacity: 0.9; }
  .btn-docx:disabled, .btn-validate:disabled { background: var(--taupe); cursor: not-allowed; }

  .warning-box {
    display: flex; gap: 10px; padding: 12px; background: var(--bg-side);
    border: 0.5px solid var(--line-strong); border-radius: var(--radius); font-size: 12px;
    color: var(--taupe); margin-top: 20px;
  }
</style>

<script>
  import { api, toast, statusBadge, renderMarkdown, initExpandables, formatDate, API } from '../scripts/api';
  import { bootstrapAuth } from '../scripts/bootstrap-auth';

  // ═══ CONSTANTS ═══

  const PROC_LABELS: Record<string, string> = {
    'EB-POL-001': 'Politique generale LCB-FT',
    'EB-RISK-001': 'Classification des risques',
    'EB-KYC-001': 'Entree en relation — Personne physique',
    'EB-KYC-002': 'Entree en relation — Personne morale',
    'EB-SCR-001': 'Criblage sanctions et PPE',
    'EB-MON-001': 'Monitoring transactionnel',
    'EB-TRC-001': 'Declaration de soupcon Tracfin',
    'EB-CASP-001': 'LCB-FT specifique CASP/PSAN',
    'EB-CTRL-001': 'Controle permanent LCB-FT',
    'EB-AGT-001': 'Agents et distributeurs',
    'EB-UBO-001': 'Beneficiaires effectifs',
    'EB-EDD-001': 'Vigilance renforcee',
    'EB-PEP-001': 'Personnes politiquement exposees',
    'EB-SCR-002': 'Criblage sanctions avance',
    'EB-GEL-001': 'Gel des avoirs',
    'EB-ARCH-001': 'Archivage',
    'EB-TRV-001': 'Transfert de fonds',
    'EB-CBK-001': 'Correspondance bancaire',
    'EB-FORM-001': 'Formation LCB-FT',
  };

  const OBLIGATOIRES: Record<string, string[]> = {
    'PSP':    ['EB-POL-001','EB-RISK-001','EB-KYC-001','EB-KYC-002','EB-SCR-001','EB-MON-001','EB-TRC-001','EB-CTRL-001','EB-AGT-001','EB-FORM-001'],
    'Banque': ['EB-POL-001','EB-RISK-001','EB-KYC-001','EB-KYC-002','EB-SCR-001','EB-MON-001','EB-TRC-001','EB-CTRL-001','EB-FORM-001','EB-UBO-001','EB-EDD-001','EB-PEP-001','EB-CBK-001','EB-ARCH-001'],
    'CASP':   ['EB-POL-001','EB-RISK-001','EB-KYC-001','EB-KYC-002','EB-SCR-001','EB-MON-001','EB-TRC-001','EB-CASP-001','EB-CTRL-001','EB-FORM-001','EB-TRV-001','EB-GEL-001'],
    'EME':    ['EB-POL-001','EB-RISK-001','EB-KYC-001','EB-KYC-002','EB-SCR-001','EB-MON-001','EB-TRC-001','EB-CTRL-001','EB-AGT-001','EB-FORM-001'],
  };

  const ALWAYS_AVAILABLE: string[] = ['EB-EDD-001','EB-SCR-002','EB-GEL-001','EB-ARCH-001','EB-PEP-001'];

  const ALL_CODES: string[] = Object.keys(PROC_LABELS);

  const PROFILE_BADGE: Record<string, string> = {
    'PSP': 'pi-badge-psp', 'Banque': 'pi-badge-banque',
    'CASP': 'pi-badge-casp', 'EME': 'pi-badge-psp', 'Tous': 'pi-badge-tous',
  };

  // ═══ STATE ═══

  let settings: any = {};
  let entityType: string = '';
  let selectedRef: string = '';
  let generatedProcs: Map<string, any> = new Map(); // ref → procedure data

  function escHtml(s: string): string {
    if (!s) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // ═══ INIT ═══

  async function init() {
    try {
      const data = await api('/api/v1/settings');
      settings = data.settings || {};
      entityType = settings?.profil?.entity_type || settings?.entity_type || '';

      // Check profile completeness
      const nom = settings?.profil?.nom_etablissement || '';
      if (!nom || !entityType) {
        document.getElementById('prof-banner')!.style.display = 'block';
      }

      // Load existing procedures
      try {
        const procs = await api('/api/v1/procedures');
        const list = Array.isArray(procs) ? procs : (procs.items || []);
        for (const p of list) {
          // Map by profile to be loadable
          generatedProcs.set(p.id, p);
        }
      } catch (_) {}

      renderProcedureList();
    } catch (e: any) {
      document.getElementById('left-subtitle')!.textContent = 'Erreur de chargement';
    }
  }

  // ═══ DETERMINE APPLICABLE PROCEDURES ═══

  function getApplicableProcedures(): { obligatoires: string[], autres: string[] } {
    const perim = settings?.perimetre || {};
    const et = entityType || 'PSP';

    // Start with base obligatoires
    const baseSet = new Set(OBLIGATOIRES[et] || OBLIGATOIRES['PSP']);

    // Secondary filters
    const clients: string[] = perim.types_clients || [];
    const hasEntreprises = clients.includes('Entreprises') || clients.includes('Institutionnels');

    if (hasEntreprises) {
      baseSet.add('EB-UBO-001');
      baseSet.add('EB-PEP-001');
    }
    if (perim.transferts_fonds && (et === 'PSP' || et === 'EME')) {
      baseSet.add('EB-TRV-001');
    }
    if (perim.correspondance_bancaire && (et === 'Banque' || et === 'EC')) {
      baseSet.add('EB-CBK-001');
    }
    if (perim.agents_distributeurs) {
      baseSet.add('EB-AGT-001');
    }

    const obligatoires = [...baseSet];

    // "Autres" = all codes not in obligatoires, including always-available
    const obligSet = new Set(obligatoires);
    const autres: string[] = [];
    for (const code of ALL_CODES) {
      if (!obligSet.has(code)) autres.push(code);
    }
    // Ensure always-available are in "autres" if not already in obligatoires
    for (const code of ALWAYS_AVAILABLE) {
      if (!obligSet.has(code) && !autres.includes(code)) autres.push(code);
    }

    return { obligatoires, autres };
  }

  // ═══ RENDER LEFT COLUMN ═══

  function renderProcedureList() {
    const { obligatoires, autres } = getApplicableProcedures();
    const et = entityType || 'PSP';

    document.getElementById('left-subtitle')!.textContent =
      `${obligatoires.length} procedures pour profil ${et}`;

    // Obligatoires
    const obligEl = document.getElementById('proc-obligatoires')!;
    obligEl.innerHTML = `<div class="section-label-oblig">Votre corpus obligatoire (${obligatoires.length})</div>` +
      obligatoires.map(code => renderProcItem(code, et)).join('');

    // Autres
    const autresEl = document.getElementById('autres-list')!;
    const toggleBtn = document.getElementById('toggle-autres')!;
    if (autres.length) {
      toggleBtn.style.display = 'flex';
      autresEl.innerHTML = autres.map(code => renderProcItem(code, 'Tous')).join('');
    }

    // Bind clicks
    document.querySelectorAll('.proc-item').forEach((el: any) => {
      el.addEventListener('click', () => onProcClick(el.dataset.ref));
    });

    // Toggle "autres"
    toggleBtn.addEventListener('click', () => {
      const list = document.getElementById('autres-list')!;
      const isOpen = list.style.display !== 'none';
      list.style.display = isOpen ? 'none' : 'block';
      toggleBtn.classList.toggle('open', !isOpen);
    });
  }

  function renderProcItem(code: string, badgeProfile: string): string {
    const label = PROC_LABELS[code] || code;
    const badgeCls = PROFILE_BADGE[badgeProfile] || 'pi-badge-tous';
    return `
      <div class="proc-item" data-ref="${code}">
        <div class="pi-left">
          <div class="pi-ref">${code}</div>
          <div class="pi-title">${escHtml(label)}</div>
        </div>
        <span class="pi-badge ${badgeCls}">${badgeProfile}</span>
      </div>`;
  }

  // ═══ PROCEDURE CLICK → GENERATE ═══

  async function onProcClick(ref: string) {
    // Update selection UI
    document.querySelectorAll('.proc-item').forEach((el: any) => {
      el.classList.toggle('active', el.dataset.ref === ref);
    });
    selectedRef = ref;

    // Show loading
    const area = document.getElementById('result-area')!;
    area.innerHTML = `
      <div style="display:flex; align-items:center; justify-content:center; height:100%; flex-direction:column; gap:12px">
        <div class="spinner"></div>
        <p style="font-size:13px; color:#3D3B38">Generation de ${ref} en cours...</p>
        <p style="font-size:11px; color:var(--taupe)">Cela peut prendre 30 a 60 secondes</p>
      </div>`;

    const profileMap: Record<string,string> = { 'PSP': 'psp', 'Banque': 'banque', 'CASP': 'casp', 'EME': 'psp', 'EC': 'banque' };
    const et = entityType || 'PSP';
    const profile = profileMap[et] || 'psp';
    const label = PROC_LABELS[ref] || ref;

    try {
      const result = await api('/api/v1/procedures/generate', {
        method: 'POST',
        body: {
          text_id: 'cmf',
          tenant_profile: profile,
          client_context: `Procedure demandee : ${ref} — ${label}`,
        },
      });
      generatedProcs.set(result.id, result);
      renderResult(result, ref);
      toast('Procedure generee');
    } catch (e: any) {
      area.innerHTML = `
        <div class="proc-empty">
          <p class="proc-empty-text" style="color:#8B3A3A">${escHtml(e.message || 'Erreur de generation')}</p>
        </div>`;
      toast(e.message || 'Erreur', 'error');
    }
  }

  // ═══ RENDER RESULT ═══

  function renderResult(proc: any, ref: string) {
    const content = proc.content || '';
    const sections = parseSections(content);
    const srcsCited = proc.sources_cited || [];
    const isPerso = !!settings?.profil?.nom_etablissement;
    const badgeTxt = isPerso ? 'Personnalisee avec votre profil' : 'Generique';
    const badgeCls = isPerso ? 'badge-perso' : 'badge-generic';

    document.getElementById('result-area')!.innerHTML = `
      <div style="padding:24px; max-width:800px; margin:0 auto">
        <div class="result-header">
          <div>
            <div class="result-title">${escHtml(ref)} — ${escHtml(PROC_LABELS[ref] || '')}</div>
            <div class="result-meta">
              ${proc.obligation_count || '?'} obligations &middot; ${proc.model_name || 'Claude'}
              &middot; ${formatDate(proc.created_at)}
            </div>
          </div>
          <span class="result-badge ${badgeCls}">${badgeTxt}</span>
        </div>

        ${srcsCited.length ? `
        <div style="margin-bottom:16px">
          <div style="font-size:11px; color:var(--taupe); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px; font-weight:600">Articles cites</div>
          <div style="display:flex; gap:4px; flex-wrap:wrap">
            ${srcsCited.map((s: any) => `
              <a href="${s.lien_legifrance || '#'}" target="_blank" rel="noopener"
                 style="font-size:10px; padding:2px 8px; background:var(--bg-side); border-radius:var(--radius-sm); color:var(--ink); text-decoration:none; border:0.5px solid var(--ink); font-family:var(--font-mono)">
                Art. ${escHtml(s.article_number || '')}
              </a>
            `).join('')}
          </div>
        </div>` : ''}

        ${sections.map((sec: any, i: number) => `
          <div class="expandable ${i < 4 ? 'open' : ''}">
            <button class="expandable-header">
              <span>${escHtml(sec.title)}</span>
              <span class="arrow">&#9654;</span>
            </button>
            <div class="expandable-body">
              <div class="md-content">${renderMarkdown(sec.content)}</div>
            </div>
          </div>
        `).join('')}

        <div class="warning-box">
          <span>&#9888;</span>
          <div>
            <strong>Avertissement Compliance Officer</strong><br>
            Ce document est un PROJET genere automatiquement par IA a partir de sources Legifrance.
            Il DOIT etre valide par le Compliance Officer avant toute mise en application.
          </div>
        </div>

        <div class="result-actions">
          <button class="btn-docx" id="btn-export-docx" data-proc-id="${proc.id}">Telecharger .docx</button>
          ${proc.status === 'pending_validation' ? `
            <button class="btn-validate" id="btn-mark-valid" data-proc-id="${proc.id}">Marquer comme validee</button>
          ` : `
            <button class="btn-validate" disabled>${proc.status === 'validated' ? 'Validee' : proc.status}</button>
          `}
        </div>
      </div>`;

    initExpandables();
    bindResultActions(proc, ref);
  }

  function bindResultActions(proc: any, ref: string) {
    // DOCX export
    const docxBtn = document.getElementById('btn-export-docx');
    if (docxBtn) {
      docxBtn.addEventListener('click', async () => {
        const btn = docxBtn as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Export en cours...';
        try {
          const token = sessionStorage.getItem('ew_token');
          const res = await fetch(`${API}/api/v1/procedures/${proc.id}/export-docx`, {
            headers: { 'Authorization': `Bearer ${token}` },
          });
          if (!res.ok) throw new Error(`Erreur ${res.status}`);
          const blob = await res.blob();
          const disposition = res.headers.get('Content-Disposition') || '';
          const m = disposition.match(/filename="?([^"]+)"?/);
          const filename = m ? m[1] : `${ref}.docx`;
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = filename;
          a.click();
          URL.revokeObjectURL(a.href);
          toast('DOCX telecharge');
        } catch (e: any) {
          toast(e.message || 'Erreur export', 'error');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Telecharger .docx';
        }
      });
    }

    // Validate
    const validBtn = document.getElementById('btn-mark-valid');
    if (validBtn) {
      validBtn.addEventListener('click', async () => {
        try {
          const result = await api(`/api/v1/procedures/${proc.id}/validate`, {
            method: 'POST',
            body: { decision: 'validated' },
          });
          renderResult(result, ref);
          toast('Procedure validee');
        } catch (e: any) {
          toast(e.message || 'Erreur', 'error');
        }
      });
    }
  }

  // ═══ HELPERS ═══

  function parseSections(md: string) {
    const lines = md.split('\n');
    const sections: any[] = [];
    let current: any = null;
    for (const line of lines) {
      const mBold = line.match(/^\*\*(\d+)\s*[-—]\s*(.+?)\*\*/);
      const m2 = line.match(/^## \d*\.?\s*(.+)/);
      const m1 = line.match(/^# (.+)/);
      if (mBold) {
        if (current) sections.push(current);
        current = { title: `${mBold[1]} — ${mBold[2]}`, content: '' };
      } else if (m2) {
        if (current) sections.push(current);
        current = { title: m2[1], content: '' };
      } else if (m1 && !current) {
        if (current) sections.push(current);
        current = { title: m1[1], content: '' };
      } else if (current) {
        current.content += line + '\n';
      }
    }
    if (current) sections.push(current);
    if (sections.length === 0) sections.push({ title: 'Procedure', content: md });
    return sections;
  }

  // ═══ START ═══
  bootstrapAuth();
  init();
</script>
