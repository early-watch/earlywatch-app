---
import AuthLayout from '../layouts/AuthLayout.astro';
// EB-MVP-002 — compte connecté sans abonnement actif (API : 402).
// EB-MVP-003 — paiement : formules proposées selon le profil (GET /billing/plans),
// pays de facturation (France seule, TVA option A), redirection vers Stripe Checkout.
---

<AuthLayout title="Early Watch — Choisissez votre formule">
  <p style="font-size:14px;color:var(--ink);line-height:1.6;margin-bottom:8px">Choisissez votre formule</p>
  <p style="font-size:13px;color:var(--mute);line-height:1.6;margin-bottom:20px">
    Votre compte est créé. L'accès à la veille s'ouvre dès que votre abonnement est actif.
  </p>

  <form id="checkout-form" novalidate>
    <div id="plans" style="display:flex;flex-direction:column;gap:10px;margin-bottom:16px">
      <p style="font-size:12px;color:var(--mute)">Chargement des formules…</p>
    </div>

    <div class="ew-field">
      <label class="ew-label" for="country">Pays de facturation</label>
      <select class="ew-input" id="country" required>
        <option value="FR" selected>France</option>
        <option value="other">Autre pays</option>
      </select>
    </div>
    <p id="country-note" style="display:none;font-size:12px;color:var(--mute);line-height:1.6;margin:-4px 0 12px">
      L'abonnement en ligne est réservé aux entreprises établies en France. Pour une souscription depuis
      un autre pays, écrivez-nous : <a href="mailto:maria@early.consulting" style="color:var(--taupe)">maria@early.consulting</a>.
    </p>

    <div class="ew-login-error" id="err"></div>
    <button type="submit" class="ew-login-btn" id="pay" disabled>Payer par carte</button>
    <p style="font-size:11px;color:var(--mute);line-height:1.6;margin:10px 0 20px">
      Paiement sécurisé sur la page de notre prestataire Stripe : aucune donnée de carte ne transite par
      Early Watch. Abonnement mensuel, résiliable à tout moment depuis vos paramètres.
    </p>
  </form>

  <p id="not-admin" style="display:none;font-size:12px;color:var(--mute);line-height:1.6;margin-bottom:20px">
    Seul l'administrateur du compte peut souscrire l'abonnement.
  </p>

  <div style="text-align:center;font-size:12px">
    <a href="#" id="logout" style="color:var(--taupe);text-decoration:none">Se déconnecter</a>
  </div>

  <!-- is:global : les cartes sont créées en JavaScript (styles à portée inopérants). -->
  <style is:global>
    .ew-plan { display: block; border: 1px solid var(--line, #E4E1D8); border-radius: 6px; padding: 12px 14px; cursor: pointer; }
    .ew-plan:has(input:checked) { border-color: var(--taupe); }
    .ew-plan input { margin: 0 8px 0 0; accent-color: var(--accent); }
    .ew-plan .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 13px; color: var(--ink); }
    .ew-plan .price { white-space: nowrap; }
    .ew-plan .detail { font-size: 11px; color: var(--mute); margin-top: 4px; padding-left: 21px; }
    .ew-plan.unavailable { opacity: .5; cursor: not-allowed; }
  </style>

  <script>
    import { API, api, getToken, getUser, logout, formatEuros } from '../scripts/api';

    const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';
    document.getElementById('logout')?.addEventListener('click', (e) => { e.preventDefault(); logout(); });

    type Plan = { code: string; label: string; price_ht_cents: number; price_ttc_cents: number | null;
                  max_users: number | null; available: boolean };

    const form = document.getElementById('checkout-form') as HTMLFormElement;
    const plansEl = document.getElementById('plans')!;
    const payBtn = document.getElementById('pay') as HTMLButtonElement;
    const errEl = document.getElementById('err')!;
    const countryEl = document.getElementById('country') as HTMLSelectElement;
    const countryNote = document.getElementById('country-note')!;

    const selectedPlan = () => (plansEl.querySelector('input:checked') as HTMLInputElement | null)?.value;
    const refreshButton = () => { payBtn.disabled = !selectedPlan() || countryEl.value !== 'FR'; };

    function renderPlans(plans: Plan[]) {
      plansEl.innerHTML = '';
      for (const p of plans) {
        const label = document.createElement('label');
        label.className = 'ew-plan' + (p.available ? '' : ' unavailable');
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'plan';
        input.value = p.code;
        input.disabled = !p.available;
        input.checked = p.available && !selectedPlan(); // première formule disponible
        input.addEventListener('change', refreshButton);
        const name = document.createElement('span');
        name.append(input, p.label);
        const price = document.createElement('span');
        price.className = 'price';
        price.textContent = `${formatEuros(p.price_ht_cents)} HT / mois`;
        const row = document.createElement('div');
        row.className = 'row';
        row.append(name, price);
        const detail = document.createElement('div');
        detail.className = 'detail';
        const ttc = p.price_ttc_cents != null ? `soit ${formatEuros(p.price_ttc_cents)} TTC` : 'TVA calculée au paiement';
        const users = !p.max_users ? '' : p.max_users > 1 ? ` · jusqu'à ${p.max_users} utilisateurs` : ' · 1 utilisateur';
        detail.textContent = ttc + users + (p.available ? '' : ' · bientôt disponible');
        label.append(row, detail);
        plansEl.append(label);
      }
      refreshButton();
    }

    countryEl.addEventListener('change', () => {
      countryNote.style.display = countryEl.value === 'FR' ? 'none' : 'block';
      refreshButton();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.classList.remove('visible');
      const plan = selectedPlan();
      if (!plan || countryEl.value !== 'FR') return;
      payBtn.disabled = true;
      payBtn.textContent = 'Redirection vers le paiement…';
      try {
        const { url } = await api('/api/v1/billing/checkout-session', {
          method: 'POST', body: { plan, billing_country: countryEl.value },
        });
        window.location.href = url;
      } catch (err) {
        errEl.textContent = (err as Error).message || 'Le paiement est indisponible pour le moment.';
        errEl.classList.add('visible');
        payBtn.textContent = 'Payer par carte';
        refreshButton();
      }
    });

    const token = getToken();
    if (!token) {
      window.location.href = BASE + 'login';
    } else {
      if (getUser()?.role !== 'admin') {
        form.style.display = 'none';
        document.getElementById('not-admin')!.style.display = 'block';
      }
      api('/api/v1/billing/plans')
        .then(renderPlans)
        .catch(() => {
          const p = document.createElement('p');
          p.style.cssText = 'font-size:12px;color:var(--mute);line-height:1.6';
          const a = document.createElement('a');
          a.href = 'mailto:maria@early.consulting';
          a.style.color = 'var(--taupe)';
          a.textContent = 'maria@early.consulting';
          p.append('Les formules ne peuvent pas être chargées pour le moment. Réessayez dans quelques instants ou écrivez-nous : ', a, '.');
          plansEl.replaceChildren(p);
        });
      // Abonnement activé entre-temps (ex. par le superadmin) : on repart vers le tableau de bord.
      fetch(`${API}/api/v1/auth/me`, { headers: { Authorization: `Bearer ${token}` } })
        .then(r => (r.ok ? r.json() : null))
        .then(u => {
          if (u && (u.subscription_status === 'active' || u.role === 'superadmin')) {
            sessionStorage.setItem('ew_user', JSON.stringify(u));
            window.location.href = BASE + (u.role === 'superadmin' ? 'superadmin' : 'app/fil');
          }
        })
        .catch(() => {});
    }
  </script>
</AuthLayout>
