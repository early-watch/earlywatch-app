---
import ClientLayout from '../../layouts/ClientLayout.astro';
---

<ClientLayout title="Feuille de route" activePage="feuille-de-route">

  <div class="ew-header">
    <h1 class="ew-h-title">Feuille de route réglementaire</h1>
  </div>

  <div id="deadlines-list">
    <div class="ew-loading"><div class="ew-spinner"></div></div>
  </div>

</ClientLayout>

<style is:global>
  .deadline-card {
    border: 0.5px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 22px;
    margin-bottom: 12px;
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: 20px;
    align-items: start;
  }
  .deadline-card.imminent { border-color: var(--accent); }
  .dl-day {
    font-family: var(--font);
    font-size: 42px;
    font-weight: 300;
    line-height: 1;
    color: var(--ink);
  }
  .dl-monthyear { font-family: var(--font); font-size: var(--label-size); font-weight: var(--label-weight); color: var(--label-color); letter-spacing: normal; text-transform: none; margin-top: 3px; }
  .dl-countdown {
    font-size: 11px;
    color: var(--taupe);
    margin-top: 6px;
  }
  .dl-title   { font-size: 14px; font-weight: 500; color: var(--ink); margin-bottom: 5px; }
  .dl-desc    { font-size: 12px; color: var(--taupe); margin-bottom: 8px; line-height: 1.5; }
  .dl-procs   { font-size: 11px; color: var(--mute); }
  .badge-critical {
    font-family: var(--font);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: normal;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 3px;
    padding: 3px 8px;
    white-space: nowrap;
  }
  .badge-high {
    font-family: var(--font);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: normal;
    color: var(--accent);
    background: var(--accent-bg);
    border-radius: 3px;
    padding: 3px 8px;
    white-space: nowrap;
  }
  .badge-medium {
    font-family: var(--font);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: normal;
    color: var(--taupe);
    background: var(--bg-selected);
    border-radius: 3px;
    padding: 3px 8px;
    white-space: nowrap;
  }
  .section-label { font-family: var(--font); font-size: var(--label-size); font-weight: var(--label-weight); color: var(--label-color); letter-spacing: normal; text-transform: none; }
  .past-toggle-btn { font-family: var(--font); font-size: var(--label-size); font-weight: var(--label-weight); color: var(--label-color); letter-spacing: normal; text-transform: none; background: none; border: 0.5px solid var(--line); border-radius: 3px; padding: 3px 8px; cursor: pointer; }
  .past-toggle-btn:hover { color: var(--ink); border-color: var(--line-strong); }
</style>

<script>
  import { api } from '../../scripts/api';

  async function loadDeadlines() {
    const container = document.getElementById('deadlines-list')!;
    try {
      const data = await api('/api/v1/deadlines?include_passed=true');
      const all: any[] = Array.isArray(data) ? data : (data?.deadlines || []);

      const today = new Date();
      const upcoming = all
        .filter((d: any) => new Date(d.deadline_date) >= today)
        .sort((a: any, b: any) => new Date(a.deadline_date).getTime() - new Date(b.deadline_date).getTime());
      const passed = all
        .filter((d: any) => new Date(d.deadline_date) < today)
        .sort((a: any, b: any) => new Date(b.deadline_date).getTime() - new Date(a.deadline_date).getTime());

      if (!upcoming.length && !passed.length) {
        container.innerHTML = '<div class="ew-empty"><div class="ew-empty-title">Aucune échéance</div></div>';
        return;
      }

      let html = upcoming.map((d: any) => renderDeadline(d, today)).join('');

      if (passed.length) {
        html += `
          <div style="display:flex;align-items:center;gap:12px;margin-top:28px;margin-bottom:12px">
            <div class="section-label">Échéances passées</div>
            <button class="past-toggle-btn" id="toggle-past">Afficher (${passed.length})</button>
          </div>
          <div id="past-section" style="display:none">
            ${passed.map((d: any) => renderDeadline(d, today)).join('')}
          </div>`;
      }

      container.innerHTML = html;

      const toggleBtn = document.getElementById('toggle-past');
      const pastSection = document.getElementById('past-section');
      if (toggleBtn && pastSection) {
        toggleBtn.addEventListener('click', () => {
          const open = pastSection.style.display !== 'none';
          pastSection.style.display = open ? 'none' : 'block';
          toggleBtn.textContent = open ? `Afficher (${passed.length})` : 'Masquer';
        });
      }

    } catch (e: any) {
      container.innerHTML = `<div class="ew-empty"><div class="ew-empty-title">Erreur</div><div class="ew-empty-sub">${e.message}</div></div>`;
    }
  }

  function renderDeadline(d: any, today: Date): string {
    const dt   = new Date(d.deadline_date);
    const days = Math.ceil((dt.getTime() - today.getTime()) / 86400000);
    const isPast = days < 0;

    const dayNum   = dt.getDate();
    const monthYear = dt.toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' });

    const countdown = isPast
      ? `il y a ${Math.abs(days)} j`
      : days === 0 ? "aujourd'hui"
      : days === 1 ? 'demain'
      : days < 30 ? `dans ${days} j`
      : days < 60 ? 'dans 1 mois'
      : `dans ${Math.round(days / 30)} mois`;

    const badge = d.priority === 'critical'
      ? `<span class="badge-critical">CRITIQUE</span>`
      : d.priority === 'high'
        ? `<span class="badge-high">ÉLEVÉ</span>`
        : d.priority === 'medium'
          ? `<span class="badge-medium">MOYEN</span>`
          : '';

    const procs = d.procedures_impacted?.length
      ? `<div class="dl-procs">Procédures : ${d.procedures_impacted.join(', ')}</div>` : '';

    const isImminent = !isPast && days <= 30;

    return `
      <div class="deadline-card${isImminent ? ' imminent' : ''}">
        <div>
          <div class="dl-day">${dayNum}</div>
          <div class="dl-monthyear">${monthYear}</div>
          <div class="dl-countdown">${countdown}</div>
        </div>
        <div>
          <div class="dl-title">${d.title || d.regulation || '—'}</div>
          ${d.description ? `<div class="dl-desc">${d.description}</div>` : ''}
          ${procs}
        </div>
        ${badge}
      </div>`;
  }

  loadDeadlines();
</script>
