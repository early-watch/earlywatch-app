---
// Fil (MVP) — page d'accueil de l'espace client.
// Publications à traiter (statut client `inbox`), niveau en tête, triées par niveau
// puis par date. Une seule action visible par ligne (« Suivre ») ; les autres
// dans le détail. Détail à droite (≥ 1100 px) ou plein écran (en dessous).
//
// Rien à traiter (aucune publication de niveau Action) : « Rien à traiter cette
// semaine », prochaine échéance du calendrier avec compte à rebours, puis les
// publications À lire / Info des 30 derniers jours. Sans publication à
// sélectionner, le panneau de détail est masqué.
import ClientLayout from '../../layouts/ClientLayout.astro';
const base = import.meta.env.BASE_URL;
---

<ClientLayout title="Fil" activePage="fil">
  <div class="ew-header">
    <h1 class="ew-h-title" id="fil-title">Fil</h1>
  </div>

  <section class="fil-next" id="fil-next" hidden>
    <div class="fil-next-label">Prochaine échéance</div>
    <div class="fil-next-when"><span id="fil-next-date"></span><span class="fil-next-count" id="fil-next-count"></span></div>
    <div class="fil-next-title" id="fil-next-title"></div>
    <a class="fil-next-link" href={`${base}app/calendrier`}>Voir le calendrier →</a>
  </section>

  <h2 class="fil-section-label" id="fil-recent-label" hidden>À lire et Info · 30 derniers jours</h2>

  <div class="fil-layout" id="fil-layout">
    <div class="fil-list" id="fil-list"><div class="ew-loading"><div class="ew-spinner"></div></div></div>
    <aside class="fil-detail" id="fil-detail" aria-live="polite">
      <div class="fil-detail-placeholder">Sélectionnez une publication pour voir le détail.</div>
    </aside>
  </div>
</ClientLayout>

<script>
  import { API, api, getToken, toast } from '../../scripts/api';
  import { levelOf, byLevelThenDate, renderRow, renderDetail, esc } from '../../scripts/fil.js';
  import { nextDeadline, relativeLabel, isExactDate, normalizeProfileCode } from '../../scripts/calendrier-dates.js';
  import { calendrier } from '../../data/calendrier';

  const WIDE = window.matchMedia('(min-width: 1100px)');
  const RECENT_DAYS = 30;
  let items: any[] = [];
  let calm = false;                 // aucune publication de niveau Action
  let selectedId: string | null = null;

  const listEl = document.getElementById('fil-list')!;
  const detailEl = document.getElementById('fil-detail')!;
  const layoutEl = document.getElementById('fil-layout')!;
  const titleEl = document.getElementById('fil-title')!;

  const DETAIL_ACTIONS = [
    { label: 'Suivre', value: 'to_process', primary: true },
    { label: 'Marquer comme lu', value: 'read' },
    { label: 'Ignorer', value: 'ignored' },
  ];
  const DONE: Record<string, string> = {
    to_process: 'Publication ajoutée à vos suivis',
    read: 'Publication marquée comme lue',
    ignored: 'Publication ignorée',
  };

  function renderTitle(): void {
    const n = items.filter((a) => levelOf(a) === 'action').length;
    titleEl.textContent = calm
      ? 'Rien à traiter cette semaine'
      : `${n} publication${n > 1 ? 's demandent' : ' demande'} une action`;
  }

  function renderList(): void {
    document.getElementById('fil-recent-label')!.hidden = !calm || !items.length;
    // Rien à sélectionner : pas de panneau de détail.
    layoutEl.classList.toggle('is-single', !items.length);
    listEl.innerHTML = items.length
      ? items.map((a) => renderRow(a, { action: { label: 'Suivre', value: 'to_process' }, selected: WIDE.matches && a.id === selectedId })).join('')
      : `<div class="fil-empty">${calm
          ? 'Aucune publication ces 30 derniers jours.'
          : 'Aucune nouvelle publication.'} Les publications que vous suivez sont dans Suivis.</div>`;
  }

  function showDetail(id: string | null, open = false): void {
    selectedId = id;
    const a = items.find((x) => x.id === id);
    detailEl.innerHTML = a
      ? renderDetail(a, { actions: DETAIL_ACTIONS })
      : '<div class="fil-detail-placeholder">Sélectionnez une publication pour voir le détail.</div>';
    listEl.querySelectorAll('.fil-row').forEach((r) =>
      r.classList.toggle('is-selected', WIDE.matches && r.getAttribute('data-id') === id));
    const full = open && !WIDE.matches && !!a;
    detailEl.classList.toggle('is-open', full);
    document.body.classList.toggle('fil-detail-open', full);
    if (full) detailEl.scrollTop = 0;
  }

  function closeDetail(): void {
    detailEl.classList.remove('is-open');
    document.body.classList.remove('fil-detail-open');
  }

  async function act(id: string, action: string, btn?: HTMLButtonElement): Promise<void> {
    if (btn) btn.disabled = true;
    try {
      await api(`/api/v1/app/articles/${id}/state`, { method: 'PATCH', body: { action } });
      toast(DONE[action] || 'Mis à jour');
      window.dispatchEvent(new Event('ew:counts-changed'));
      closeDetail();
      const wasActionMode = !calm;
      const idx = items.findIndex((x) => x.id === id);
      items = items.filter((x) => x.id !== id);   // quitte le Fil (suivie, lue ou ignorée)
      if (wasActionMode && !items.some((a) => levelOf(a) === 'action')) {
        await load();                             // plus rien à traiter : vue « rien à traiter »
        return;
      }
      renderTitle();
      renderList();
      const next = items[Math.min(idx, items.length - 1)];
      showDetail(WIDE.matches && next ? next.id : null);
    } catch (e: any) {
      if (btn) btn.disabled = false;
      toast(e.message, 'error');
    }
  }

  function onClick(e: Event): void {
    const target = e.target as HTMLElement;
    const btn = target.closest('[data-action]') as HTMLButtonElement | null;
    if (btn) {
      e.stopPropagation();
      act(btn.dataset.id!, btn.dataset.action!, btn);
      return;
    }
    if (target.closest('[data-close-detail]')) { closeDetail(); return; }
    const row = target.closest('.fil-row') as HTMLElement | null;
    if (row) showDetail(row.dataset.id!, true);
  }

  listEl.addEventListener('click', onClick);
  detailEl.addEventListener('click', onClick);
  listEl.addEventListener('keydown', (e) => {
    const row = (e.target as HTMLElement).closest('.fil-row') as HTMLElement | null;
    if (row && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); showDetail(row.dataset.id!, true); }
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDetail(); });
  WIDE.addEventListener('change', () => { closeDetail(); renderList(); showDetail(selectedId); });

  // ── Prochaine échéance (calendrier, filtré par le profil du client) ─────────
  async function clientProfile(): Promise<{ code: string | null; family: string | null } | null> {
    const token = getToken();
    if (!token) return null;
    try {
      const [settings, profiles] = await Promise.all([
        fetch(`${API}/api/v1/settings`, { headers: { Authorization: `Bearer ${token}` } }).then((r) => (r.ok ? r.json() : null)),
        fetch(`${API}/api/v1/auth/signup-profiles`).then((r) => (r.ok ? r.json() : [])).catch(() => []),
      ]);
      const code = normalizeProfileCode(settings?.settings?.entity_type);
      if (!code) return null;
      const p = (Array.isArray(profiles) ? profiles : []).find((x: any) => x.code === code);
      return { code, family: p?.family || null };
    } catch { return null; }
  }

  async function renderNext(): Promise<void> {
    const box = document.getElementById('fil-next')!;
    const profile = await clientProfile();
    const next = nextDeadline(calendrier, new Date(), profile);
    if (!next) { box.hidden = true; return; }
    document.getElementById('fil-next-date')!.textContent = next.entry.date;
    const rel = relativeLabel(next.status, next.days, isExactDate(next.entry.date));
    document.getElementById('fil-next-count')!.textContent = rel ? ` · ${rel}` : '';
    document.getElementById('fil-next-title')!.textContent = next.entry.obligation;
    box.hidden = false;
  }

  async function load(): Promise<void> {
    try {
      const data = await api('/api/v1/app/articles?status=inbox&page_size=200');
      const inbox: any[] = data.articles || [];
      calm = !inbox.some((a) => levelOf(a) === 'action');
      if (calm) {
        // À lire / Info des 30 derniers jours (hors publications suivies ou ignorées).
        const all = await api('/api/v1/app/articles?status=all&page_size=200');
        const since = Date.now() - RECENT_DAYS * 86400000;
        items = (all.articles || [])
          .filter((a: any) => a.client_status !== 'to_process' && levelOf(a) !== 'action')
          .filter((a: any) => new Date(a.published_at).getTime() >= since)
          .sort((a: any, b: any) => String(b.published_at || '').localeCompare(String(a.published_at || '')));
        renderNext();
      } else {
        items = inbox.slice().sort(byLevelThenDate);
        document.getElementById('fil-next')!.hidden = true;
      }
      renderTitle();
      renderList();
      showDetail(WIDE.matches && items[0] ? items[0].id : null);
    } catch (e: any) {
      listEl.innerHTML = `<div class="fil-empty">Erreur de chargement : ${esc(e.message)}</div>`;
    }
  }

  load();
</script>
