---
// Ancien tableau de bord (retiré au MVP) → Fil (page d'accueil, réglage central : src/data/client-pages.ts).
import { HOME_PAGE } from '../../data/client-pages';
const base = import.meta.env.BASE_URL;
const home = `${base}${HOME_PAGE.path}`;
---
<meta http-equiv="refresh" content={`0;url=${home}`} />
<script is:inline define:vars={{ home }}>window.location.replace(home);</script>
