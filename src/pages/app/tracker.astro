---
import ClientLayout from '../../layouts/ClientLayout.astro';
---

<ClientLayout title="Registre réglementaire" activePage="tracker">

  <div class="ew-header">
    <h1 class="ew-h-title">Registre réglementaire</h1>
    <div class="ew-h-date" id="tracker-count"></div>
  </div>

  <div id="tracker-list">
    <div class="ew-loading"><div class="ew-spinner"></div></div>
  </div>

</ClientLayout>

<script>
  import { sourceAvatarHTML } from '../../scripts/sigles.js';

  const TRACKER_URL = 'https://raw.githubusercontent.com/MariaEarly/early-brief-site/main/public/outils/tracker/tracker-data.json';

  const TYPE_LABELS: Record<string, string> = {
    TEXTE: 'Texte', DECISION: 'Décision', CONSULTATION: 'Consultation',
    RAPPORT: 'Rapport', INTELLIGENCE: 'Intelligence',
  };

  function rawToISO(raw: string): string {
    const p = raw.split('/');
    return p.length === 3 ? `${p[2]}-${p[1]}-${p[0]}` : raw;
  }

  function fmtDate(raw: string): string {
    try {
      return new Date(rawToISO(raw)).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
    } catch { return raw; }
  }

  function renderEntry(e: any): string {
    const typeLabel = TYPE_LABELS[e.type] || e.type || '';
    const statut = e.statut ? e.statut.charAt(0).toUpperCase() + e.statut.slice(1) : '';
    const title = e.titre || 'Sans titre';
    const titleHtml = e.url
      ? `<a href="${e.url}" target="_blank" rel="noopener" style="color:inherit;text-decoration:none">${title}</a>`
      : title;

    return `
      <div class="ew-item">
        ${sourceAvatarHTML(e.source)}
        <div class="ew-item-body">
          <div class="ew-meta">
            <span class="src">${e.source || '—'}</span>
            <span class="dot">·</span>
            <span class="date">${fmtDate(e.date)}</span>
            ${typeLabel ? `<span class="dot">·</span><span class="ew-label-text">${typeLabel}</span>` : ''}
          </div>
          <h3 class="ew-title">${titleHtml}</h3>
          ${e.description ? `<div style="font-size:12px;color:var(--taupe);margin-top:8px;line-height:1.55">${e.description}</div>` : ''}
        </div>
        <div class="ew-item-side" style="padding-top:2px;white-space:nowrap">
          ${statut ? `<span class="ew-label-text">${statut}</span>` : ''}
        </div>
      </div>`;
  }

  async function loadTracker() {
    const container = document.getElementById('tracker-list')!;
    try {
      const res = await fetch(TRACKER_URL);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const entries: any[] = await res.json();

      const sorted = [...entries].sort((a: any, b: any) =>
        new Date(rawToISO(b.date)).getTime() - new Date(rawToISO(a.date)).getTime()
      );

      if (!sorted.length) {
        container.innerHTML = '<div class="ew-empty"><div class="ew-empty-title">Tracker vide</div><div class="ew-empty-sub">Aucune entrée.</div></div>';
        return;
      }

      const countEl = document.getElementById('tracker-count');
      if (countEl) countEl.textContent = `${sorted.length} entrées`;

      container.innerHTML = `<div class="ew-list">${sorted.map(renderEntry).join('')}</div>`;

    } catch (e: any) {
      container.innerHTML = `<div class="ew-empty"><div class="ew-empty-title">Erreur de chargement</div><div class="ew-empty-sub">${e.message}</div></div>`;
    }
  }

  loadTracker();
</script>
