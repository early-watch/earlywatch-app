---
// Paramètres (MVP) — page unique : établissement, profil, e-mails, utilisateurs,
// abonnement. Chaque information n'apparaît qu'une fois ; aucun module hors MVP.
//
// Sources : GET /api/v1/settings (tenant, settings, users), GET /api/v1/auth/signup-profiles
// (libellés des profils), GET /api/v1/billing/status (abonnement).
// Écritures : PUT /api/v1/settings (nom de l'établissement, préférences e-mail),
// POST /api/v1/billing/portal-session (gestion de l'abonnement).
import ClientLayout from '../../layouts/ClientLayout.astro';
---

<ClientLayout title="Paramètres" activePage="parametres">
  <div class="ew-header">
    <h1 class="ew-h-title">Paramètres</h1>
  </div>

  <div class="pm-wrap ew-glass ew-panel" id="pm-wrap">
    <div class="ew-loading"><div class="ew-spinner"></div></div>
  </div>
</ClientLayout>

<style>
  .pm-wrap { max-width: 720px; }
  :global(.pm-section) { padding: 22px 0 26px; border-top: 0.5px solid var(--line); }
  :global(.pm-section:first-child) { border-top: none; padding-top: 4px; }
  :global(.pm-h2) { font-family: var(--font); font-size: var(--label-size); font-weight: var(--label-weight); color: var(--label-color); letter-spacing: var(--label-tracking); text-transform: var(--label-transform); margin: 0 0 14px; }
  :global(.pm-row) { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 6px 20px; padding: 6px 0; font-size: 13.5px; }
  :global(.pm-k) { color: var(--taupe); }
  :global(.pm-v) { color: var(--ink); overflow-wrap: anywhere; }
  :global(.pm-hint) { font-size: 12.5px; color: var(--mute); line-height: 1.55; margin-top: 8px; }
  :global(.pm-hint a) { color: var(--accent); }
  :global(.pm-form) { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  :global(.pm-input) {
    font-family: inherit; font-size: 13.5px; color: var(--ink); background: var(--bg);
    border: 0.5px solid var(--line-strong); border-radius: var(--radius); padding: 7px 10px;
    flex: 1 1 240px; min-width: 0;
  }
  :global(.pm-btn) {
    font-family: inherit; font-size: 12.5px; color: var(--on-accent); background: var(--accent);
    border: 0.5px solid var(--accent); border-radius: var(--radius); padding: 7px 14px; cursor: pointer;
    text-decoration: none; display: inline-block;
  }
  :global(.pm-btn:disabled) { opacity: 0.5; cursor: default; }
  :global(.pm-choice) { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; margin: 0; font-size: 13.5px; font-weight: 400; color: var(--ink); cursor: pointer; }
  :global(.pm-choice input) { flex: 0 0 auto; width: auto; margin-top: 3px; accent-color: var(--accent); }
  :global(.pm-followed) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 28px; }
  :global(.pm-group) { border: none; padding: 0; margin: 0; min-width: 0; }
  :global(.pm-group legend) { font-size: 12.5px; color: var(--mute); padding: 0; margin: 0 0 4px; }
  :global(.pm-check) { padding: 5px 0; }
  @media (max-width: 640px) { :global(.pm-followed) { grid-template-columns: minmax(0, 1fr); gap: 12px; } }
  :global(.pm-choice > span) { flex: 1 1 auto; min-width: 0; }
  :global(.pm-choice small) { display: block; color: var(--mute); font-size: 12px; margin-top: 2px; }
  :global(.pm-users) { width: 100%; border-collapse: collapse; font-size: 13px; }
  :global(.pm-users th) { text-align: left; font-weight: 500; font-size: 11.5px; color: var(--taupe); padding: 6px 12px 6px 0; border-bottom: 0.5px solid var(--line); }
  :global(.pm-users td) { padding: 9px 12px 9px 0; border-bottom: 0.5px solid var(--line); vertical-align: top; }
  :global(.pm-users td.pm-email) { overflow-wrap: anywhere; }
  :global(.pm-users td.pm-nowrap) { white-space: nowrap; }
  /* Utilisateurs : places, invitation, retrait (src/scripts/equipe.js) */
  :global(.pm-users-head) { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 0 0 12px; }
  :global(.pm-seats) { font-family: var(--font); font-size: 12px; color: var(--ink); }
  :global(.pm-full) { margin: 0 0 12px; }
  :global(.pm-link) { font: inherit; font-size: 12.5px; color: var(--accent); background: none; border: none; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
  :global(.pm-link:disabled) { opacity: 0.5; cursor: default; }
  :global(.pm-link.pm-danger) { color: var(--color-error); }
  :global(.pm-confirm) { font-size: 12.5px; color: var(--ink); white-space: normal; }
  :global(.pm-confirm .pm-link) { margin-left: 8px; }
  :global(.pm-users td.pm-act) { text-align: right; white-space: nowrap; }
  :global(.pm-users td.pm-last .pm-link) { margin-left: 2px; }
  :global(.pm-sr) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  :global(.pm-invite) { border: 0.5px solid var(--line-strong); border-radius: var(--radius); padding: 16px; margin: 0 0 16px; background: var(--bg-side); }
  :global(.pm-invite-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 14px; }
  :global(.pm-invite-grid label) { display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 400; color: var(--taupe); }
  :global(.pm-invite-grid .pm-input) { flex: none; width: 100%; }
  :global(.pm-invite-actions) { display: flex; gap: 14px; align-items: center; margin-top: 14px; }
  :global(.pm-tag) { font-family: var(--font); font-size: 10px; color: var(--accent); margin-left: 6px; }
  :global(.pm-status) { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: var(--radius-sm); border: 0.5px solid var(--line-strong); color: var(--taupe); }
  :global(.pm-status.ok) { color: var(--on-accent); background: var(--accent); border-color: var(--accent); }
  :global(.pm-status.warn) { color: var(--color-error); border-color: var(--color-error); }

  @media (max-width: 640px) {
    :global(.pm-row) { grid-template-columns: minmax(0, 1fr); gap: 2px; padding: 8px 0; }
    :global(.pm-users thead) { display: none; }
    :global(.pm-users tr) { display: block; padding: 10px 0; border-bottom: 0.5px solid var(--line); }
    :global(.pm-users td) { display: block; padding: 1px 0; border: none; }
    :global(.pm-users td.pm-act) { text-align: left; padding-top: 6px; }
    :global(.pm-users td.pm-act:empty) { display: none; }
    :global(.pm-invite-grid) { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { API, api, getUser, toast } from '../../scripts/api';
  import { planLabel } from '../../scripts/plans.js';
  import { usersSectionHtml, seatLimit, parseTeam, ROLE_LABELS } from '../../scripts/equipe.js';

  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';
  const wrap = document.getElementById('pm-wrap')!;
  const me = getUser() || {};
  const isAdmin = me.role === 'admin' || me.role === 'superadmin';

  const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const date = (iso?: string | null) => iso ? new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
  // Le ressort est stocké normalisé en minuscules (normalize_ressort) : majuscule à l'affichage.
  const capitalize = (v: string) => v.charAt(0).toUpperCase() + v.slice(1);
  const row = (k: string, v: string) => `<div class="pm-row"><div class="pm-k">${k}</div><div class="pm-v">${v}</div></div>`;

  // Préférences e-mail : deux choix exclusifs, traduits vers les deux champs lus par
  // le serveur (weekly_digest.py : récapitulatif envoyé si alert_digest ∈ {weekly, daily}
  // OU alert_email_enabled ; alertes importantes si alert_email_enabled).
  // Pas d'option « Alertes importantes » dans le MVP : les deux choix écrivent
  // alert_email_enabled = false.
  const EMAIL_CHOICES = [
    { value: 'none', label: 'Aucun e-mail', hint: 'Vous consultez la veille dans l’application.',
      patch: { alert_email_enabled: false, alert_digest: 'immediate' } },
    { value: 'weekly', label: 'Récapitulatif hebdomadaire', hint: 'Un e-mail par semaine.',
      patch: { alert_email_enabled: false, alert_digest: 'weekly' } },
  ];
  // Un établissement déjà réglé sur les alertes (alert_email_enabled) reçoit aussi le
  // récapitulatif hebdomadaire : il apparaît sur ce choix.
  function emailChoice(s: any): string {
    if (s.alert_email_enabled) return 'weekly';
    return s.alert_digest === 'weekly' || s.alert_digest === 'daily' ? 'weekly' : 'none';
  }

  const SUB_LABELS: Record<string, [string, string]> = {
    active: ['Actif', 'ok'], past_due: ['Paiement en retard', 'warn'], canceled: ['Résilié', ''], none: ['Aucun abonnement', ''],
  };

  function subscriptionHtml(billing: any, t: any): string {
    if (!billing) {
      return row('Formule', esc(planLabel(t.plan))) + '<div class="pm-hint">Informations d’abonnement indisponibles pour le moment.</div>';
    }
    const [label, cls] = SUB_LABELS[billing.subscription_status] || [esc(billing.subscription_status), ''];
    const grace = billing.subscription_status === 'past_due' && billing.grace_ends_at
      ? `<div class="pm-hint">Accès maintenu jusqu’au ${date(billing.grace_ends_at)}. Mettez à jour votre moyen de paiement pour éviter la suspension.</div>` : '';
    // L'abonnement est réservé à l'administrateur : un lecteur le voit en lecture seule.
    const action = !isAdmin
      ? '<div class="pm-hint">L’abonnement est géré par l’administrateur du compte.</div>'
      : billing.can_manage
        ? '<button type="button" class="pm-btn" id="pm-portal">Gérer l’abonnement</button>'
        : `<a class="pm-btn" href="${BASE}choisir-formule">Choisir une formule</a>`;
    return row('Formule', esc(planLabel(billing.plan || t.plan)))
      + row('Statut', `<span class="pm-status ${cls}">${label}</span>`)
      + (billing.current_period_end ? row('Prochaine échéance', date(billing.current_period_end)) : '')
      + grace
      + `<div style="margin-top:14px">${action}</div>`
      + (billing.can_manage && isAdmin ? '<div class="pm-hint">Factures, moyen de paiement et résiliation : portail sécurisé de notre prestataire de paiement.</div>' : '');
  }

  // ── Utilisateurs (src/scripts/equipe.js) ───────────────────────────────────
  const team: any = { users: [], used: null, slug: null, limit: null, plan: null, confirmId: null, formOpen: false, upgradeHref: '' };
  const usersUrl = (id = '') => `/api/v1/tenants/${encodeURIComponent(team.slug)}/users${id ? `/${encodeURIComponent(id)}` : ''}`;

  // Consultant : choix des profils suivis (clients conseillés). Liste des profils de
  // l'inscription, sans « consultant » ; regroupés par famille quand elle est connue.
  function followedHtml(profiles: any[], current: unknown): string {
    const selected = new Set(Array.isArray(current) ? current.map((v) => String(v)) : []);
    const choices = profiles.filter((p) => p && p.code && p.code !== 'consultant');
    if (!choices.length) return '';
    const groups: [string, any[]][] = [
      ['Secteur financier', choices.filter((p) => p.family === 'financier')],
      ['Professions non financières', choices.filter((p) => p.family !== 'financier')],
    ];
    const box = (p: any) => `
      <label class="pm-choice pm-check"><input type="checkbox" name="pm-followed" value="${esc(p.code)}" ${selected.has(p.code) ? 'checked' : ''} ${isAdmin ? '' : 'disabled'}>
        <span>${esc(p.label)}</span></label>`;
    return `
      <section class="pm-section">
        <h2 class="pm-h2">Profils suivis</h2>
        <form id="pm-followed-form" class="pm-followed">
          ${groups.filter(([, list]) => list.length).map(([title, list]) => `
            <fieldset class="pm-group"><legend>${title}</legend>${list.map(box).join('')}</fieldset>`).join('')}
        </form>
        <div class="pm-hint">Les niveaux du Fil seront calculés pour ces profils.</div>
      </section>`;
  }

  function renderUsers(): void {
    const sec = document.getElementById('pm-users-section');
    if (!sec) return;
    sec.innerHTML = usersSectionHtml({
      users: team.users, meId: me.id, admin: isAdmin && !!team.slug,
      limit: team.limit, used: team.used, plan: team.plan, confirmId: team.confirmId, formOpen: team.formOpen, upgradeHref: team.upgradeHref,
    });
    if (team.formOpen) (sec.querySelector('[name=first_name]') as HTMLInputElement | null)?.focus();
  }

  function applyTeam(res: any): void {
    const t = parseTeam(res);
    if (!t) return;
    team.users = t.users;
    team.used = t.used;
    if (t.limit !== undefined) team.limit = t.limit;
  }

  async function reloadUsers(): Promise<void> {
    try { applyTeam(await api(usersUrl())); } catch { /* garde la liste affichée */ }
    renderUsers();
  }

  async function openPortal(): Promise<void> {
    try { const r = await api('/api/v1/billing/portal-session', { method: 'POST' }); window.location.href = r.url; }
    catch (err: any) { toast(err.message, 'error'); }
  }

  wrap.addEventListener('click', async (e) => {
    const el = (e.target as HTMLElement).closest('button, a') as HTMLElement | null;
    if (!el || !el.closest('#pm-users-section')) return;
    const d = el.dataset;
    if (el.id === 'pm-invite-open') { team.formOpen = true; team.confirmId = null; renderUsers(); return; }
    if ('inviteCancel' in d) { team.formOpen = false; renderUsers(); return; }
    if ('upgrade' in d && team.upgradeHref === '#') { e.preventDefault(); openPortal(); return; }
    if (d.remove) { team.confirmId = d.remove; renderUsers(); return; }
    if ('removeCancel' in d) { team.confirmId = null; renderUsers(); return; }
    if (d.removeConfirm) {
      const u = team.users.find((x: any) => x.id === d.removeConfirm);
      (el as HTMLButtonElement).disabled = true;
      try {
        await api(usersUrl(d.removeConfirm), { method: 'DELETE' });
        toast(`${[u?.first_name, u?.last_name].filter(Boolean).join(' ') || u?.email || 'Utilisateur'} retiré du compte`);
        team.confirmId = null;
        await reloadUsers();
      } catch (err: any) { (el as HTMLButtonElement).disabled = false; toast(err.message, 'error'); }
      return;
    }
    if (d.resend) {
      const u = team.users.find((x: any) => x.id === d.resend);
      (el as HTMLButtonElement).disabled = true;
      try {
        const r = await api(`${usersUrl(d.resend)}/invitation`, { method: 'POST' });
        if (r && r.invitation_sent === false) toast('L’invitation n’a pas pu être envoyée. Réessayez dans un instant.', 'error');
        else toast(`Invitation renvoyée à ${u?.email || ''}`);
      } catch (err: any) { toast(err.message, 'error'); }
      (el as HTMLButtonElement).disabled = false;
    }
  });

  wrap.addEventListener('submit', async (e) => {
    const form = e.target as HTMLFormElement;
    if (form.id !== 'pm-invite-form') return;
    e.preventDefault();
    const f = new FormData(form);
    const body = {
      first_name: String(f.get('first_name') || '').trim(),
      last_name: String(f.get('last_name') || '').trim(),
      email: String(f.get('email') || '').trim(),
      role: f.get('role') === 'admin' ? 'admin' : 'reader',
    };
    if (!body.first_name || !body.last_name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(body.email)) {
      toast('Renseignez le prénom, le nom et une adresse e-mail valide.', 'error');
      return;
    }
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    try {
      // Sans mot de passe : le serveur envoie l'invitation.
      const created = await api(usersUrl(), { method: 'POST', body });
      if (created && created.invitation_sent === false) {
        toast(`${body.email} est ajouté, mais l’invitation n’a pas pu être envoyée : utilisez « Renvoyer ».`, 'error');
      } else {
        toast(`Invitation envoyée à ${body.email}`);
      }
      team.formOpen = false;
      await reloadUsers();
    } catch (err: any) { btn.disabled = false; toast(err.message, 'error'); }
  });

  async function load(): Promise<void> {
    let data: any;
    try {
      data = await api('/api/v1/settings');
    } catch (e: any) {
      wrap.innerHTML = `<div class="pm-hint">Erreur de chargement : ${esc(e.message)}</div>`;
      return;
    }
    const [profiles, billing] = await Promise.all([
      fetch(`${API}/api/v1/auth/signup-profiles`).then((r) => (r.ok ? r.json() : [])).then((l) => (Array.isArray(l) ? l : [])).catch(() => []),
      api('/api/v1/billing/status').catch(() => null),
    ]);
    const t = data.tenant || {};
    const s = data.settings || {};
    team.users = data.users || [];
    team.slug = t.slug;
    team.plan = billing?.plan || t.plan || null;
    team.upgradeHref = billing?.can_manage ? '#'
      : billing?.subscription_status === 'active'
        ? 'mailto:maria@early.consulting?subject=Passer%20%C3%A0%20la%20formule%20%C3%89quipe'
        : `${BASE}choisir-formule`;
    const profile = (profiles as any[]).find((p) => p.code === String(s.entity_type || '').toLowerCase());
    const profileLabel = profile ? profile.label : (s.entity_type || 'Non renseigné');
    const choice = emailChoice(s);

    wrap.innerHTML = `
      <section class="pm-section">
        <h2 class="pm-h2">Établissement</h2>
        ${isAdmin
          ? `<form class="pm-form" id="pm-name-form"><input class="pm-input" id="pm-name" maxlength="255" value="${esc(t.name)}" aria-label="Nom de l’établissement"><button class="pm-btn" type="submit">Enregistrer</button></form>`
          : row('Nom', esc(t.name))}
      </section>

      <section class="pm-section">
        <h2 class="pm-h2">Profil</h2>
        ${row('Activité', esc(profileLabel))}
        ${s.ressort ? row(esc(profile?.ressort_label || 'Ressort'), esc(capitalize(s.ressort))) : ''}
        <div class="pm-hint">Votre profil détermine les sources suivies. Pour le modifier, écrivez-nous : <a href="mailto:maria@early.consulting">maria@early.consulting</a>.</div>
      </section>
      ${String(s.entity_type || '').toLowerCase() === 'consultant' ? followedHtml(profiles as any[], s.followed_profiles) : ''}

      <section class="pm-section">
        <h2 class="pm-h2">E-mails</h2>
        <form id="pm-email-form">
          ${EMAIL_CHOICES.map((c) => `
            <label class="pm-choice"><input type="radio" name="pm-email" value="${c.value}" ${c.value === choice ? 'checked' : ''} ${isAdmin ? '' : 'disabled'}>
              <span>${c.label}<small>${c.hint}</small></span></label>`).join('')}
        </form>
      </section>

      <section class="pm-section" id="pm-users-section"></section>

      <section class="pm-section">
        <h2 class="pm-h2">Abonnement</h2>
        ${subscriptionHtml(billing, t)}
      </section>`;

    renderUsers();
    if (isAdmin && t.slug) {
      // Liste complète et places de la formule : réservées à l'administrateur.
      const [list, plans] = await Promise.all([
        api(`/api/v1/tenants/${encodeURIComponent(t.slug)}/users`).catch(() => null),
        api('/api/v1/billing/plans').catch(() => []),
      ]);
      team.limit = seatLimit(billing, plans);    // repli si le serveur ne donne pas seats_max
      applyTeam(list);
      renderUsers();
    }

    document.getElementById('pm-name-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('pm-name') as HTMLInputElement).value.trim();
      if (name.length < 2) { toast('Nom trop court', 'error'); return; }
      try { await api('/api/v1/settings', { method: 'PUT', body: { name } }); toast('Nom enregistré'); }
      catch (err: any) { toast(err.message, 'error'); }
    });

    // Consultant : profils suivis (PUT /settings followed_profiles), enregistrés à chaque case.
    document.getElementById('pm-followed-form')?.addEventListener('change', async () => {
      const form = document.getElementById('pm-followed-form') as HTMLFormElement;
      const followed = [...form.querySelectorAll<HTMLInputElement>('input[name="pm-followed"]:checked')].map((i) => i.value);
      try { await api('/api/v1/settings', { method: 'PUT', body: { followed_profiles: followed } }); toast('Profils suivis enregistrés'); }
      catch (err: any) { toast(err.message, 'error'); }
    });

    document.getElementById('pm-email-form')?.addEventListener('change', async (e) => {
      const c = EMAIL_CHOICES.find((x) => x.value === (e.target as HTMLInputElement).value);
      if (!c) return;
      try { await api('/api/v1/settings', { method: 'PUT', body: c.patch }); toast('Préférence enregistrée'); }
      catch (err: any) { toast(err.message, 'error'); }
    });

    document.getElementById('pm-portal')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      try { const r = await api('/api/v1/billing/portal-session', { method: 'POST' }); window.location.href = r.url; }
      catch (err: any) { btn.disabled = false; toast(err.message, 'error'); }
    });
  }

  load();
</script>
