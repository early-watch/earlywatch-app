---
// Suivis : publications que l'abonné a choisi de garder (statut client `to_process`),
// avec un bouton « Traité ». Dessous, l'historique des publications traitées :
// passées de `to_process` à `read` (processed_at renseigné), datées de read_at.
// Aucune nouvelle notion : statuts existants de tenant_article_states.
import ClientLayout from '../../layouts/ClientLayout.astro';
---

<ClientLayout title="Suivis" activePage="suivis">
  <div class="ew-header">
    <h1 class="ew-h-title">Suivis</h1>
    <div class="ew-h-date" id="suivis-count"></div>
  </div>

  <section class="sv-section">
    <div id="suivis-list"><div class="ew-loading"><div class="ew-spinner"></div></div></div>
  </section>

  <section class="sv-section">
    <h2 class="sv-label">Traitées</h2>
    <div id="traitees-list"></div>
  </section>
</ClientLayout>

<style>
  .sv-section { margin-bottom: 36px; }
  .sv-label {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 500; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--taupe); margin-bottom: 10px;
  }
  :global(.sv-row) {
    display: flex; gap: 16px; align-items: flex-start; justify-content: space-between;
    padding: 14px 0; border-bottom: 0.5px solid var(--line);
  }
  :global(.sv-main) { min-width: 0; flex: 1; }
  :global(.sv-title) { font-size: 14px; font-weight: 500; color: var(--ink); line-height: 1.4; overflow-wrap: anywhere; }
  :global(.sv-title a) { color: inherit; text-decoration: none; }
  :global(.sv-title a:hover) { text-decoration: underline; text-underline-offset: 2px; }
  :global(.sv-meta) { font-size: 12px; color: var(--mute); margin-top: 4px; }
  :global(.sv-btn) {
    flex-shrink: 0; font-family: inherit; font-size: 12px; color: var(--on-accent); background: var(--accent);
    border: 0.5px solid var(--accent); border-radius: var(--radius); padding: 6px 12px; cursor: pointer;
  }
  :global(.sv-btn:disabled) { opacity: 0.5; cursor: default; }
  :global(.sv-empty) { font-size: 13px; color: var(--mute); padding: 8px 0; }
</style>

<script>
  import { api, toast } from '../../scripts/api';

  const esc = (s: string) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const day = (iso?: string) => iso ? new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

  function row(a: any, action: boolean): string {
    const title = a.original_url
      ? `<a href="${esc(a.original_url)}" target="_blank" rel="noopener">${esc(a.title)}</a>`
      : esc(a.title);
    const meta = action
      ? `${esc(a.source_name || '')} · publié le ${day(a.published_at)}`
      : `${esc(a.source_name || '')} · traité le ${day(a.read_at)}`;
    return `<div class="sv-row" data-id="${esc(a.id)}">
      <div class="sv-main"><div class="sv-title">${title}</div><div class="sv-meta">${meta}</div></div>
      ${action ? '<button type="button" class="sv-btn">Traité</button>' : ''}
    </div>`;
  }

  async function load(): Promise<void> {
    const list = document.getElementById('suivis-list')!;
    const done = document.getElementById('traitees-list')!;
    try {
      const [suivis, lus] = await Promise.all([
        api('/api/v1/app/articles?status=to_process&page_size=200'),
        api('/api/v1/app/articles?status=read&page_size=200'),
      ]);
      const items: any[] = suivis.articles || [];
      const traitees: any[] = (lus.articles || [])
        .filter((a: any) => a.processed_at)
        .sort((a: any, b: any) => String(b.read_at || '').localeCompare(String(a.read_at || '')));
      document.getElementById('suivis-count')!.textContent = `${items.length} suivie${items.length > 1 ? 's' : ''}`;
      list.innerHTML = items.length
        ? items.map((a) => row(a, true)).join('')
        : '<div class="sv-empty">Aucune publication suivie. Depuis le Fil, gardez celles qui demandent un suivi.</div>';
      done.innerHTML = traitees.length
        ? traitees.map((a) => row(a, false)).join('')
        : '<div class="sv-empty">Aucune publication traitée pour l’instant.</div>';
    } catch (e: any) {
      list.innerHTML = `<div class="sv-empty">Erreur : ${esc(e.message)}</div>`;
    }
  }

  document.getElementById('suivis-list')!.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('.sv-btn') as HTMLButtonElement | null;
    if (!btn) return;
    const id = btn.closest('.sv-row')?.getAttribute('data-id');
    if (!id) return;
    btn.disabled = true;
    try {
      await api(`/api/v1/app/articles/${id}/state`, { method: 'PATCH', body: { action: 'read' } });
      toast('Publication marquée comme traitée', 'success');
      await load();
    } catch (err: any) {
      btn.disabled = false;
      toast(err.message, 'error');
    }
  });

  load();
</script>
