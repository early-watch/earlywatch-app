---
import SmartLayout from '../layouts/SmartLayout.astro';
const base = import.meta.env.BASE_URL;
---

<SmartLayout title="Fiches Réflexes — Early Watch" activePage="situations">
  <div style="max-width:1100px;margin:0 auto;">
    <div class="sit-page-title">Fiches Réflexes</div>
    <div class="sit-page-sub">Guides opérationnels par situation — liés à votre veille réglementaire en temps réel</div>

    <div class="filters">
      <span class="filter-lbl">Profil :</span>
      <button class="fbtn active" data-f="profile" data-v="">Tous</button>
      <button class="fbtn" data-f="profile" data-v="PSP">PSP</button>
      <button class="fbtn" data-f="profile" data-v="CASP">CASP</button>
      <button class="fbtn" data-f="profile" data-v="Banque">Banque</button>
      <span class="filter-lbl" style="margin-left:8px">Urgence :</span>
      <button class="fbtn active" data-f="urgency" data-v="">Toutes</button>
      <button class="fbtn" data-f="urgency" data-v="immediate">Immédiate</button>
      <button class="fbtn" data-f="urgency" data-v="high">Haute</button>
    </div>

    <div id="grid" class="grid">
      <div class="sit-loading">Chargement des fiches réflexes...</div>
    </div>
  </div>
</SmartLayout>

<style>
  .sit-page-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 4px; }
  .sit-page-sub   { font-size: 13px; color: var(--mute); margin-bottom: 28px; }

  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; align-items: center; }
  .filter-lbl {
    font-size: 10.5px; color: var(--mute); font-family: var(--font-mono);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .fbtn {
    padding: 5px 12px; border: 0.5px solid var(--line-strong);
    background: transparent; font-size: 12px; color: var(--taupe);
    cursor: pointer; font-family: inherit; transition: all 0.12s;
  }
  .fbtn:hover { background: var(--bg-side); color: var(--ink); }
  .fbtn.active { background: var(--ink); border-color: var(--ink); color: var(--bg); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; }
  .sit-loading { text-align: center; padding: 60px; color: var(--mute); font-size: 13px; }

  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  .sit-card {
    background: var(--bg); border: 0.5px solid var(--line);
    padding: 20px; cursor: pointer; transition: border-color 0.12s;
    display: flex; flex-direction: column; gap: 12px;
  }
  .sit-card:hover  { border-color: var(--line-strong); }
  .sit-card.open   { border-color: var(--line-strong); }

  .sit-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .sit-card-ref {
    font-family: var(--font-mono); font-size: 10px; color: var(--mute);
    background: var(--bg-side); padding: 3px 7px;
    border: 0.5px solid var(--line);
  }
  .urgency-badge {
    font-family: var(--font-mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.08em; padding: 3px 9px; white-space: nowrap;
    border: 0.5px solid var(--line);
  }
  .urgency-badge.immediate { color: var(--moutarde); border-color: var(--moutarde); }
  .urgency-badge.high      { color: var(--ink-soft); border-color: var(--line-strong); }
  .urgency-badge.medium    { color: var(--taupe);    border-color: var(--line); }
  .urgency-badge.low       { color: var(--mute);     border-color: var(--line); }

  .fresh-dot { width: 5px; height: 5px; border-radius: 50%; display: inline-block; margin-right: 4px; }
  .fresh-dot.hot  { background: var(--moutarde); }
  .fresh-dot.warm { background: var(--ink-soft); }
  .fresh-dot.ok   { background: var(--taupe); }

  .sit-card-title { font-size: 14px; font-weight: 500; line-height: 1.35; color: var(--ink); }
  .sit-card-sit   { font-size: 13px; color: var(--taupe); line-height: 1.6; }
  .sit-card-tags  { display: flex; gap: 6px; flex-wrap: wrap; }
  .sit-tag {
    font-family: var(--font-mono); font-size: 10px; padding: 2px 7px;
    border: 0.5px solid var(--line); color: var(--taupe);
  }
  .sit-card-articles { font-size: 12px; color: var(--mute); }

  .sit-panel { display: none; margin-top: 8px; border-top: 0.5px solid var(--line); padding-top: 16px; }
  .sit-card.open .sit-panel { display: block; }

  .panel-section { margin-bottom: 20px; }
  .panel-section-title {
    font-family: var(--font-mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--mute);
    margin-bottom: 12px;
  }
  .steps-list { display: flex; flex-direction: column; gap: 10px; }
  .step-item  { display: flex; gap: 12px; align-items: flex-start; }
  .step-num {
    width: 22px; height: 22px; border-radius: 2px;
    background: var(--ink); color: var(--bg);
    font-size: 11px; font-weight: 500;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; margin-top: 1px;
    font-family: var(--font-mono);
  }
  .step-num.immediate { background: var(--moutarde); color: var(--on-accent); }
  .step-num.high      { background: var(--ink-soft); }

  .step-content   { flex: 1; }
  .step-action    { font-size: 13px; line-height: 1.55; margin-bottom: 4px; color: var(--ink); }
  .step-meta      { display: flex; gap: 10px; flex-wrap: wrap; }
  .step-delai     { font-family: var(--font-mono); font-size: 10px; color: var(--mute); }
  .step-loi       { font-family: var(--font-mono); font-size: 10px; color: var(--taupe); }

  .docs-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .docs-list li {
    font-size: 13px; color: var(--taupe); padding-left: 14px; position: relative;
  }
  .docs-list li::before { content: '\2192'; position: absolute; left: 0; font-size: 11px; color: var(--mute); }

  .loi-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .loi-chip  {
    font-family: var(--font-mono); font-size: 10px; padding: 3px 8px;
    background: var(--bg-side); color: var(--taupe); border: 0.5px solid var(--line);
  }

  .sit-article-item { padding: 8px 10px; background: var(--bg-side); margin-bottom: 6px; }
  .sit-article-link { font-size: 13px; color: var(--ink); text-decoration: none; font-weight: 500; }
  .sit-article-link:hover { color: var(--taupe); }
  .sit-article-meta { font-size: 11px; color: var(--mute); margin-top: 2px; }

  .notes-box {
    background: var(--bg-side); padding: 12px;
    font-size: 12px; color: var(--taupe); line-height: 1.7;
    border: 0.5px solid var(--line);
  }
</style>

<script>
  import { api } from '../scripts/api';

  let all: any[] = [];
  let filters: any = { profile: '', urgency: '' };
  let openId: string | null = null;
  const URGENCY: any = { immediate: 'Urgence immédiate', high: 'Priorité haute', medium: 'Priorité normale', low: 'Pour information' };

  async function load(): Promise<void> {
    try {
      const d: any = await api('/api/v1/situations');
      all = d.situations || [];
      render();
    } catch (e: any) {
      document.getElementById('grid')!.innerHTML = '<div class="sit-loading">Erreur de chargement.</div>';
    }
  }

  function getFiltered(): any[] {
    return all.filter((s: any) => {
      const p: boolean = !filters.profile || (s.profile_tags || []).includes(filters.profile);
      const u: boolean = !filters.urgency || s.urgency === filters.urgency;
      return p && u;
    });
  }

  function render(): void {
    const items: any[] = getFiltered();
    const grid: HTMLElement = document.getElementById('grid')!;
    if (!items.length) { grid.innerHTML = '<div class="sit-loading">Aucune fiche pour ces filtres.</div>'; return; }
    grid.innerHTML = items.map((s: any) => renderCard(s)).join('');
    bindCardClicks();
  }

  function freshLabel(s: any): string {
    if (s.freshness === 'hot') return `<span class="fresh-dot hot"></span>${s.articles_count_7d} article${s.articles_count_7d > 1 ? 's' : ''} récent${s.articles_count_7d > 1 ? 's' : ''}`;
    if (s.freshness === 'warm') return `<span class="fresh-dot warm"></span>${s.articles_count_30d} article${s.articles_count_30d > 1 ? 's' : ''} ce mois`;
    return `<span class="fresh-dot ok"></span>À jour`;
  }

  function renderCard(s: any): string {
    const isOpen: boolean = openId === s.reference;
    return `
    <div class="sit-card ${isOpen ? 'open' : ''}" id="card-${s.reference}" data-card-ref="${s.reference}">
      <div class="sit-card-top">
        <span class="sit-card-ref">${s.reference}</span>
        <span class="urgency-badge ${s.urgency}">${URGENCY[s.urgency] || s.urgency}</span>
      </div>
      <div class="sit-card-title">${s.title}</div>
      <div class="sit-card-sit">${s.situation}</div>
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;">
        <div class="sit-card-tags">${(s.profile_tags || []).map((t: string) => `<span class="sit-tag">${t}</span>`).join('')}</div>
        <div class="sit-card-articles">${freshLabel(s)}</div>
      </div>
      <div class="sit-panel" id="panel-${s.reference}">
        <div class="sit-loading" style="padding:20px 0;font-size:13px;">Chargement...</div>
      </div>
    </div>`;
  }

  function bindCardClicks(): void {
    document.querySelectorAll('[data-card-ref]').forEach((card: any) => {
      card.addEventListener('click', () => {
        toggle(card.dataset.cardRef);
      });
    });
  }

  async function toggle(ref: string): Promise<void> {
    if (openId === ref) { openId = null; render(); return; }
    openId = ref;
    render();
    const panel: any = document.getElementById(`panel-${ref}`);
    if (panel.dataset.loaded) return;
    try {
      const d: any = await api(`/api/v1/situations/${ref}`);
      panel.innerHTML = buildPanel(d);
      panel.dataset.loaded = '1';
    } catch (e: any) {
      panel.innerHTML = '<div style="color:var(--mute);font-size:13px;">Erreur de chargement.</div>';
    }
  }

  function buildPanel(d: any): string {
    const urgClass: string = d.urgency === 'immediate' ? 'immediate' : d.urgency === 'high' ? 'high' : '';
    const steps: string = (d.steps || []).map((s: any) => `
      <div class="step-item">
        <div class="step-num ${urgClass}">${s.order}</div>
        <div class="step-content">
          <div class="step-action">${s.action}</div>
          <div class="step-meta">
            ${s.delai ? `<span class="step-delai">${s.delai}</span>` : ''}
            ${s.base_legale ? `<span class="step-loi">${s.base_legale}</span>` : ''}
          </div>
        </div>
      </div>`).join('');

    const docs: string = (d.documents_requis || []).length
      ? `<div class="panel-section">
          <div class="panel-section-title">Documents à conserver</div>
          <ul class="docs-list">${d.documents_requis.map((doc: string) => `<li>${doc}</li>`).join('')}</ul>
        </div>` : '';

    const lois: string = (d.base_legale || []).length
      ? `<div class="panel-section">
          <div class="panel-section-title">Base légale</div>
          <div class="loi-chips">${d.base_legale.map((l: string) => `<span class="loi-chip">${l}</span>`).join('')}</div>
        </div>` : '';

    const articles: string = (d.articles || []).length
      ? `<div class="panel-section">
          <div class="panel-section-title">Articles réglementaires récents liés</div>
          ${d.articles.map((a: any) => `
          <div class="sit-article-item">
            <a href="${a.url}" target="_blank" class="sit-article-link">${a.title}</a>
            <div class="sit-article-meta">${a.source || ''}${a.published_at ? ' \u00b7 ' + new Date(a.published_at).toLocaleDateString('fr-FR') : ''} ${(a.common_themes || []).map((t: string) => `<span style="font-size:10px;background:var(--bg-hover);color:var(--taupe);padding:1px 5px;margin-left:4px;border:0.5px solid var(--line);">${t}</span>`).join('')}</div>
          </div>`).join('')}
        </div>` : '';

    const notes: string = d.notes
      ? `<div class="panel-section"><div class="notes-box">${d.notes}</div></div>`
      : '';

    return `
      <div class="panel-section">
        <div class="panel-section-title">Étapes à suivre</div>
        <div class="steps-list">${steps}</div>
      </div>
      ${docs}${lois}${articles}${notes}`;
  }

  // Filters
  document.querySelectorAll('.fbtn').forEach((btn: any) => {
    btn.addEventListener('click', () => {
      const f: string = btn.dataset.f;
      document.querySelectorAll(`[data-f="${f}"]`).forEach((b: any) => b.classList.remove('active'));
      btn.classList.add('active');
      filters[f] = btn.dataset.v;
      openId = null;
      render();
    });
  });

  load();
</script>
