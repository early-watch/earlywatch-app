      <div class="st-section">
        <div class="st-section-header">Modules actifs</div>
        <div class="st-section-body">
          <div class="toggle-row">
            <div><div class="toggle-label">Procédures LCB-FT</div><div class="toggle-desc">${counts.procedures_count || 0} procédures attribuées</div></div>
            <label class="toggle"><input type="checkbox" id="f-mod-procs" ${s.procedures_enabled ? 'checked' : ''}><span class="toggle-slider"></span></label>
          </div>
          <div class="toggle-row">
            <div><div class="toggle-label">Pays à risque</div><div class="toggle-desc">Liste FATF / EU / ACPR avec croisement veille</div></div>
            <label class="toggle"><input type="checkbox" id="f-mod-country" ${s.country_risk_enabled !== false ? 'checked' : ''}><span class="toggle-slider"></span></label>
          </div>
          <div class="toggle-row">
            <div><div class="toggle-label">Roadmap réglementaire</div><div class="toggle-desc">Échéances DORA, AMLR, AI Act</div></div>
            <label class="toggle"><input type="checkbox" id="f-mod-roadmap" ${s.roadmap_enabled !== false ? 'checked' : ''}><span class="toggle-slider"></span></label>
          </div>
          <div class="toggle-row">
            <div><div class="toggle-label">Fiches réflexes</div><div class="toggle-desc">Guides opérationnels par situation</div></div>
            <label class="toggle"><input type="checkbox" id="f-mod-situations" ${s.situations_enabled !== false ? 'checked' : ''}><span class="toggle-slider"></span></label>
          </div>
