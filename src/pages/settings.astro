                  <option value="autre" ${outils.kyc === 'autre' ? 'selected' : ''}>Autre</option>
                  <option value="Manuel" ${outils.kyc === 'Manuel' ? 'selected' : ''}>Manuel</option>
                </select>
              </div>
              <div class="st-form-group" id="kyc-autre-group" style="${outils.kyc === 'autre' ? '' : 'display:none'}">
                <label>Préciser</label>
