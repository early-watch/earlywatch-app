        <div class="st-section-header">Utilisateurs (${users.length})</div>
        <div class="st-section-body">
          <table class="users-table">
            <thead><tr><th>Nom</th><th>Email</th><th>Rôle</th><th>Dernière connexion</th><th>Statut</th></tr></thead>
            <tbody>${usersRows || '<tr><td colspan="5" style="color:var(--mute);padding:12px 0">Aucun utilisateur</td></tr>'}</tbody>
          </table>
        </div>
