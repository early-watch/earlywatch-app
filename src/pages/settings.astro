            <div class="st-form-group" style="margin-bottom:12px">
              <label>Monitoring transactionnel *</label>
              <div class="wiz-radios" id="wiz-monitoring-radios">
                <label class="wiz-radio ${(outils.monitoring || 'interne') === 'interne' ? 'selected' : ''}"><input type="radio" name="wiz-monitoring" value="interne" ${(outils.monitoring || 'interne') === 'interne' ? 'checked' : ''}> Interne (pas d'outil dédié)</label>
