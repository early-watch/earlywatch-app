---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Paramètres — Early Watch" activePage="settings">
  <div style="max-width:900px;margin:0 auto;">
    <div class="st-page-title">Paramètres</div>
    <div class="st-page-sub">Profil d'assujetti, préférences d'alertes et utilisateurs</div>

    <div id="content">
      <div class="st-loading">Chargement des paramètres...</div>
    </div>

    <div class="save-bar" id="save-bar">
      <button class="ew-btn ew-btn-primary" id="btn-save">Enregistrer les modifications</button>
    </div>
  </div>
</AppLayout>

<style>
  .st-page-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 4px; }
  .st-page-sub   { font-size: 13px; color: var(--mute); margin-bottom: 28px; }

  .save-bar {
    position: sticky; bottom: 0; padding: 16px 0;
    background: var(--bg); border-top: 0.5px solid var(--line);
    text-align: right; display: none;
  }
  :global(.save-bar.visible) { display: block; }
  .st-loading { padding: 40px; text-align: center; color: var(--mute); font-size: 13px; }
</style>

<style is:global>
  .st-section {
    background: var(--bg); border: 0.5px solid var(--line);
    margin-bottom: 20px; overflow: hidden;
  }
  .st-section-header {
    padding: 14px 20px; font-size: 13px; font-weight: 500; color: var(--ink);
    border-bottom: 0.5px solid var(--line);
    display: flex; justify-content: space-between; align-items: center;
  }
  .st-section-body { padding: 20px; }

  .st-form-row   { display: flex; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }
  .st-form-group { flex: 1; min-width: 200px; }
  .st-form-group label {
    display: block; font-size: 12px; font-weight: 500;
    color: var(--taupe); margin-bottom: 5px;
  }
  .st-form-group input,
  .st-form-group select {
    width: 100%; padding: 8px 12px;
    border: 0.5px solid var(--line-strong);
    font-size: 13px; font-family: inherit;
    background: var(--bg); color: var(--ink); outline: none;
    transition: border-color 0.15s;
  }
  .st-form-group input:focus,
  .st-form-group select:focus { border-color: var(--ink); }
  .st-form-group input:disabled,
  .st-form-group select:disabled { opacity: 0.5; cursor: not-allowed; }

  .toggle-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 0; border-bottom: 0.5px solid var(--line);
  }
  .toggle-row:last-child { border-bottom: none; }
  .toggle-label { font-size: 13px; color: var(--ink); }
  .toggle-desc  { font-size: 11.5px; color: var(--mute); margin-top: 1px; }
  .toggle       { position: relative; width: 40px; height: 22px; cursor: pointer; }
  .toggle input { opacity: 0; width: 0; height: 0; }
  .toggle-slider {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: var(--ghost); border-radius: 11px; transition: 0.2s;
  }
  .toggle-slider::before {
    content: ''; position: absolute; height: 16px; width: 16px;
    left: 2px; bottom: 2px; background: var(--bg); border-radius: 50%;
    transition: 0.2s;
  }
  .toggle input:checked + .toggle-slider { background: var(--moutarde); }
  .toggle input:checked + .toggle-slider::before { transform: translateX(18px); }

  .st-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
  .st-chip {
    padding: 4px 12px; border: 0.5px solid var(--line-strong);
    font-size: 12px; cursor: pointer; font-family: inherit;
    background: transparent; color: var(--taupe); transition: all 0.12s;
  }
  .st-chip:hover { background: var(--bg-side); color: var(--ink); }
  .st-chip.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }

  .users-table { width: 100%; font-size: 13px; }
  .users-table th {
    text-align: left; font-family: var(--font-mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); padding: 6px 0;
    border-bottom: 0.5px solid var(--line-strong);
  }
  .users-table td { padding: 8px 0; border-bottom: 0.5px solid var(--line); color: var(--ink); }
  .role-badge { font-family: var(--font-mono); font-size: 10px; padding: 2px 7px; border: 0.5px solid var(--line); }
  .role-admin { color: var(--moutarde); border-color: var(--moutarde); }
  .role-user  { color: var(--taupe); }
  .role-compliance_officer { color: var(--taupe); }

  .st-plan-badge { padding: 2px 8px; font-family: var(--font-mono); font-size: 10px; font-weight: 400; border: 0.5px solid var(--line); }
  .st-plan-demo    { color: var(--mute); }
  .st-plan-starter { color: var(--ink-soft); border-color: var(--ink-soft); }
  .st-plan-pro     { color: var(--moutarde); border-color: var(--moutarde); }

  /* Stepper wizard */
  .wiz-progress { display: flex; align-items: center; gap: 0; margin-bottom: 40px; }
  .wiz-dot {
    width: 26px; height: 26px; border-radius: 50%;
    border: 0.5px solid var(--line-strong);
    background: var(--bg); font-family: var(--font-mono); font-size: 11px; font-weight: 400;
    color: var(--mute); display: grid; place-items: center; cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .wiz-dot.active { background: var(--moutarde); color: var(--ink); border-color: var(--moutarde); font-weight: 500; }
  .wiz-dot.done   { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .wiz-line { flex: 1; height: 0.5px; background: var(--line); margin: 0 14px; }
  .wiz-line.done { background: var(--ink); }
  .wiz-step-label { font-size: 12.5px; color: var(--taupe); margin-bottom: 16px; }
  .wiz-step { min-height: 120px; }

  /* Wizard radios */
  .wiz-radios { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
  .wiz-radio {
    padding: 8px 16px; border: 0.5px solid var(--line-strong);
    font-size: 13px; cursor: pointer; transition: all 0.12s;
    background: transparent; color: var(--taupe); font-family: inherit;
  }
  .wiz-radio input { display: none; }
  .wiz-radio.selected { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .wiz-radio:hover:not(.selected) { border-color: var(--line-strong); background: var(--bg-side); }

  /* Wizard navigation */
  .wiz-nav { display: flex; gap: 12px; margin-top: 20px; padding-top: 16px; border-top: 0.5px solid var(--line); }
  .wiz-btn {
    padding: 7px 20px; font-size: 12.5px; font-weight: 500;
    cursor: pointer; font-family: inherit; border: 0.5px solid var(--line-strong);
    transition: background 0.12s;
  }
  .wiz-btn-prev { background: transparent; color: var(--taupe); }
  .wiz-btn-prev:hover { background: var(--bg-side); }
  .wiz-btn-next { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .wiz-btn-next:hover { background: var(--ink-soft); border-color: var(--ink-soft); }
  .wiz-btn-save { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .wiz-btn-save:hover { background: var(--ink-soft); border-color: var(--ink-soft); }

  /* Services fournis */
  .svc-group-title {
    font-family: var(--font-mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute);
    margin: 12px 0 8px; padding-bottom: 4px; border-bottom: 0.5px solid var(--line);
  }
  .svc-check {
    display: flex; align-items: center; gap: 8px; padding: 6px 0;
    font-size: 13px; color: var(--ink); cursor: pointer;
  }
  .svc-check input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--moutarde); cursor: pointer; }
  .svc-check.disabled { opacity: 0.4; cursor: not-allowed; }
  .svc-check.disabled input { cursor: not-allowed; }
  .svc-legal-ref { font-family: var(--font-mono); font-size: 10px; color: var(--mute); margin-top: 8px; }
  .svc-separator { margin: 14px 0 6px; padding-top: 10px; border-top: 0.5px dashed var(--line); }
</style>

<script>
  import { api, toast } from '../scripts/api';
  import { planLabel, isPaidPlan } from '../scripts/plans';
  import { bootstrapAuth } from '../scripts/bootstrap-auth';

  let settingsData: any = {};
  let hasChanges: boolean = false;

  const ENTITY_TYPES: any[] = [
    { value: 'EC',    label: 'Établissement de crédit' },
    { value: 'PSP',   label: 'Prestataire de services de paiement' },
    { value: 'EME',   label: 'Établissement de monnaie électronique' },
    { value: 'SGP',   label: 'Société de gestion de portefeuille' },
    { value: 'CASP',  label: 'Prestataire de services sur actifs numériques' },
    { value: 'CIF',   label: 'Conseiller en investissement financier' },
    { value: 'IFP',   label: 'Intermédiaire en financement participatif' },
    { value: 'OTHER', label: 'Autre' },
  ];

  // ═══ Services fournis — listes CMF par type d'entité ═══
  const PSP_SERVICES: any[] = [
    { code: 'psp_versement_retrait', label: 'Versement / retrait d\'espèces sur compte de paiement' },
    { code: 'psp_prelevement',       label: 'Prélèvement' },
    { code: 'psp_paiement_carte',    label: 'Paiement par carte' },
    { code: 'psp_virement',          label: 'Virement' },
    { code: 'psp_emission_instrument',label: 'Émission d\'instrument de paiement' },
    { code: 'psp_acquisition',       label: 'Acquisition d\'opérations de paiement' },
    { code: 'psp_transmission_fonds',label: 'Transmission de fonds' },
    { code: 'psp_initiation',        label: 'Initiation de paiement (DSP2)' },
    { code: 'psp_information_comptes',label: 'Information sur les comptes (DSP2)' },
  ];
  const CASP_OBLIGATOIRE: any[] = [
    { code: 'casp_conservation', label: 'Conservation pour compte de tiers d\'actifs numériques' },
    { code: 'casp_achat_vente',  label: 'Achat / vente d\'actifs numériques contre monnaie légale' },
    { code: 'casp_echange',      label: 'Échange d\'actifs numériques contre d\'autres actifs numériques' },
    { code: 'casp_plateforme',   label: 'Exploitation d\'une plateforme de négociation' },
  ];
  const CASP_AGREMENT: any[] = [
    { code: 'casp_rto',                label: 'Réception et transmission d\'ordres pour compte de tiers' },
    { code: 'casp_gestion_portefeuille',label: 'Gestion de portefeuille d\'actifs numériques pour compte de tiers' },
    { code: 'casp_conseil',            label: 'Conseil aux souscripteurs d\'actifs numériques' },
    { code: 'casp_prise_ferme',        label: 'Prise ferme / placement garanti / placement non garanti' },
  ];

  const REG_PRESELECTION: any = {
    PSP: ['LCB-FT', 'DSP2', 'DORA'],
    EME: ['LCB-FT', 'DSP2', 'DORA'],
    Banque: ['LCB-FT', 'DORA', 'AMLR'],
    CASP: ['LCB-FT', 'MiCA', 'AMLR'],
  };

  function renderServicesSection(entityType: string, currentServices: string[]): string {
    if (!entityType) return '';
    let html = '<label style="display:block;font-size:12px;font-weight:500;color:var(--ink);margin-bottom:4px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em">Services fournis</label>';

    if (entityType === 'Banque') {
      const creditChecked = currentServices.includes('banque_credit') || !currentServices.length;
      const corrChecked   = currentServices.includes('banque_correspondance');
      html += `
        <div class="toggle-row" style="margin:4px 0">
          <div><div class="toggle-label">Activité de crédit</div></div>
          <label class="toggle"><input type="checkbox" class="svc-banque-toggle" data-svc="banque_credit" ${creditChecked ? 'checked' : ''}><span class="toggle-slider"></span></label>
        </div>
        <div class="toggle-row" style="margin:4px 0">
          <div><div class="toggle-label">Correspondance bancaire</div></div>
          <label class="toggle"><input type="checkbox" class="svc-banque-toggle" data-svc="banque_correspondance" ${corrChecked ? 'checked' : ''}><span class="toggle-slider"></span></label>
        </div>
        <div class="svc-legal-ref">Les opérations de banque sont présumées pour tout établissement de crédit agréé — Article L.311-1 CMF</div>
      `;
      return html;
    }

    if (entityType === 'PSP') {
      html += PSP_SERVICES.map(s =>
        `<label class="svc-check"><input type="checkbox" class="svc-cb" data-svc="${s.code}" ${currentServices.includes(s.code) ? 'checked' : ''}> ${s.label}</label>`
      ).join('');
      html += '<div class="svc-legal-ref">Article L.314-1 II CMF</div>';
      return html;
    }

    if (entityType === 'EME') {
      html += `<label class="svc-check disabled"><input type="checkbox" class="svc-cb" data-svc="eme_emission_gestion" checked disabled> Émission et gestion de monnaie électronique</label>`;
      html += '<hr style="margin:8px 0;border:none;border-top:0.5px solid var(--line)">';
      html += PSP_SERVICES.map(s =>
        `<label class="svc-check"><input type="checkbox" class="svc-cb" data-svc="${s.code}" ${currentServices.includes(s.code) ? 'checked' : ''}> ${s.label}</label>`
      ).join('');
      html += '<div class="svc-legal-ref">Articles L.315-1 et L.526-1 CMF</div>';
      return html;
    }

    if (entityType === 'CASP') {
      html += '<div class="svc-group-title">Services nécessitant un enregistrement obligatoire (1° à 4°)</div>';
      html += CASP_OBLIGATOIRE.map(s =>
        `<label class="svc-check"><input type="checkbox" class="svc-cb" data-svc="${s.code}" ${currentServices.includes(s.code) ? 'checked' : ''}> ${s.label}</label>`
      ).join('');
      html += '<div class="svc-separator"></div>';
      html += '<div class="svc-group-title">Services nécessitant un agrément optionnel (5°)</div>';
      html += CASP_AGREMENT.map(s =>
        `<label class="svc-check"><input type="checkbox" class="svc-cb" data-svc="${s.code}" ${currentServices.includes(s.code) ? 'checked' : ''}> ${s.label}</label>`
      ).join('');
      html += '<div class="svc-legal-ref">Article L.54-10-2 CMF</div>';
      return html;
    }

    return '';
  }

  const ALL_REGULATIONS: string[] = ['LCB-FT', 'DORA', 'DSP2', 'MiCA', 'AI Act', 'AMLR', 'PSD3', 'RGPD'];
  const SEVERITIES: string[] = ['critical', 'high', 'medium', 'low'];
  const SEV_LABELS: any = { critical: 'Critique', high: 'Élevé', medium: 'Moyen', low: 'Faible' };

  async function loadSettings(): Promise<void> {
    try {
      const data: any = await api('/api/v1/settings');
      settingsData = data;
      renderSettings(data);
    } catch (e: any) {
      document.getElementById('content')!.innerHTML = `<div class="st-loading">Erreur : ${e.message}</div>`;
    }
  }

  function renderSettings(data: any): void {
    const t: any = data.tenant || {};
    const s: any = data.settings || {};
    const p: any = data.profile || {};
    const users: any[] = data.users || [];
    const counts: any = data.counts || {};

    const entityOpts: string = ENTITY_TYPES.map((et: any) =>
      `<option value="${et.value}" ${et.value === (s.entity_type || '') ? 'selected' : ''}>${et.label}</option>`
    ).join('');

    const regChips: string = ALL_REGULATIONS.map((r: string) => {
      const active: string = (s.regulations || []).includes(r) ? 'active' : '';
      return `<button class="st-chip ${active}" data-reg="${r}">${r}</button>`;
    }).join('');

    const sevChips: string = SEVERITIES.map((sv: string) => {
      const active: string = (s.alert_severities || ['critical', 'high']).includes(sv) ? 'active' : '';
      return `<button class="st-chip ${active}" data-sev="${sv}">${SEV_LABELS[sv]}</button>`;
    }).join('');

    // Organisation profile data — v2 keys (with v1 fallbacks)
    const profil_v2: any = s.profil || {};
    const conf: any = s.conformite || {};
    const outils: any = s.outils || {};
    const perim: any = s.perimetre || {};
    const org: any = s.organisation || {};
    const resolvedEntityType: string = profil_v2.entity_type || s.entity_type || '';
    const resolvedNom: string = profil_v2.nom_etablissement || org.nom_etablissement || t.name || '';

    const CLIENT_TYPES: string[] = ['Particuliers', 'Entreprises', 'Institutionnels'];
    const GEO_ZONES: string[] = ['France uniquement', 'Union européenne', 'International'];

    const clientChips: string = CLIENT_TYPES.map((ct: string) => {
      const active: string = (perim.types_clients || []).includes(ct) ? 'active' : '';
      return `<button class="st-chip ${active}" data-client="${ct}">${ct}</button>`;
    }).join('');

    const zoneChips: string = GEO_ZONES.map((z: string) => {
      const active: string = (perim.zones_geographiques || []).includes(z) ? 'active' : '';
      return `<button class="st-chip ${active}" data-zone="${z}">${z}</button>`;
    }).join('');

    const planCls: string = t.plan === 'pro' || isPaidPlan(t.plan) ? 'st-plan-pro' : t.plan === 'starter' ? 'st-plan-starter' : 'st-plan-demo';

    const usersRows: string = users.map((u: any) => {
      const roleCls: string = u.role === 'admin' ? 'role-admin' : u.role === 'compliance_officer' ? 'role-compliance_officer' : 'role-user';
      const lastLogin: string = u.last_login_at ? new Date(u.last_login_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Jamais';
      return `<tr>
        <td>${u.first_name || ''} ${u.last_name || ''}</td>
        <td>${u.email}</td>
        <td><span class="role-badge ${roleCls}">${u.role}</span></td>
        <td>${lastLogin}</td>
        <td>${u.is_active ? 'Actif' : 'Inactif'}</td>
      </tr>`;
    }).join('');

    document.getElementById('content')!.innerHTML = `
      <div class="st-section">
        <div class="st-section-header">
          Profil d'assujetti
          <span class="st-plan-badge ${planCls}">${planLabel(t.plan)}</span>
        </div>
        <div class="st-section-body">
          <div class="st-form-row">
            <div class="st-form-group">
              <label>Nom de l'établissement</label>
              <input type="text" id="f-name" value="${t.name || ''}">
            </div>
            <div class="st-form-group">
              <label>Type d'entité</label>
              <select id="f-entity-type">${entityOpts}</select>
            </div>
          </div>
          <div class="st-form-row">
            <div class="st-form-group">
              <label>N° ACPR / AMF</label>
              <input type="text" id="f-acpr" value="${s.acpr_number || ''}" placeholder="Ex: 12345">
            </div>
          </div>
          <div class="st-form-group">
            <label>Réglementations applicables</label>
            <div class="st-chips" id="chips-reg">${regChips}</div>
          </div>
        </div>
      </div>

      <!-- ═══ PROFIL ORGANISATION v2 — Wizard 4 étapes ═══ -->
      <div class="st-section" id="wizard-org">
        <div class="st-section-header">Profil organisation</div>
        <div class="st-section-body">
          <!-- Progress bar -->
          <div class="wiz-progress">
            <button class="wiz-dot active" data-wstep="1">1</button>
            <div class="wiz-line"></div>
            <button class="wiz-dot" data-wstep="2">2</button>
            <div class="wiz-line"></div>
            <button class="wiz-dot" data-wstep="3">3</button>
            <div class="wiz-line"></div>
            <button class="wiz-dot" data-wstep="4">4</button>
          </div>
          <div class="wiz-step-label" id="wiz-step-label">Étape 1 — Établissement</div>

          <!-- Step 1: Etablissement -->
          <div class="wiz-step" id="wiz-step-1">
            <div class="st-form-group" style="margin-bottom:16px">
              <label>Nom de l'établissement *</label>
              <input type="text" id="f-profil-nom" value="${resolvedNom}" required>
            </div>
            <div class="st-form-group">
              <label>Type d'entité *</label>
              <div class="wiz-radios" id="wiz-entity-radios">
                <label class="wiz-radio ${resolvedEntityType === 'PSP' ? 'selected' : ''}"><input type="radio" name="wiz-entity" value="PSP" ${resolvedEntityType === 'PSP' ? 'checked' : ''}> PSP</label>
                <label class="wiz-radio ${resolvedEntityType === 'Banque' || resolvedEntityType === 'EC' ? 'selected' : ''}"><input type="radio" name="wiz-entity" value="Banque" ${resolvedEntityType === 'Banque' || resolvedEntityType === 'EC' ? 'checked' : ''}> Banque</label>
                <label class="wiz-radio ${resolvedEntityType === 'CASP' ? 'selected' : ''}"><input type="radio" name="wiz-entity" value="CASP" ${resolvedEntityType === 'CASP' ? 'checked' : ''}> CASP</label>
                <label class="wiz-radio ${resolvedEntityType === 'EME' ? 'selected' : ''}"><input type="radio" name="wiz-entity" value="EME" ${resolvedEntityType === 'EME' ? 'checked' : ''}> EME</label>
              </div>
            </div>
            <div id="services-section" style="margin-top:16px;${resolvedEntityType ? '' : 'display:none'}">
              <div id="services-content"></div>
            </div>
          </div>

          <!-- Step 2: Equipe conformite -->
          <div class="wiz-step" id="wiz-step-2" style="display:none">
            <div class="st-form-row">
              <div class="st-form-group"><label>Responsable LCB-FT — Nom *</label><input type="text" id="f-conf-lcbft-nom" value="${conf.responsable_lcbft_nom || ''}"></div>
              <div class="st-form-group"><label>Responsable LCB-FT — Fonction *</label><input type="text" id="f-conf-lcbft-fn" value="${conf.responsable_lcbft_fonction || ''}"></div>
            </div>
            <div class="st-form-row">
              <div class="st-form-group"><label>Suppléant — Nom</label><input type="text" id="f-conf-suppleant" value="${conf.responsable_lcbft_suppleant || ''}"></div>
            </div>
            <div class="toggle-row" style="margin:12px 0">
              <div><div class="toggle-label">Le déclarant Tracfin est le responsable LCB-FT</div></div>
              <label class="toggle"><input type="checkbox" id="f-conf-declarant-est-resp" ${conf.declarant_est_responsable ? 'checked' : ''}><span class="toggle-slider"></span></label>
            </div>
            <div id="declarant-fields" style="${conf.declarant_est_responsable ? 'display:none' : ''}">
              <div class="st-form-row">
                <div class="st-form-group"><label>Déclarant Tracfin — Nom *</label><input type="text" id="f-conf-tracfin-nom" value="${conf.declarant_tracfin_nom || ''}"></div>
                <div class="st-form-group"><label>Déclarant Tracfin — Fonction *</label><input type="text" id="f-conf-tracfin-fn" value="${conf.declarant_tracfin_fonction || ''}"></div>
