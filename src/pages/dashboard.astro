---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Early Watch — Inbox" activePage="dashboard" layout="3col">

  <!-- ── Col 2 : header + tabs + liste articles ── -->
  <div class="ew-header">
    <h1 class="ew-h-title">Inbox</h1>
    <div class="ew-h-date" id="ew-today"></div>
    <!-- Sélecteur vue client — visible uniquement pour superadmin -->
    <button
      id="btn-demo-client"
      style="display:none;font-size:11px;font-family:var(--font-mono);letter-spacing:0.08em;color:var(--taupe);background:none;border:0.5px solid var(--line-strong);border-radius:var(--radius);padding:5px 12px;cursor:pointer;transition:color 0.12s,border-color 0.12s"
      title="Basculer vers la vue client Demo PSP"
    >
      Voir comme client Demo PSP →
    </button>
  </div>
  <div id="article-list">
    <div class="ew-loading"><div class="ew-spinner"></div></div>
  </div>

  <!-- ── Col 3 : panel droit ── -->
  <aside slot="right" class="ew-right" id="sidebar-right">
    <!-- Section digest/stats (vue par défaut) -->
    <div id="panel-digest">
      <div class="ew-loading"><div class="ew-spinner"></div></div>
    </div>
    <!-- Section article detail (ouverte au clic sur une carte) -->
    <div id="panel-article" style="display:none"></div>
  </aside>

</AppLayout>

<!-- ── Aperçu Newsletter overlay ── -->
<div id="apercu-overlay" style="display:none;position:fixed;inset:0;background:rgba(26,24,20,0.45);z-index:200;align-items:center;justify-content:center">
  <div id="apercu-panel" style="background:var(--bg);border:0.5px solid var(--line-strong);border-radius:8px;width:680px;max-width:92vw;max-height:85vh;display:flex;flex-direction:column">
    <div style="padding:18px 22px 14px;border-bottom:0.5px solid var(--line);display:flex;justify-content:space-between;align-items:center">
      <div>
        <div id="apercu-title" style="font-size:14px;font-weight:500;color:var(--ink)">Aperçu Hebdo</div>
        <div style="font-size:12px;color:var(--taupe);margin-top:2px">Glissez pour réordonner les articles</div>
      </div>
      <button id="apercu-close" style="background:none;border:none;font-size:20px;color:var(--taupe);cursor:pointer;padding:4px;line-height:1">&times;</button>
    </div>
    <div id="apercu-list" style="flex:1;overflow-y:auto;padding:14px 22px"></div>
    <div style="padding:14px 22px;border-top:0.5px solid var(--line);display:flex;gap:10px;justify-content:flex-end">
      <button id="apercu-cancel" class="ew-btn">Annuler</button>
      <button id="apercu-export" class="ew-btn ew-btn-primary">Exporter dans cet ordre</button>
    </div>
  </div>
</div>

<!-- ── Modale confirmation clôture ── -->
<div id="cloturer-overlay" style="display:none;position:fixed;inset:0;background:rgba(26,24,20,0.45);z-index:1100;align-items:center;justify-content:center">
  <div id="cloturer-modal" style="background:var(--bg);border:0.5px solid var(--line-strong);border-radius:8px;width:440px;max-width:90vw">
    <div style="padding:20px 24px 16px">
      <div style="font-weight:500;font-size:15px;color:var(--ink);margin-bottom:10px">Clôturer la session</div>
      <p id="cloturer-intro" style="font-size:13px;color:var(--ink-soft);margin:0 0 12px;line-height:1.5"></p>
      <div id="cloturer-list" style="max-height:240px;overflow-y:auto;margin:0 0 4px"></div>
      <p id="cloturer-msg" style="font-size:12px;color:var(--taupe);margin:10px 0 0;line-height:1.4;display:none"></p>
    </div>
    <div style="padding:14px 24px;border-top:0.5px solid var(--line);display:flex;gap:10px;justify-content:flex-end">
      <button id="cloturer-cancel" class="ew-btn">Annuler</button>
      <button id="cloturer-confirm" style="font-size:13px;padding:7px 18px;border:none;background:var(--ink);color:var(--bg);border-radius:6px;cursor:pointer;font-family:var(--font)">Clôturer</button>
    </div>
  </div>
</div>

<!-- ── Tracker drawer ── -->
<div id="tracker-overlay" style="display:none;position:fixed;inset:0;background:rgba(26,24,20,0.35);z-index:1000;justify-content:flex-end">
  <div id="tracker-drawer" style="width:420px;max-width:90vw;height:100vh;background:var(--bg);display:flex;flex-direction:column;animation:ew-slide-in 0.2s ease-out">
    <header style="display:flex;justify-content:space-between;align-items:center;padding:16px 22px;border-bottom:0.5px solid var(--line)">
      <div style="font-size:14px;font-weight:500;color:var(--ink)">Ajouter au Tracker</div>
      <button id="tracker-close" style="background:none;border:none;font-size:20px;color:var(--taupe);cursor:pointer;padding:4px;line-height:1">&times;</button>
    </header>
    <div id="tracker-form" style="flex:1;overflow-y:auto;padding:16px 22px;display:flex;flex-direction:column;gap:14px">
      <div class="ew-field"><label class="ew-label">Source</label><input type="text" id="tracker-source" class="ew-input" /></div>
      <div class="ew-field"><label class="ew-label">Date</label><input type="date" id="tracker-date" class="ew-input" /></div>
      <div class="ew-field"><label class="ew-label">Sujet</label><input type="text" id="tracker-sujet" class="ew-input" /></div>
      <div class="ew-field"><label class="ew-label">Synthèse</label><textarea id="tracker-synthese" class="ew-input ew-textarea" rows="4"></textarea></div>
      <div class="ew-field"><label class="ew-label">Type</label>
        <select id="tracker-type" class="ew-input">
          <option value="TEXTE">TEXTE</option>
          <option value="DECISION">DECISION</option>
          <option value="CONSULTATION">CONSULTATION</option>
        </select>
      </div>
      <div class="ew-field"><label class="ew-label">Lien</label><input type="url" id="tracker-lien" class="ew-input" /></div>
      <div class="ew-field"><label class="ew-label">Statut</label><input type="text" id="tracker-statut" class="ew-input" value="Publié" /></div>
    </div>
    <footer style="padding:14px 22px;border-top:0.5px solid var(--line);display:flex;gap:8px;justify-content:flex-end">
      <button id="tracker-cancel" class="ew-btn">Annuler</button>
      <button id="tracker-confirm" class="ew-btn ew-btn-primary">Confirmer</button>
    </footer>
  </div>
</div>

<script>
  import { api, formatDate, toast, getUser } from '../scripts/api';
  import { bootstrapAuth } from '../scripts/bootstrap-auth';
  import { sourceAvatarHTML } from '../scripts/sigles.js';
  import { renderEwTab, renderSortDropdown, bindSortDropdown, SORT_LABELS } from '../scripts/article-card.js';

  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';

  // ── Date helpers ─────────────────────────────────────────────────────────

  function sortDate(a: any): number {
    return a.published_at
      ? new Date(a.published_at).getTime()
      : new Date(a.created_at).getTime();
  }

  function displayDate(a: any): string {
    const pub = a.published_at;
    if (pub) {
      const d = new Date(pub);
      const imprecise = d.getUTCDate() === 1 && d.getUTCHours() === 0 && d.getUTCMinutes() === 0;
      if (!imprecise) return formatDate(pub);
      const months = ['janv.','fév.','mars','avr.','mai','juin','juil.','août','sept.','oct.','nov.','déc.'];
      return `${months[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
    }
    if (a.created_at) return formatDate(a.created_at);
    return `<span class="ew-badge ew-badge-error" style="font-size:9px">Date inconnue</span>`
      + `<a href="#" class="fix-date-link" data-fix-date="${a.id}" onclick="event.stopPropagation();event.preventDefault()" style="font-size:10px;color:var(--mute);margin-left:4px;text-decoration:underline">Corriger</a>`;
  }

  function todayFR(): string {
    return new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  }

  // ── Labels ───────────────────────────────────────────────────────────────

  const PROC_LABELS: Record<string, string> = {
    'EB-POL-001': 'Politique générale LCB-FT',
    'EB-RISK-001': 'Classification des risques',
    'EB-KYC-001': 'Entrée en relation — Personne physique',
    'EB-KYC-002': 'Entrée en relation — Personne morale',
    'EB-SCR-001': 'Criblage sanctions et PPE',
    'EB-MON-001': 'Monitoring transactionnel',
    'EB-TRC-001': 'Déclaration de soupçon Tracfin',
    'EB-CASP-001': 'LCB-FT spécifique CASP/PSAN',
    'EB-CTRL-001': 'Contrôle permanent LCB-FT',
    'EB-AGT-001': 'Agents et distributeurs',
    'EB-UBO-001': 'Bénéficiaires effectifs',
    'EB-EDD-001': 'Vigilance renforcée',
    'EB-PEP-001': 'Personnes politiquement exposées',
    'EB-SCR-002': 'Criblage sanctions avancé',
    'EB-GEL-001': 'Gel des avoirs',
    'EB-ARCH-001': 'Archivage',
    'EB-TRV-001': 'Transfert de fonds',
    'EB-CBK-001': 'Correspondance bancaire',
    'EB-FORM-001': 'Formation LCB-FT',
  };
  function procLabel(code: string): string { return PROC_LABELS[code] || code; }

  const IMPACT_LABELS: Record<string, string> = {
    sanction: 'Sanction', nouvelle_regle: 'Nouvelle règle',
    mise_a_jour: 'Mise à jour', appel_vigilance: 'Appel vigilance',
  };
  function impactLabel(t: string): string { return IMPACT_LABELS[t] || t; }

  const LINK_ICON = '<svg width="11" height="11" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;margin-left:4px;vertical-align:middle;color:var(--mute)"><path d="M10 6.5V10a1 1 0 01-1 1H2a1 1 0 01-1-1V3a1 1 0 011-1h3.5M7.5 1H11v3.5M11 1L5 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  // ── State ────────────────────────────────────────────────────────────────

  let articles: any[] = [];
  let activeFilter = 'all';
  let sortMode = 'recent';
  let newsletterCounts: any = null;
  let trackerPendingCount = 0;

  // Panel state
  let selectedArticleId: string | null = null;
  let panelArticle: any = null;          // article currently loaded in panel (full data)
  let hideTraites = false;               // toggle "masquer les traités"
  let visibleArticleIds: string[] = [];  // ordered list for keyboard nav

  // Undo state for ignore/archive (map id → {action, timer})
  const undoPending = new Map<string, {action: string; timer: ReturnType<typeof setTimeout>}>();

  // ── V3 card state ─────────────────────────────────────────────────────────
  // State machine per article card : booléens in_flash/in_hebdo/in_mensuel
  // + origin (direct vs cascade) pour l'affichage visuel à 3 niveaux.
  const cardStates = new Map<string, any>();

  function getState(id: string): any {
    if (!cardStates.has(id)) {
      cardStates.set(id, {
        in_flash:       false,
        in_hebdo:       false,
        in_mensuel:     false,
        hebdo_origin:   'none',   // 'none' | 'direct' | 'cascade'
        mensuel_origin: 'none',
        registre:       null,     // null | 'tracker' | 'autres_pub'
        _treated:       false,    // true après le premier POST /triage réussi dans cette session
        _treating:      false,    // true pendant un POST en vol
      });
    }
    return cardStates.get(id);
  }

  // Cascade Q→H→M selon spec §6.2 :
  // - Activer Q → cascade H et M (si pas déjà actifs)
  // - Désactiver Q → Q s'éteint UNIQUEMENT, H et M restent cochés
  // - Activer H → cascade M (si pas déjà actif)
  // - Désactiver H → H s'éteint UNIQUEMENT, M reste coché
  // - Mensuel : toggle simple
  function toggleField(id: string, field: string): void {
    const s = getState(id);
    if (field === 'flash') {
      if (!s.in_flash) {
        s.in_flash = true;
        if (!s.in_hebdo)   { s.in_hebdo = true;   s.hebdo_origin = 'cascade';   }
        if (!s.in_mensuel) { s.in_mensuel = true;  s.mensuel_origin = 'cascade'; }
      } else {
        s.in_flash = false;
        // Décocher Quotidien laisse Hebdo et Mensuel cochés (pas de rétro-cascade)
      }
    } else if (field === 'hebdo') {
      if (!s.in_hebdo) {
        s.in_hebdo = true; s.hebdo_origin = 'direct';
        if (!s.in_mensuel) { s.in_mensuel = true; s.mensuel_origin = 'cascade'; }
      } else {
        s.in_hebdo = false; s.hebdo_origin = 'none';
        // Décocher Hebdo laisse Mensuel coché
      }
    } else {
      // Mensuel : toggle direct
      s.in_mensuel = !s.in_mensuel;
      s.mensuel_origin = s.in_mensuel ? 'direct' : 'none';
    }
    updateCardDOM(id);
  }

  // Met à jour les classes CSS d'une carte sans re-rendre toute la liste.
  function updateCardDOM(id: string): void {
    const s = getState(id);
    const card = document.querySelector(`[data-article-id="${id}"]`);
    if (card) {
      const flashBtn   = card.querySelector('[data-field="flash"]')             as HTMLElement | null;
      const hebdoBtn   = card.querySelector('[data-field="hebdo"]')             as HTMLElement | null;
      const mensuelBtn = card.querySelector('[data-field="mensuel"]')           as HTMLElement | null;
      const trackerBtn = card.querySelector('[data-registre-val="tracker"]')    as HTMLElement | null;
      const pubBtn     = card.querySelector('[data-registre-val="autres_pub"]') as HTMLElement | null;

      function setCls(el: HTMLElement | null, cls: string): void {
        if (!el) return;
        el.classList.remove('active-direct', 'active-cascade');
        if (cls) el.classList.add(cls);
      }

      setCls(flashBtn,   s.in_flash   ? 'active-direct' : '');
      setCls(hebdoBtn,   !s.in_hebdo   ? '' : s.hebdo_origin   === 'direct' ? 'active-direct' : 'active-cascade');
      setCls(mensuelBtn, !s.in_mensuel ? '' : s.mensuel_origin === 'direct' ? 'active-direct' : 'active-cascade');
      setCls(trackerBtn, s.registre === 'tracker'    ? 'active-direct' : '');
      setCls(pubBtn,     s.registre === 'autres_pub' ? 'active-direct' : '');

      // Mettre à jour l'état "traité" visuellement sur la carte
      const newTreated = s.in_flash || s.in_hebdo || s.in_mensuel;
      const wasTreated = s._treated;
      s._treated = newTreated;
      card.classList.toggle('ew-item--traite', s._treated);

      // Badge ✓ sur le titre
      const badgeEl = card.querySelector('.ew-badge-traite');
      if (s._treated && !badgeEl) {
        card.querySelector('.ew-title')?.insertAdjacentHTML('afterend',
          '<span class="ew-badge-traite">&#10003;</span>');
      } else if (!s._treated && badgeEl) {
        badgeEl.remove();
      }
    }

    // Synchroniser les boutons du panneau si c'est l'article sélectionné
    if (selectedArticleId === id) {
      updatePanelButtons(id);
    }
  }

  function newsletterEnabled(): boolean {
    return !!getUser()?.tenant_newsletter_enabled;
  }

  // ── File de tri vs auto-classés ──────────────────────────────────────────
  // 'inbox' = to_triage mappé par la rétrocompat v2 du backend (_v2_compat) ;
  // on accepte aussi 'to_triage' pour rester correct après le retrait du mapping (PR D).
  function isToTriage(a: any): boolean {
    return a.lifecycle_status === 'inbox' || a.lifecycle_status === 'to_triage';
  }

  // File « À trier » : articles à trier + articles triés à la main dans cette
  // session ('triaged' local après POST /triage) — jamais les auto-classés.
  function isTriageFile(a: any): boolean {
    return !a._auto_tagged && (isToTriage(a) || a.lifecycle_status === 'triaged');
  }

  // Compteur du menu Inbox = to_triage SEUL — même définition que
  // inbox_stats.to_triage_count côté backend (lifecycle_status == 'to_triage'),
  // calculée ici côté client car inbox_stats n'est exposé qu'en MCP, pas en REST.
  function updateInboxBadge(): void {
    const n = articles.filter((a: any) => isToTriage(a)).length;
    sessionStorage.setItem('ew_inbox_count', String(n));
    const el = document.getElementById('nav-count-inbox') as HTMLElement | null;
    if (el) {
      el.textContent = String(n);
      el.style.display = n > 0 ? '' : 'none';
    }
  }

  // ── Init ─────────────────────────────────────────────────────────────────

  async function init(): Promise<void> {
    // Date dans le header
    const todayEl = document.getElementById('ew-today');
    if (todayEl) {
      todayEl.textContent = todayFR();
      todayEl.style.textTransform = 'capitalize';
    }

    try {
      const [articlesData, countsData, trackerData, autoTaggedData]: any[] = await Promise.all([
        api('/api/v1/articles?page_size=200&score_min=11'),
        newsletterEnabled() ? api('/api/v1/articles/newsletter/counts').catch(() => null) : Promise.resolve(null),
        api('/api/v1/tracker/pending-count').catch(() => ({ pending: 0 })),
        // EB-AUTO-001 : articles auto-tagués kept sans flash — fenêtre 48h
        api('/api/v1/articles?lifecycle_status=kept&in_flash=false&page_size=100&score_min=11').catch(() => ({ items: [] })),
      ]);
      const mainArticles = Array.isArray(articlesData) ? articlesData : (articlesData?.items || []);
      newsletterCounts = countsData;
      trackerPendingCount = trackerData?.pending || 0;

      // Filtrer et pré-initialiser les articles auto-tagués des 48 dernières heures
      const autoTaggedRaw = Array.isArray(autoTaggedData) ? autoTaggedData : (autoTaggedData?.items || []);
      const cutoff48h = Date.now() - 48 * 3600 * 1000;
      const autoTagged = autoTaggedRaw.filter(
        (a: any) => a.created_at && new Date(a.created_at).getTime() >= cutoff48h
      );
      autoTagged.forEach((a: any) => {
        a._auto_tagged = true;
        const s = getState(a.id);
        s.in_hebdo    = !!a.in_hebdo;
        s.in_mensuel  = !!a.in_mensuel;
        s.hebdo_origin   = a.in_hebdo   ? 'cascade' : 'none';
        s.mensuel_origin = a.in_mensuel ? 'cascade' : 'none';
      });
      articles = [...mainArticles, ...autoTagged];

      // Expose inbox count pour le badge nav — to_triage seul (pas les auto-classés)
      updateInboxBadge();

    } catch (e: any) {
      document.getElementById('article-list')!.innerHTML =
        `<div class="ew-empty"><div class="ew-empty-title">Erreur de chargement</div><div class="ew-empty-sub">${e.message}</div></div>`;
      return;
    }

    renderTabs();
    renderArticles();
    renderDigestPanel();
  }

  // ── Tabs ─────────────────────────────────────────────────────────────────

  function renderTabs(): void {
    updateInboxBadge();
    // Les onglets ne comptent que la file « À trier » — les auto-classés en sont exclus.
    const visible: any[] = articles.filter((a: any) => isTriageFile(a));
    const cnt: any = { all: visible.length, nouveau: 0, quotidien: 0, hebdo: 0, ignorer: 0 };
    visible.forEach((a: any) => { if (cnt[a.status] !== undefined) cnt[a.status]++; });

    const traitesCount = visible.filter((a: any) => getState(a.id)._treated).length;
    const masquerLabel = hideTraites
      ? `Afficher traités${traitesCount > 0 ? ` (${traitesCount})` : ''}`
      : `Masquer traités${traitesCount > 0 ? ` (${traitesCount})` : ''}`;

    const tabHtml = `
      <div class="ew-tabs" id="ew-tabs">
        ${renderEwTab('all',       'Tous',      cnt.all,      activeFilter)}
        ${renderEwTab('nouveau',   'Nouveaux',  cnt.nouveau,  activeFilter)}
        ${renderEwTab('quotidien', 'Quotidien', cnt.quotidien,activeFilter)}
        ${renderEwTab('hebdo',     'Hebdo',     cnt.hebdo,    activeFilter)}
        ${renderEwTab('ignorer',   'Ignorés',   cnt.ignorer,  activeFilter)}
        ${renderSortDropdown(sortMode)}
        ${traitesCount > 0 ? `<button class="ew-btn-masquer" id="btn-masquer-traites">${masquerLabel}</button>` : ''}
      </div>`;

    const container = document.getElementById('article-list')!;
    const existing = container.querySelector('#ew-tabs');
    if (existing) {
      existing.outerHTML = tabHtml;
    } else {
      container.insertAdjacentHTML('afterbegin', tabHtml);
    }

    container.querySelectorAll('[data-tab]').forEach((el: any) => {
      el.addEventListener('click', () => {
        activeFilter = el.dataset.tab;
        renderTabs();
        renderArticles();
      });
    });

    bindSortDropdown((key: string) => {
      sortMode = key;
      renderTabs();
      renderArticles();
    });

    document.getElementById('btn-masquer-traites')?.addEventListener('click', () => {
      hideTraites = !hideTraites;
      renderTabs();
      renderArticles();
    });
  }

  // ── Articles ─────────────────────────────────────────────────────────────

  function renderArticles(): void {
    // ── File « À trier » : uniquement les articles de la file de tri ──
    let filtered: any[] = articles.filter((a: any) => isTriageFile(a));
    if (activeFilter !== 'all') filtered = filtered.filter((a: any) => a.status === activeFilter);

    // Masquer les articles traités dans cette session si toggle actif
    if (hideTraites) {
      filtered = filtered.filter((a: any) => !getState(a.id)._treated);
    }

    const now = new Date();
    if (sortMode === 'week') {
      const start = new Date(now); start.setDate(now.getDate() - now.getDay() + 1); start.setHours(0,0,0,0);
      filtered = filtered.filter((a: any) => sortDate(a) >= start.getTime());
    } else if (sortMode === '7days') {
      filtered = filtered.filter((a: any) => sortDate(a) >= now.getTime() - 7 * 86400000);
    }

    const byDate = (a: any, b: any) =>
      sortMode === 'oldest' ? sortDate(a) - sortDate(b) : sortDate(b) - sortDate(a);
    filtered.sort(byDate);

    // ── Section « Auto-classés récents » : kept auto-tagués (48h), hors file de tri ──
    const autoList: any[] = articles.filter((a: any) => a._auto_tagged).sort(byDate);

    // Mettre à jour la liste des IDs visibles pour la navigation clavier (tri puis auto)
    visibleArticleIds = [...filtered, ...autoList].map((a: any) => a.id);

    const container = document.getElementById('article-list')!;
    const tabs = container.querySelector('#ew-tabs');

    const aTrierHtml = filtered.length
      ? `<div class="ew-list" id="ew-list">${filtered.map((a: any) => articleCard(a)).join('')}</div>`
      : `<div class="ew-empty">
          <div class="ew-empty-title">Aucun article à trier</div>
          <div class="ew-empty-sub">Modifie le filtre ou reviens plus tard.</div>
          <div class="ew-empty-hint">Dernière ingestion automatique · 4×/jour</div>
        </div>`;

    const autoHtml = autoList.length
      ? `<div class="ew-section-head">
          <span class="ew-section-title">Auto-classés récents</span>
          <span class="ew-section-count">${autoList.length}</span>
          <span class="ew-section-hint">Classés automatiquement à l'ingestion (48 dernières heures)</span>
        </div>
        <div class="ew-list ew-list-auto" id="ew-list-auto">${autoList.map((a: any) => articleCard(a)).join('')}</div>`
      : '';

    container.innerHTML = `
      <div class="ew-section-head">
        <span class="ew-section-title">À trier</span>
        <span class="ew-section-count">${filtered.length}</span>
      </div>
      ${aTrierHtml}
      ${autoHtml}`;
    if (tabs) container.insertAdjacentElement('afterbegin', tabs);

    // ── Bind événements ──────────────────────────────────────────────────

    // Clic sur une carte → ouvre le panneau latéral
    container.querySelectorAll('[data-article-nav]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        if (e.target.closest('button,a,select')) return;
        openPanel(el.dataset.articleNav);
      });
    });

    // Boutons Q/H/M — POST direct avec cascade
    container.querySelectorAll('[data-toggle]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        toggleFieldDirect(el.dataset.toggle, el.dataset.field);
      });
    });

    // Boutons + Tracker / + Pub — radio mutuellement exclusifs (envoyés avec prochain POST)
    container.querySelectorAll('[data-registre]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        const s = getState(el.dataset.registre);
        s.registre = s.registre === el.dataset.registreVal ? null : el.dataset.registreVal;
        updateCardDOM(el.dataset.registre);
      });
    });

    // Ignorer — avec undo 3s
    container.querySelectorAll('[data-ignorer]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        ignoreWithUndo(el.dataset.ignorer);
      });
    });

    // Archiver — avec undo 3s
    container.querySelectorAll('[data-archiver]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        archiveWithUndo(el.dataset.archiver);
      });
    });

    // Correction date
    container.querySelectorAll('.fix-date-link').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation(); e.preventDefault();
        const id = el.dataset.fixDate;
        const parent = el.parentElement;
        if (!parent) return;
        parent.innerHTML = `<input type="date" class="ew-input" style="font-size:11px;padding:2px 6px;width:auto;display:inline" data-date-article="${id}"><button style="font-size:10px;margin-left:4px;padding:2px 8px;border:none;background:var(--ink);color:var(--bg);border-radius:4px;cursor:pointer" data-date-ok="${id}">OK</button>`;
        parent.querySelector('[data-date-ok]')!.addEventListener('click', async (ev: any) => {
          ev.stopPropagation();
          const input = parent.querySelector('[data-date-article]') as HTMLInputElement;
          if (!input.value) return;
          try {
            await api(`/api/v1/articles/${id}/date`, { method: 'PATCH', body: { published_at: input.value } });
            const idx = articles.findIndex((a: any) => a.id === id);
            if (idx !== -1) articles[idx].published_at = input.value + 'T00:00:00Z';
            renderArticles();
          } catch (err) { console.error('Date fix failed:', err); }
        });
      });
    });
  }

  // ── Carte article V3 — spec EB-WORKFLOW-001 v3.1 §6 ─────────────────────
  // 7 boutons : Quotidien · Hebdo · Mensuel | + Tracker · + Pub | Ignorer · Archiver
  // Plus de bouton Valider — chaque clic Q/H/M envoie un POST direct (spec CLAUDE-CODE-UX-INBOX-PANEL v1.0)
  function articleCard(a: any): string {
    const s = getState(a.id);
    const isSelected = a.id === selectedArticleId;
    const isTreated  = s._treated;

    // Classes CSS selon état et origine
    const flashCls   = s.in_flash   ? 'active-direct' : '';
    const hebdoCls   = !s.in_hebdo   ? '' : s.hebdo_origin   === 'direct' ? 'active-direct' : 'active-cascade';
    const mensuelCls = !s.in_mensuel ? '' : s.mensuel_origin === 'direct' ? 'active-direct' : 'active-cascade';

    // + Tracker : badge si déjà ajouté, sinon bouton qui ouvre l'overlay tracker.
    // Câblé sur data-tracker (+ attributs de pré-remplissage) → handler [data-tracker].
    // (Auparavant data-registre : handler radio mort, aucun appel/overlay.)
    const trackerEl = a.tracker_added
      ? `<span class="ew-badge ew-badge-ok" style="font-family:var(--font-mono);font-size:9px">&#10003; Tracker</span>`
      : `<button class="ew-btn-v3" data-tracker="${a.id}"
          data-source="${escHtml(a.source_name||'')}"
          data-date="${a.published_at ? a.published_at.slice(0,10) : ''}"
          data-title="${escHtml(a.title||'')}"
          data-synthese="${escHtml(a.summary||'')}"
          data-url="${escHtml(a.original_url||'')}"
          data-type="${escHtml(a.impact_type||'')}">+ Tracker</button>`;

    // + Pub : badge si déjà ajouté, sinon bouton qui appelle l'API directement.
    // Câblé sur data-pub → handler [data-pub] (POST /tracker/pub/propose).
    // (Auparavant data-registre : handler radio mort, aucun appel API.)
    const pubEl = a.pub_added
      ? `<span class="ew-badge ew-badge-ok" style="font-family:var(--font-mono);font-size:9px">&#10003; Pub</span>`
      : `<button class="ew-btn-v3" data-pub="${a.id}">+ Pub</button>`;

    const impactRow = (a.has_impact && a.impacted_procedures?.length)
      ? `<div style="display:flex;align-items:center;gap:6px;margin-top:16px;flex-wrap:wrap" onclick="event.stopPropagation()">
          <span style="font-size:11px;color:#888">Impacte →</span>
          ${a.impacted_procedures.map((p: string) => `<span style="font-size:11px;font-weight:500;color:var(--ew-kaki)" title="${escHtml(p)}">${escHtml(procLabel(p))}</span>`).join(' · ')}
          <a href="${BASE}controle" style="font-size:11px;color:var(--ew-kaki);text-decoration:underline;margin-left:auto" onclick="event.stopPropagation()">Voir reminder</a>
        </div>` : '';

    const newBadge = a.status === 'nouveau' ? `<span class="tag-new-right">Nouveau</span>` : '';
    const isAuto = !!a._auto_tagged;
    const autoBadge = isAuto
      ? `<span style="font-size:9px;font-family:var(--font-mono);letter-spacing:0.06em;background:rgba(238,231,210,0.55);border:0.5px solid #C8C4BC;border-radius:3px;padding:1px 5px;color:var(--taupe)" title="Classé automatiquement à l'ingestion (EB-AUTO-001)">AUTO</span>`
      : '';
    const autoStyle = isAuto ? 'border-left:2px solid #C8C4BC;padding-left:14px;' : '';
    const traiteBadge = isTreated ? `<span class="ew-badge-traite">&#10003;</span>` : '';

    return `
      <div class="ew-item${isSelected ? ' ew-item--selected' : ''}${isTreated ? ' ew-item--traite' : ''}" data-article-nav="${a.id}" data-article-id="${a.id}" style="cursor:pointer;${autoStyle}">
        ${sourceAvatarHTML(a.source_name)}
        <div class="ew-item-body">
          <div class="ew-meta">
            <span class="src">${escHtml(a.source_name || 'Source inconnue')}</span>
            <span class="dot">·</span>
            <span class="date">${displayDate(a)}</span>
            ${autoBadge}
            ${a.impact_type ? `<span class="dot">·</span><span style="font-size:9px;font-weight:500;letter-spacing:0.12em;color:var(--taupe)">${escHtml(impactLabel(a.impact_type)).toUpperCase()}</span>` : ''}
          </div>
          <h3 class="ew-title">
            ${traiteBadge}
            ${a.original_url
              ? `<a href="${escHtml(a.original_url)}" target="_blank" rel="noopener" style="color:inherit;text-decoration:none" onclick="event.stopPropagation()">${escHtml(a.title || 'Sans titre')}${LINK_ICON}</a>`
              : escHtml(a.title || 'Sans titre')
            }
          </h3>
          ${impactRow}
          <div class="ew-actions" style="margin-top:16px">
            <button class="ew-btn-v3 ${flashCls}"   data-toggle="${a.id}" data-field="flash">Quotidien</button>
            <button class="ew-btn-v3 ${hebdoCls}"   data-toggle="${a.id}" data-field="hebdo">Hebdo</button>
            <button class="ew-btn-v3 ${mensuelCls}" data-toggle="${a.id}" data-field="mensuel">Mensuel</button>
            <div class="ew-act-sep"></div>
            ${trackerEl}
            ${pubEl}
            ${isAuto ? '' : `<div class="ew-act-sep"></div>
            <button class="ew-btn-v3" data-ignorer="${a.id}">Ignorer</button>
            <button class="ew-btn-v3" data-archiver="${a.id}">Archiver</button>`}
          </div>
          <div class="ew-card-error" id="err-${a.id}" style="display:none"></div>
        </div>
        <div class="ew-item-side">${newBadge}</div>
      </div>`;
  }

  // ── Toggle direct avec POST ───────────────────────────────────────────────
  // Remplace l'ancien validateCard() : chaque clic Q/H/M envoie un POST /triage immédiat.
  // Le backend accepte les articles en to_triage ET en kept (re-triage pour mise à jour des flags).

  async function toggleFieldDirect(id: string, field: string): Promise<void> {
    const s = getState(id);
    if (s._treating) return; // POST déjà en vol

    // Mise à jour locale de l'état + cascade
    toggleField(id, field);

    const anyOn = s.in_flash || s.in_hebdo || s.in_mensuel;

    if (!anyOn) {
      // Tous les flags sont désactivés — pas de POST (backend exige au moins un flag).
      // L'article reste 'kept' côté serveur s'il avait déjà été trié,
      // mais visuellement la carte redevient "non-traitée".
      updateCardDOM(id); // retire la classe ew-item--traite
      return;
    }

    // POST /triage avec l'état courant
    s._treating = true;
    try {
      const body: any = {
        in_flash:   s.in_flash,
        in_hebdo:   s.in_hebdo,
        in_mensuel: s.in_mensuel,
      };
      if (s.registre) body.registre_public_target = s.registre;

      await api(`/api/v1/articles/${id}/triage`, { method: 'POST', body });

      // Mettre à jour le tableau local (lifecycle → triaged pour rester visible)
      const idx = articles.findIndex((a: any) => a.id === id);
      if (idx !== -1) {
        articles[idx].lifecycle_status = 'triaged';
        articles[idx].in_flash   = s.in_flash;
        articles[idx].in_hebdo   = s.in_hebdo;
        articles[idx].in_mensuel = s.in_mensuel;
      }
      updateInboxBadge(); // l'article quitte le compteur to_triage

      updateCardDOM(id); // applique ew-item--traite + badge ✓
      if (hideTraites && s._treated) {
        // Si "masquer traités" est actif, retirer la carte de la liste
        const card = document.querySelector(`[data-article-id="${id}"]`) as HTMLElement | null;
        if (card) { card.style.transition = 'opacity 0.3s'; card.style.opacity = '0'; }
        setTimeout(() => renderArticles(), 300);
      }

    } catch (e: any) {
      // Annuler le toggle local en cas d'erreur
      toggleField(id, field); // inverse le toggle
      const errEl = document.getElementById(`err-${id}`);
      if (errEl) { errEl.textContent = e.message || 'Erreur'; errEl.style.display = 'block'; }
    } finally {
      s._treating = false;
    }
  }

  // ── Actions ──────────────────────────────────────────────────────────────

  // Barre d'undo affichée dans #article-list pendant 3s
  function showUndoBar(id: string, action: string, label: string): void {
    // Retirer une barre undo existante
    document.getElementById('undo-bar')?.remove();

    const bar = document.createElement('div');
    bar.id = 'undo-bar';
    bar.className = 'ew-undo-bar';
    bar.innerHTML = `<span>${label}</span><button class="ew-undo-btn" id="btn-undo-action">Annuler</button>`;

    const container = document.getElementById('article-list')!;
    const list = container.querySelector('#ew-list');
    if (list) container.insertBefore(bar, list);
    else container.prepend(bar);

    document.getElementById('btn-undo-action')?.addEventListener('click', () => {
      const pending = undoPending.get(id);
      if (pending) { clearTimeout(pending.timer); undoPending.delete(id); }
      bar.remove();
      // Restaurer la carte
      const card = document.querySelector(`[data-article-id="${id}"]`) as HTMLElement | null;
      if (card) { card.style.opacity = ''; card.style.pointerEvents = ''; }
    });
  }

  function ignoreWithUndo(id: string): void {
    // Annuler une éventuelle action undo précédente sur le même id
    const prev = undoPending.get(id);
    if (prev) { clearTimeout(prev.timer); undoPending.delete(id); }

    const card = document.querySelector(`[data-article-id="${id}"]`) as HTMLElement | null;
    if (card) { card.style.opacity = '0.3'; card.style.pointerEvents = 'none'; }

    showUndoBar(id, 'ignore', 'Article ignoré');

    const timer = setTimeout(() => {
      undoPending.delete(id);
      document.getElementById('undo-bar')?.remove();
      ignoreCard(id);
    }, 3000);
    undoPending.set(id, { action: 'ignore', timer });
  }

  function archiveWithUndo(id: string): void {
    const prev = undoPending.get(id);
    if (prev) { clearTimeout(prev.timer); undoPending.delete(id); }

    const card = document.querySelector(`[data-article-id="${id}"]`) as HTMLElement | null;
    if (card) { card.style.opacity = '0.3'; card.style.pointerEvents = 'none'; }

    showUndoBar(id, 'archive', 'Article archivé');

    const timer = setTimeout(() => {
      undoPending.delete(id);
      document.getElementById('undo-bar')?.remove();
      archiveCard(id);
    }, 3000);
    undoPending.set(id, { action: 'archive', timer });
  }

  async function ignoreCard(id: string): Promise<void> {
    try {
      await api(`/api/v1/articles/${id}/ignore`, { method: 'POST', body: {} });
      articles = articles.filter((a: any) => a.id !== id);
      cardStates.delete(id);
      if (selectedArticleId === id) closePanel();
      renderTabs(); renderArticles();
      toast('Article ignoré');
    } catch (e: any) { toast(e.message || 'Erreur', 'error'); }
  }

  async function archiveCard(id: string): Promise<void> {
    try {
      await api(`/api/v1/articles/${id}/archive`, { method: 'POST', body: {} });
      articles = articles.filter((a: any) => a.id !== id);
      cardStates.delete(id);
      if (selectedArticleId === id) closePanel();
      renderTabs(); renderArticles();
      toast('Article archivé');
    } catch (e: any) { toast(e.message || 'Erreur', 'error'); }
  }

  // ── Panneau latéral article (style Gmail) ────────────────────────────────

  async function openPanel(id: string): Promise<void> {
    // Mettre à jour l'état de sélection sans re-rendre la liste
    if (selectedArticleId) {
      document.querySelector(`[data-article-id="${selectedArticleId}"]`)?.classList.remove('ew-item--selected');
    }
    selectedArticleId = id;
    document.querySelector(`[data-article-id="${id}"]`)?.classList.add('ew-item--selected');

    // Basculer le layout vers "panneau ouvert"
    document.body.classList.add('ew-panel-open');
    document.getElementById('panel-digest')!.style.display = 'none';
    const panelEl = document.getElementById('panel-article')!;
    panelEl.style.display = 'flex';

    // Afficher les données locales immédiates (titre, meta)
    const localArt = articles.find((a: any) => a.id === id);
    panelEl.innerHTML = renderPanelSkeleton(localArt);
    bindPanelActions(id);

    // Charger les données complètes (content_html, summary)
    try {
      const fullArt: any = await api(`/api/v1/articles/${id}`);
      panelArticle = fullArt;
      panelEl.innerHTML = renderPanelContent(fullArt);
      bindPanelActions(id);
    } catch (e: any) {
      const contentEl = panelEl.querySelector('.ew-panel-body');
      if (contentEl) {
        contentEl.innerHTML = `<p style="color:var(--rouge);font-size:13px">Erreur de chargement : ${escHtml(e.message)}</p>`;
      }
    }
  }

  function closePanel(): void {
    if (selectedArticleId) {
      document.querySelector(`[data-article-id="${selectedArticleId}"]`)?.classList.remove('ew-item--selected');
    }
    selectedArticleId = null;
    panelArticle = null;
    document.body.classList.remove('ew-panel-open');
    document.getElementById('panel-digest')!.style.display = '';
    const panelEl = document.getElementById('panel-article')!;
    panelEl.style.display = 'none';
    panelEl.innerHTML = '';
  }

  // Squelette affiché avant le chargement des données complètes
  function renderPanelSkeleton(a: any): string {
    if (!a) return '<div style="padding:24px;color:var(--taupe)">Chargement…</div>';
    return renderPanelHTML(a, '<div style="padding:24px 24px 16px;text-align:center;color:var(--taupe);font-size:13px">Chargement du contenu…</div>');
  }

  function renderPanelContent(a: any): string {
    let bodyHtml = '';
    if (a.content_html) {
      bodyHtml = `<div class="ew-panel-article-html">${a.content_html}</div>`;
    } else if (a.summary) {
      bodyHtml = `<p style="font-size:14px;line-height:1.65;color:var(--ink-soft)">${escHtml(a.summary)}</p>`;
    } else {
      bodyHtml = `<p style="font-size:13px;color:var(--taupe);font-style:italic">Contenu non disponible — voir l'original.</p>`;
    }
    return renderPanelHTML(a, bodyHtml);
  }

  function renderPanelHTML(a: any, bodyHtml: string): string {
    const s = getState(a.id);
    const flashCls   = s.in_flash   ? 'active-direct' : '';
    const hebdoCls   = !s.in_hebdo   ? '' : s.hebdo_origin   === 'direct' ? 'active-direct' : 'active-cascade';
    const mensuelCls = !s.in_mensuel ? '' : s.mensuel_origin === 'direct' ? 'active-direct' : 'active-cascade';

    const dateStr = a.published_at
      ? new Date(a.published_at).toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' })
      : (a.created_at ? new Date(a.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : '');

    return `
      <div class="ew-panel-header">
        <div style="flex:1;min-width:0">
          <div style="font-size:11px;font-family:var(--font-mono);color:var(--taupe);letter-spacing:0.1em;margin-bottom:8px;text-transform:uppercase">${escHtml(a.source_name || '')}</div>
          <h2 style="font-size:16px;font-weight:500;color:var(--ink);line-height:1.35;margin:0 0 8px">${escHtml(a.title || 'Sans titre')}</h2>
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span style="font-size:12px;color:var(--taupe)">${escHtml(dateStr)}</span>
            ${a.original_url
              ? `<a href="${escHtml(a.original_url)}" target="_blank" rel="noopener" style="font-size:12px;color:var(--ew-kaki);text-decoration:underline;display:flex;align-items:center;gap:3px">Voir l'original${LINK_ICON}</a>`
              : ''}
            <a href="${BASE}article?id=${escHtml(a.id)}" style="font-size:11px;color:var(--mute);text-decoration:underline">Fiche complète</a>
          </div>
        </div>
        <button id="panel-close-btn" style="background:none;border:none;font-size:22px;color:var(--taupe);cursor:pointer;padding:4px 0 4px 12px;line-height:1;flex-shrink:0;align-self:flex-start">&times;</button>
      </div>
      <div class="ew-panel-body">${bodyHtml}</div>
      <div class="ew-panel-footer">
        <button class="ew-btn-v3 ${flashCls}"   data-panel-toggle="${a.id}" data-panel-field="flash">Quotidien</button>
        <button class="ew-btn-v3 ${hebdoCls}"   data-panel-toggle="${a.id}" data-panel-field="hebdo">Hebdo</button>
        <button class="ew-btn-v3 ${mensuelCls}" data-panel-toggle="${a.id}" data-panel-field="mensuel">Mensuel</button>
        <div class="ew-act-sep"></div>
        <button class="ew-btn-v3" data-panel-tracker="${a.id}"
          data-source="${escHtml(a.source_name||'')}"
          data-date="${a.published_at ? a.published_at.slice(0,10) : ''}"
          data-title="${escHtml(a.title||'')}"
          data-synthese="${escHtml(a.summary||'')}"
          data-url="${escHtml(a.original_url||'')}"
          data-type="${escHtml(a.impact_type||'')}">+ Tracker</button>
        <button class="ew-btn-v3" data-panel-pub="${a.id}">+ Pub</button>
        <div class="ew-act-sep"></div>
        <button class="ew-btn-v3" data-panel-ignorer="${a.id}">Ignorer</button>
        <button class="ew-btn-v3" data-panel-archiver="${a.id}">Archiver</button>
      </div>`;
  }

  function bindPanelActions(id: string): void {
    const panelEl = document.getElementById('panel-article')!;

    document.getElementById('panel-close-btn')?.addEventListener('click', () => closePanel());

    // Q/H/M — POST direct
    panelEl.querySelectorAll('[data-panel-toggle]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        toggleFieldDirect(el.dataset.panelToggle, el.dataset.panelField);
      });
    });

    // + Tracker — ouvre le drawer tracker pré-rempli
    panelEl.querySelectorAll('[data-panel-tracker]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        const trackerArticleId = el.dataset.panelTracker;
        (document.getElementById('tracker-source') as HTMLInputElement).value = el.dataset.source || '';
        (document.getElementById('tracker-date') as HTMLInputElement).value = el.dataset.date || '';
        (document.getElementById('tracker-sujet') as HTMLInputElement).value = el.dataset.title || '';
        (document.getElementById('tracker-synthese') as HTMLTextAreaElement).value = el.dataset.synthese || '';
        (document.getElementById('tracker-lien') as HTMLInputElement).value = el.dataset.url || '';
        (document.getElementById('tracker-statut') as HTMLInputElement).value = 'Publié';
        const typeMap: Record<string, string> = { nouvelle_regle: 'TEXTE', mise_a_jour: 'TEXTE', sanction: 'DECISION', appel_vigilance: 'CONSULTATION', info: 'TEXTE' };
        (document.getElementById('tracker-type') as HTMLSelectElement).value = typeMap[el.dataset.type||''] || 'TEXTE';
        // Stocker l'ID pour le confirm
        (document.getElementById('tracker-overlay') as any)._articleId = trackerArticleId;
        document.getElementById('tracker-overlay')!.style.display = 'flex';
      });
    });

    // + Pub — appel direct API
    panelEl.querySelectorAll('[data-panel-pub]').forEach((el: any) => {
      el.addEventListener('click', async (e: any) => {
        e.stopPropagation();
        const articleId = el.dataset.panelPub;
        const art = panelArticle || articles.find((a: any) => a.id === articleId);
        if (!art) return;
        try {
          await api(`/api/v1/tracker/pub/propose?article_id=${articleId}`, {
            method: 'POST',
            body: {
              date: art.published_at ? art.published_at.slice(0, 10) : '',
              source: art.source_name || '',
              type: 'Intelligence',
              titre: art.title || '',
              lien: art.original_url || '',
            },
          });
          const idx = articles.findIndex((a: any) => a.id === articleId);
          if (idx !== -1) articles[idx].pub_added = true;
          renderArticles(); renderDigestPanel();
          toast('Ajouté aux autres publications');
        } catch (err: any) { toast('Erreur: ' + err.message, 'error'); }
      });
    });

    // Ignorer / Archiver depuis le panneau
    panelEl.querySelectorAll('[data-panel-ignorer]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        ignoreWithUndo(el.dataset.panelIgnorer);
      });
    });
    panelEl.querySelectorAll('[data-panel-archiver]').forEach((el: any) => {
      el.addEventListener('click', (e: any) => {
        e.stopPropagation();
        archiveWithUndo(el.dataset.panelArchiver);
      });
    });
  }

  // Mettre à jour les boutons Q/H/M dans le panneau sans le re-rendre entièrement
  function updatePanelButtons(id: string): void {
    const panelEl = document.getElementById('panel-article');
    if (!panelEl || panelEl.style.display === 'none') return;

    const s = getState(id);

    function setPanelCls(field: string, cls: string): void {
      const btn = panelEl!.querySelector(`[data-panel-field="${field}"]`) as HTMLElement | null;
      if (!btn) return;
      btn.classList.remove('active-direct', 'active-cascade');
      if (cls) btn.classList.add(cls);
    }

    setPanelCls('flash',   s.in_flash   ? 'active-direct' : '');
    setPanelCls('hebdo',   !s.in_hebdo   ? '' : s.hebdo_origin   === 'direct' ? 'active-direct' : 'active-cascade');
    setPanelCls('mensuel', !s.in_mensuel ? '' : s.mensuel_origin === 'direct' ? 'active-direct' : 'active-cascade');
  }

  // ── Navigation clavier ────────────────────────────────────────────────────

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    // Ignorer si l'utilisateur est dans un champ de texte
    if ((e.target as HTMLElement).closest('input,textarea,select')) return;

    if (e.key === 'ArrowDown' || e.key === 'j') {
      e.preventDefault();
      navigateArticle(1);
    } else if (e.key === 'ArrowUp' || e.key === 'k') {
      e.preventDefault();
      navigateArticle(-1);
    } else if (e.key === 'Escape') {
      if (selectedArticleId) { e.preventDefault(); closePanel(); }
    }
  });

  function navigateArticle(direction: number): void {
    if (!visibleArticleIds.length) return;
    const currentIdx = selectedArticleId ? visibleArticleIds.indexOf(selectedArticleId) : -1;
    let newIdx = currentIdx + direction;
    // Clamp entre 0 et len-1 ; si aucun sélectionné et direction=+1, commencer à 0
    if (currentIdx === -1) newIdx = direction > 0 ? 0 : visibleArticleIds.length - 1;
    newIdx = Math.max(0, Math.min(visibleArticleIds.length - 1, newIdx));
    const newId = visibleArticleIds[newIdx];
    if (newId) {
      openPanel(newId);
      // Scroller la carte sélectionnée dans la vue
      setTimeout(() => {
        document.querySelector(`[data-article-id="${newId}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }, 50);
    }
  }

  // Ensemble EXACT que POST /articles/publish-all publie (backend articles.py:669) :
  //   lifecycle_status ∈ ('triaged','kept') ET published_to_newsletter = false.
  // Rétrocompat v2 : le backend mappe kept→triaged dans ses réponses (_v2_compat),
  // donc aujourd'hui le frontend voit surtout 'triaged' ; on garde 'kept' pour rester
  // correct après le retrait du mapping (PR D). Source unique pour label + modale +
  // mise à jour optimiste, afin que N ne mente jamais sur ce qui sera publié.
  function articlesToPublish(): any[] {
    return articles.filter((a: any) =>
      (a.lifecycle_status === 'triaged' || a.lifecycle_status === 'kept')
      && !a.published_to_newsletter
    );
  }

  // ── Digest panel (panneau droit en mode sans article sélectionné) ─────────

  function renderDigestPanel(): void {
    const nc: any = newsletterCounts;
    const qTotal = nc?.quotidien_total || 0;
    const qPub   = nc?.quotidien_published || 0;
    const hTotal = nc?.hebdo_total || 0;
    const hPub   = nc?.hebdo_published || 0;
    const canClose = (qTotal + hTotal) > 0;
    const triagedCount = articlesToPublish().length;

    const digestSection = nc ? `
      <div>
        <div class="ew-r-title">Digest</div>
        <div class="ew-digest-block">
          <div class="ew-digest-label">Quotidien</div>
          <div class="ew-digest-num"><span class="accent">${qPub}</span><span class="total"> / ${qTotal}</span></div>
          <div class="ew-digest-actions">
            <button class="ew-digest-btn" data-copy-md="quotidien">Copier</button>
            <button class="ew-digest-btn" id="btn-apercu-quotidien" ${qTotal === 0 ? 'disabled style="opacity:.4"' : ''}>Aperçu</button>
          </div>
        </div>
        <div class="ew-digest-block">
          <div class="ew-digest-label">Hebdo</div>
          <div class="ew-digest-num"><span class="accent">${hPub}</span><span class="total"> / ${hTotal}</span></div>
          <div class="ew-digest-actions">
            <button class="ew-digest-btn" data-copy-md="hebdo">Copier</button>
            <button class="ew-digest-btn" id="btn-apercu-hebdo" ${hTotal === 0 ? 'disabled style="opacity:.4"' : ''}>Aperçu</button>
          </div>
        </div>
        <button class="ew-close" id="btn-publish-all" ${!canClose ? 'disabled style="opacity:.4"' : ''}>Clôturer la session (publie ${triagedCount} article${triagedCount > 1 ? 's' : ''})</button>
        <div class="ew-close-note">Publie les articles triés dans la newsletter et clôture la session.</div>
      </div>` : `
      <div>
        <div class="ew-r-title">Digest</div>
        <div style="font-size:12px;color:var(--mute)">Newsletter non activée.</div>
      </div>`;

    const trackerSection = trackerPendingCount > 0 ? `
      <div>
        <div class="ew-r-title">Tracker</div>
        <div class="ew-tracker-num">${trackerPendingCount}</div>
        <div class="ew-tracker-desc">article${trackerPendingCount > 1 ? 's' : ''} éligible${trackerPendingCount > 1 ? 's' : ''} non ajouté${trackerPendingCount > 1 ? 's' : ''} au tracker réglementaire.</div>
      </div>` : `
      <div>
        <div class="ew-r-title">Tracker</div>
        <div style="font-size:12px;color:var(--mute)">Aucun article en attente.</div>
      </div>`;

    document.getElementById('panel-digest')!.innerHTML = `
      ${digestSection}
      <div class="ew-divider"></div>
      ${trackerSection}
      <div class="ew-divider"></div>
      <div>
        <div class="ew-r-title">Export</div>
        <div class="ew-export-list">
          <div class="ew-export-item" data-export="markdown" data-export-type="quotidien" style="cursor:pointer"><span>Quotidien</span><span class="ext">.md</span></div>
          <div class="ew-export-item" data-export="markdown" data-export-type="hebdo" style="cursor:pointer"><span>Hebdo</span><span class="ext">.md</span></div>
          <div class="ew-export-item" id="btn-export-monthly" style="cursor:pointer"><span>Mensuel</span><span class="ext">.md</span></div>
        </div>
      </div>`;

    // Bind
    document.querySelectorAll('[data-copy-md]').forEach((el: any) => {
      el.addEventListener('click', () => copyMarkdownToClipboard(el.dataset.copyMd, el));
    });
    document.querySelectorAll('[data-export]').forEach((el: any) => {
      el.addEventListener('click', () => exportArticles(el.dataset.export, el.dataset.exportType));
    });
    document.getElementById('btn-apercu-quotidien')?.addEventListener('click', () => openApercu('quotidien'));
    document.getElementById('btn-apercu-hebdo')?.addEventListener('click', () => openApercu('hebdo'));

    const publishAllBtn = document.getElementById('btn-publish-all');
    if (publishAllBtn) {
      publishAllBtn.addEventListener('click', () => {
        const triaged = articlesToPublish();
        if (!triaged.length) return;
        const n = triaged.length;
        // Confirmation systématique : Maria voit ce qu'elle publie avant de valider.
        document.getElementById('cloturer-intro')!.textContent =
          `${n} article${n > 1 ? 's' : ''} ${n > 1 ? 'vont' : 'va'} être publié${n > 1 ? 's' : ''} dans la newsletter :`;
        document.getElementById('cloturer-list')!.innerHTML = triaged.map((a: any) => `
          <div style="padding:8px 0;border-bottom:0.5px solid var(--line)">
            <div style="font-size:13px;color:var(--ink);line-height:1.35">${escHtml(a.title || 'Sans titre')}</div>
            <div style="font-size:11px;color:var(--taupe);margin-top:2px">${escHtml(a.source_name || 'Source inconnue')}</div>
          </div>`).join('');
        // Note tracker conservée, en conditionnel (comportement préexistant).
        const msg = document.getElementById('cloturer-msg')!;
        if (trackerPendingCount > 0) {
          msg.textContent =
            `${trackerPendingCount} article${trackerPendingCount > 1 ? 's' : ''} éligible${trackerPendingCount > 1 ? 's' : ''} n'${trackerPendingCount > 1 ? 'ont' : 'a'} pas été ajouté${trackerPendingCount > 1 ? 's' : ''} au tracker.`;
          msg.style.display = '';
        } else {
          msg.style.display = 'none';
        }
        document.getElementById('cloturer-confirm')!.textContent = `Clôturer (publier ${n})`;
        document.getElementById('cloturer-overlay')!.style.display = 'flex';
      });
    }

    document.getElementById('cloturer-cancel')?.addEventListener('click', () => {
      document.getElementById('cloturer-overlay')!.style.display = 'none';
    });
    document.getElementById('cloturer-overlay')?.addEventListener('click', (e: Event) => {
      if (e.target === e.currentTarget) (e.currentTarget as HTMLElement).style.display = 'none';
    });
    document.getElementById('cloturer-confirm')?.addEventListener('click', () => {
      document.getElementById('cloturer-overlay')!.style.display = 'none';
      executePublishAll();
    });

    const exportMonthlyBtn = document.getElementById('btn-export-monthly');
    if (exportMonthlyBtn) {
      exportMonthlyBtn.addEventListener('click', async () => {
        const now = new Date();
        let year = now.getFullYear(), month = now.getMonth() + 1;
        if (now.getDate() < 5) { month--; if (month === 0) { month = 12; year--; } }
        const monthStr = `${year}-${String(month).padStart(2, '0')}`;
        (exportMonthlyBtn as any).style.opacity = '.5';
        try {
          const md = await api(`/api/v1/articles/monthly-recap/markdown?month=${monthStr}`);
          const blob = new Blob([md as string], { type: 'text/markdown;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url; a.download = `early-brief-recap-${monthStr}.md`; a.click();
          URL.revokeObjectURL(url);
          toast(`Récap ${monthStr} exporté`);
        } catch (e: any) { toast(e.message || 'Erreur export', 'error'); }
        (exportMonthlyBtn as any).style.opacity = '1';
      });
    }
  }

  async function executePublishAll(): Promise<void> {
    const btn = document.getElementById('btn-publish-all') as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.textContent = 'Publication...'; }
    try {
      const res: any = await api('/api/v1/articles/publish-all', { method: 'POST', body: {} });
      articlesToPublish().forEach((a: any) => {
        const idx = articles.findIndex((x: any) => x.id === a.id);
        if (idx !== -1) { articles[idx].published_to_newsletter = true; articles[idx].lifecycle_status = 'published'; }
      });
      newsletterCounts = await api('/api/v1/articles/newsletter/counts').catch(() => newsletterCounts);
      const tc: any = await api('/api/v1/tracker/pending-count').catch(() => ({ pending: 0 }));
      trackerPendingCount = tc?.pending || 0;
      renderArticles(); renderDigestPanel();
      toast(`${res.published || 0} article${(res.published||0) > 1 ? 's' : ''} publiés — session clôturée`);
    } catch (e: any) {
      toast('Erreur: ' + (e.message || 'publication échouée'), 'error');
      if (btn) btn.disabled = false;
      renderDigestPanel();  // restaure le label dynamique correct (N articles)
    }
  }

  // ── Aperçu drag & drop ───────────────────────────────────────────────────

  let apercuOrder: any[] = [];
  let apercuType = 'hebdo';
  let dragIdx = -1;

  async function openApercu(type: string): Promise<void> {
    apercuType = type;
    const overlay = document.getElementById('apercu-overlay')!;
    overlay.style.display = 'flex';
    document.getElementById('apercu-title')!.textContent = `Aperçu ${type === 'quotidien' ? 'Quotidien' : 'Hebdo'}`;
    document.getElementById('apercu-list')!.innerHTML =
      '<div style="padding:30px;text-align:center;color:var(--taupe);font-size:13px">Chargement…</div>';
    document.getElementById('apercu-close')!.onclick = closeApercu;
    document.getElementById('apercu-cancel')!.onclick = closeApercu;
    document.getElementById('apercu-export')!.onclick = exportApercuOrder;
    try {
      const data: any = await api(`/api/v1/articles/export?type=${type}`);
      apercuOrder = Array.isArray(data) ? data : (data?.items || []);
      renderApercuList();
    } catch (e: any) {
      document.getElementById('apercu-list')!.innerHTML =
        '<div style="padding:30px;text-align:center;color:var(--rouge);font-size:13px">Erreur de chargement</div>';
    }
  }

  function closeApercu(): void {
    document.getElementById('apercu-overlay')!.style.display = 'none';
  }

  function renderApercuList(): void {
    const list = document.getElementById('apercu-list')!;
    if (!apercuOrder.length) {
      list.innerHTML = '<div style="padding:30px;text-align:center;color:var(--taupe);font-size:13px">Aucun article</div>';
      return;
    }
    list.innerHTML = apercuOrder.map((a: any, i: number) => `
      <div class="apercu-item" draggable="true" data-apercu-idx="${i}" style="display:flex;align-items:center;gap:12px;padding:10px 12px;margin-bottom:6px;background:var(--bg);border:0.5px solid var(--line-strong);border-radius:6px;cursor:grab">
        <span style="color:var(--mute);font-size:16px;user-select:none">⠇</span>
        <span style="font-family:var(--font-mono);font-size:11px;color:var(--mute);width:18px;flex-shrink:0">${i + 1}</span>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:500;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escHtml(a.title||'Sans titre')}</div>
          <div style="font-size:11px;color:var(--taupe);margin-top:2px">${escHtml(a.source_name||'')} · ${displayDate(a)}</div>
        </div>
      </div>`).join('');

    list.querySelectorAll('.apercu-item').forEach((el: any) => {
      el.addEventListener('dragstart', (e: DragEvent) => { dragIdx = +el.dataset.apercuIdx; el.style.opacity = '.5'; e.dataTransfer!.effectAllowed = 'move'; });
      el.addEventListener('dragend', () => { el.style.opacity = '1'; list.querySelectorAll('.apercu-item').forEach((x: any) => x.style.border = '0.5px solid var(--line-strong)'); });
      el.addEventListener('dragover', (e: DragEvent) => { e.preventDefault(); el.style.border = '1px dashed var(--moutarde)'; });
      el.addEventListener('dragleave', () => { el.style.border = '0.5px solid var(--line-strong)'; });
      el.addEventListener('drop', (e: DragEvent) => {
        e.preventDefault();
        const dropIdx = +el.dataset.apercuIdx;
        if (dragIdx !== dropIdx && dragIdx >= 0) {
          const item = apercuOrder.splice(dragIdx, 1)[0];
          apercuOrder.splice(dropIdx, 0, item);
          renderApercuList();
        }
      });
    });
  }

  async function exportApercuOrder(): Promise<void> {
    const label = apercuType === 'quotidien' ? 'Quotidien' : 'Hebdo';
    const today = new Date().toLocaleDateString('fr-FR');
    const lines = [`# Early Watch ${label} — ${today}`, ''];
    apercuOrder.forEach((a: any, i: number) => {
      const pub = a.published_at ? new Date(a.published_at).toLocaleDateString('fr-FR') : 'Date inconnue';
      lines.push(`## ${i + 1}. ${a.title}`, '');
      if (a.summary) { lines.push(a.summary, ''); }
      lines.push(`**Source :** ${a.source_name||'Source inconnue'} — ${pub}`);
      lines.push(`**Lien :** ${a.original_url||'N/A'}`, '', '---', '');
    });
    const blob = new Blob([lines.join('\n')], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url; link.download = `earlywatch-${apercuType}-${new Date().toISOString().slice(0,10)}.md`; link.click();
    URL.revokeObjectURL(url);
    closeApercu(); toast('Export téléchargé');
  }

  // ── Copy & Export ─────────────────────────────────────────────────────────

  async function copyMarkdownToClipboard(type: string, btn: HTMLButtonElement): Promise<void> {
    try {
      const data: any = await api(`/api/v1/articles/export/markdown?type=${type}`);
      await navigator.clipboard.writeText(typeof data === 'string' ? data : JSON.stringify(data, null, 2));
      const orig = btn.textContent;
      btn.textContent = '&#10003; Copié !';
      setTimeout(() => { btn.textContent = orig; }, 2000);
    } catch (e: any) { toast(e.message || 'Erreur de copie', 'error'); }
  }

  async function exportArticles(format: string, type?: string): Promise<void> {
    try {
      let path = format === 'markdown' ? '/api/v1/articles/export/markdown' : '/api/v1/articles/export';
      if (type) path += `?type=${type}`;
      const data: any = await api(path);
      const blob = new Blob([typeof data === 'string' ? data : JSON.stringify(data, null, 2)], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `earlywatch-export${type ? '-' + type : ''}.${format === 'markdown' ? 'md' : 'json'}`; a.click();
      URL.revokeObjectURL(url);
      toast('Export téléchargé');
    } catch (e: any) { toast(e.message || 'Erreur export', 'error'); }
  }

  // ── Tracker drawer ────────────────────────────────────────────────────────

  let trackerArticleId: string | null = null;

  document.addEventListener('click', (e: Event) => {
    const btn = (e.target as HTMLElement).closest('[data-tracker]') as HTMLElement | null;
    if (!btn) return;
    trackerArticleId = btn.dataset.tracker!;
    (document.getElementById('tracker-source') as HTMLInputElement).value = btn.dataset.source || '';
    (document.getElementById('tracker-date') as HTMLInputElement).value = btn.dataset.date ? btn.dataset.date.slice(0,10) : '';
    (document.getElementById('tracker-sujet') as HTMLInputElement).value = btn.dataset.title || '';
    (document.getElementById('tracker-synthese') as HTMLTextAreaElement).value = btn.dataset.synthese || '';
    (document.getElementById('tracker-lien') as HTMLInputElement).value = btn.dataset.url || '';
    (document.getElementById('tracker-statut') as HTMLInputElement).value = 'Publié';
    const typeMap: Record<string, string> = { nouvelle_regle: 'TEXTE', mise_a_jour: 'TEXTE', sanction: 'DECISION', appel_vigilance: 'CONSULTATION', info: 'TEXTE' };
    (document.getElementById('tracker-type') as HTMLSelectElement).value = typeMap[btn.dataset.type||''] || 'TEXTE';
    document.getElementById('tracker-overlay')!.style.display = 'flex';
  });

  document.getElementById('tracker-close')?.addEventListener('click', () => { document.getElementById('tracker-overlay')!.style.display = 'none'; });
  document.getElementById('tracker-cancel')?.addEventListener('click', () => { document.getElementById('tracker-overlay')!.style.display = 'none'; });
  document.getElementById('tracker-overlay')?.addEventListener('click', (e: Event) => {
    if (e.target === e.currentTarget) (e.currentTarget as HTMLElement).style.display = 'none';
  });

  document.getElementById('tracker-confirm')?.addEventListener('click', async () => {
    // L'ID peut venir du panneau (stocké dans _articleId) ou de la variable locale
    const artId = (document.getElementById('tracker-overlay') as any)._articleId || trackerArticleId;
    const body = {
      source:   (document.getElementById('tracker-source') as HTMLInputElement).value,
      date:     (document.getElementById('tracker-date') as HTMLInputElement).value,
      sujet:    (document.getElementById('tracker-sujet') as HTMLInputElement).value,
      synthese: (document.getElementById('tracker-synthese') as HTMLTextAreaElement).value,
      type:     (document.getElementById('tracker-type') as HTMLSelectElement).value,
      lien:     (document.getElementById('tracker-lien') as HTMLInputElement).value,
      statut:   (document.getElementById('tracker-statut') as HTMLInputElement).value,
    };
    try {
      const res: any = await api(`/api/v1/tracker/propose?article_id=${artId}`, { method: 'POST', body });
      if (res.success) {
        const idx = articles.findIndex((a: any) => a.id === artId);
        if (idx !== -1) articles[idx].tracker_added = true;
        document.getElementById('tracker-overlay')!.style.display = 'none';
        const tc: any = await api('/api/v1/tracker/pending-count').catch(() => ({ pending: 0 }));
        trackerPendingCount = tc?.pending || 0;
        renderArticles(); renderDigestPanel();
        toast('Article ajouté au Tracker');
      } else { toast('Erreur tracker', 'error'); }
    } catch (err: any) { toast('Erreur: ' + err.message, 'error'); }
  });

  document.addEventListener('click', async (e: Event) => {
    const btn = (e.target as HTMLElement).closest('[data-pub]') as HTMLElement | null;
    if (!btn) return;
    e.stopPropagation();
    const articleId = btn.dataset.pub!;
    const article = articles.find((a: any) => a.id === articleId);
    try {
      await api(`/api/v1/tracker/pub/propose?article_id=${articleId}`, {
        method: 'POST',
        body: {
          date: article?.published_at ? article.published_at.slice(0, 10) : '',
          source: article?.source_name || '',
          type: 'Intelligence',
          titre: article?.title || '',
          lien: article?.original_url || '',
        },
      });
      const idx = articles.findIndex((a: any) => a.id === articleId);
      if (idx !== -1) articles[idx].pub_added = true;
      renderArticles(); renderDigestPanel();
      toast('Ajouté aux autres publications');
    } catch (err: any) { toast('Erreur: ' + err.message, 'error'); }
  });

  // ── Utils ─────────────────────────────────────────────────────────────────

  function escHtml(s: string): string {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  bootstrapAuth();
  init();
</script>

<style is:global>
  /* Slide-in animation pour les drawers */
  @keyframes ew-slide-in {
    from { transform: translateX(100%); }
    to   { transform: translateX(0); }
  }

  /* Reset triage — ✕ dans le bouton actif */
  .triage-reset {
    color: var(--mute);
    font-size: 10px;
    margin-left: 3px;
    cursor: pointer;
    transition: color 0.1s;
  }
  .triage-reset:hover { color: var(--ink); }

  /* Badge tracker/pub confirmé */
  .ew-badge-ok {
    background: var(--bg-hover);
    color: var(--taupe);
    border: 0.5px solid var(--line-strong);
    padding: 2px 8px;
    border-radius: 2px;
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  /* Textarea dans les drawers */
  .ew-textarea { resize: vertical; min-height: 72px; }

  /* Scrollbar gutter pour les listes longues */
  #ew-list, #ew-list-auto { scrollbar-gutter: stable; }

  /* ── En-têtes de section : « À trier » / « Auto-classés récents » ── */
  .ew-section-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 18px 0 8px;
    padding-bottom: 6px;
    border-bottom: 0.5px solid var(--line, #E5E2D9);
  }
  .ew-section-title {
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--taupe);
    font-weight: 500;
  }
  .ew-section-count {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--mute);
    background: var(--bg-hover, #EAE6DA);
    border-radius: 8px;
    padding: 0 7px;
    line-height: 16px;
  }
  .ew-section-hint {
    font-size: 11px;
    color: var(--mute);
    margin-left: auto;
  }

  /* Cartes auto-classées : légèrement en retrait visuel */
  .ew-list-auto .ew-item {
    opacity: 0.85;
  }

  /* Les overlays sont contrôlés uniquement par JS (style.display = 'flex'/'none') */
  #apercu-overlay { display: none; }
  #cloturer-overlay { display: none; }
  #tracker-overlay { display: none; }

  /* ── Boutons de triage V3 — spec §9.4 ── */

  .ew-btn-v3 {
    font-size: 12px;
    padding: 6px 12px;
    background: transparent;
    color: var(--ew-kaki);
    border: 0.5px solid #D5D2CB;
    border-radius: var(--radius, 4px);
    font-family: var(--font);
    cursor: pointer;
    transition: background 0.12s, border-color 0.12s, color 0.12s;
    letter-spacing: 0.005em;
    white-space: nowrap;
    position: relative;
  }
  .ew-btn-v3:hover:not(.active-direct):not(.active-cascade):not(:disabled) {
    background: var(--bg-side);
    border-color: #B8B3AA;
    color: var(--ink);
  }

  /* Actif direct : clic utilisateur */
  .ew-btn-v3.active-direct {
    color: #1A1918;
    background: var(--bg-triage-active, #EEE7D2);
    border-color: var(--ew-kaki);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--ew-kaki);
    text-underline-offset: 2px;
  }

  /* Actif cascade : allumé par propagation */
  .ew-btn-v3.active-cascade {
    color: #1A1918;
    background: rgba(238, 231, 210, 0.45);
    border-color: #C8C4BC;
  }

  /* Message d'erreur inline dans la carte (affiché sur erreur API) */
  .ew-card-error {
    font-size: 11px;
    color: #c0392b;
    margin-top: 6px;
    display: none;
    font-family: var(--font-mono);
  }

  /* ── Carte sélectionnée (article ouvert dans le panneau) ── */
  .ew-item--selected {
    background: var(--bg-hover, #EAE6DA) !important;
    border-left: 2px solid var(--ew-kaki) !important;
    padding-left: 12px;
  }

  /* ── Carte traitée (au moins un Q/H/M activé et sauvegardé) ── */
  .ew-item--traite {
    opacity: 0.62;
  }
  .ew-item--traite .ew-title {
    color: var(--taupe);
  }

  /* Badge ✓ traité — affiché à côté du titre */
  .ew-badge-traite {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ew-kaki);
    background: var(--ew-kaki-bg);
    border: 0.5px solid var(--ew-kaki-border-hover);
    border-radius: 2px;
    padding: 0 4px;
    margin-right: 5px;
    vertical-align: middle;
    font-weight: 600;
  }

  /* ── Bouton "Masquer/Afficher les traités" dans les tabs ── */
  .ew-btn-masquer {
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--taupe);
    background: none;
    border: 0.5px solid var(--line-strong);
    border-radius: var(--radius, 4px);
    padding: 4px 10px;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s;
    margin-left: auto;
    white-space: nowrap;
  }
  .ew-btn-masquer:hover {
    color: var(--ink);
    border-color: var(--taupe);
  }

  /* ── Barre undo (ignore/archive avec délai 3s) ── */
  .ew-undo-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    margin-bottom: 8px;
    background: var(--ink, #1A1918);
    color: var(--bg, #F4F0E6);
    border-radius: var(--radius, 4px);
    font-size: 13px;
    font-family: var(--font);
    animation: ew-slide-down 0.2s ease-out;
  }
  @keyframes ew-slide-down {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .ew-undo-btn {
    font-size: 12px;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--bg, #F4F0E6);
    background: none;
    border: 0.5px solid rgba(244,240,230,0.4);
    border-radius: 3px;
    padding: 3px 10px;
    cursor: pointer;
    transition: background 0.12s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .ew-undo-btn:hover { background: rgba(244,240,230,0.15); }

  /* ── Layout panneau ouvert : élargit la colonne droite ── */
  body.ew-panel-open .ew-frame {
    grid-template-columns: 220px minmax(320px, 2fr) minmax(380px, 3fr);
  }

  /* ── Panneau article (occupe toute la hauteur de .ew-right quand visible) ── */
  #panel-article {
    /* Le panneau utilise des marges négatives pour annuler le padding de .ew-right */
    margin: -28px -24px;
    /* height = 100vh car .ew-right a height:100vh */
    height: 100vh;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg-side, #F5F1E8);
    border-left: 0.5px solid var(--line, #E5E2D9);
    animation: ew-panel-in 0.18s ease-out;
  }
  @keyframes ew-panel-in {
    from { opacity: 0; transform: translateX(12px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* Header du panneau article */
  .ew-panel-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 20px 22px 16px;
    border-bottom: 0.5px solid var(--line, #E5E2D9);
    flex-shrink: 0;
  }

  /* Corps scrollable du panneau */
  .ew-panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 22px;
    scrollbar-gutter: stable;
  }

  /* Contenu HTML de l'article dans le panneau */
  .ew-panel-article-html {
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-soft, #3A3530);
  }
  .ew-panel-article-html h1,
  .ew-panel-article-html h2,
  .ew-panel-article-html h3 {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin: 16px 0 6px;
  }
  .ew-panel-article-html p { margin: 0 0 10px; }
  .ew-panel-article-html a { color: var(--ew-kaki); }
  .ew-panel-article-html ul,
  .ew-panel-article-html ol { padding-left: 18px; margin: 0 0 10px; }

  /* Footer d'actions du panneau */
  .ew-panel-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 12px 18px;
    border-top: 0.5px solid var(--line, #E5E2D9);
    flex-shrink: 0;
    background: var(--bg-side, #F5F1E8);
  }

  /* ── Mobile : panneau en overlay plein écran ── */
  @media (max-width: 768px) {
    body.ew-panel-open .ew-frame {
      grid-template-columns: 220px 1fr 0;
    }
    #panel-article {
      position: fixed;
      inset: 0;
      margin: 0;
      height: 100vh;
      height: 100dvh;
      z-index: 400;
    }
  }
</style>

<!-- ── Sélecteur vue client (superadmin uniquement) ── -->
<script>
  import { getUser, api, startImpersonation } from '../scripts/api';
  import { bootstrapAuth } from '../scripts/bootstrap-auth';
  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';

  async function initDemoButton() {
    const user = getUser();
    if (!user || user.role !== 'superadmin') return;

    const btn = document.getElementById('btn-demo-client') as HTMLButtonElement;
    if (!btn) return;
    btn.style.display = 'inline-block';

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Chargement…';
      try {
        // Trouver le tenant Demo PSP
        const { tenants } = await api('/api/v1/admin/tenants');
        const demo = (tenants as any[]).find((t: any) => t.name === 'Demo PSP');
        if (!demo) { alert('Tenant Demo PSP introuvable. Lancez setup_demo_psp.py d\'abord.'); return; }

        // Obtenir le token d'impersonation
        const result = await api('/api/v1/admin/impersonate', {
          method: 'POST',
          body: { tenant_id: demo.id },
        });
        startImpersonation(result.access_token, result.user);
        window.location.href = BASE + 'app/tableau-de-bord';
      } catch (e: any) {
        alert('Erreur : ' + e.message);
        btn.disabled = false;
        btn.textContent = 'Voir comme client Demo PSP →';
      }
    });
  }

  bootstrapAuth();
  initDemoButton();
</script>
