---
import AppLayout from '../layouts/AppLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AppLayout title="Superadmin — Early Watch">
  <div class="sa-layout">
    <div class="sa-main">
      <div><span class="sa-title">Superadmin</span><span class="sa-badge">INTERNE</span></div>
      <div class="sa-subtitle">Gestion des clients Early Watch — tenants, modules, onboarding</div>

      <div class="stats-bar" id="stats-bar">
        <div class="stat-card"><div class="stat-card-value" id="s-tenants">--</div><div class="stat-card-label">Tenants actifs</div></div>
        <div class="stat-card"><div class="stat-card-value" id="s-procs">--</div><div class="stat-card-label">Procedures attribuees</div></div>
        <div class="stat-card"><div class="stat-card-value" id="s-reminders">--</div><div class="stat-card-label">Reminders actifs</div></div>
        <div class="stat-card"><div class="stat-card-value" id="s-articles">--</div><div class="stat-card-label">Articles 7 jours</div></div>
      </div>

      <div id="table-container">
        <div class="loading">Chargement des tenants...</div>
      </div>

      <div class="create-section">
        <div class="create-header" id="create-header-toggle">
          Creer un nouveau client
          <span style="font-size:18px">+</span>
        </div>
        <div class="create-body" id="create-body">
          <div class="form-row">
            <div class="form-group">
              <label>Nom de l'etablissement</label>
              <input type="text" id="c-name" placeholder="Ex: Fintech Solutions SAS">
            </div>
            <div class="form-group">
              <label>Type d'entite</label>
              <select id="c-type">
                <option value="PSP">PSP</option>
                <option value="EC">Etablissement de credit</option>
                <option value="EME">EME</option>
                <option value="SGP">SGP</option>
                <option value="CASP">CASP/PSAN</option>
                <option value="CIF">CIF</option>
                <option value="OTHER">Autre</option>
              </select>
            </div>
            <div class="form-group">
              <label>Plan</label>
              <select id="c-plan">
                <option value="demo">Demo</option>
                <option value="pnf">Professions non financières</option>
                <option value="cabinet">Cabinet</option>
                <option value="solo">Responsable LCB-FT</option>
                <option value="equipe">Équipe</option>
                <optgroup label="Anciennes formules">
                  <option value="starter">Starter</option>
                  <option value="pro">Pro</option>
                </optgroup>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Email admin</label>
              <input type="email" id="c-email" placeholder="compliance@client.com">
            </div>
            <div class="form-group">
              <label>Prenom</label>
              <input type="text" id="c-fn" placeholder="Jean">
            </div>
            <div class="form-group">
              <label>Nom</label>
              <input type="text" id="c-ln" placeholder="Dupont">
            </div>
          </div>
          <button class="btn-create" id="btn-create-tenant">Creer le tenant</button>
          <div class="result-box" id="create-result"></div>
        </div>
      </div>
    </div>
  </div>
</AppLayout>

<style>
  .sa-layout { min-height: 100vh; display: flex; flex-direction: column; background: #EDEAE3; }
  .sa-main { flex: 1; max-width: 1200px; margin: 0 auto; padding: 32px 24px; width: 100%; }
  .sa-title { font-size: 15px; font-weight: 500; color: var(--ink); }
  .sa-subtitle { font-size: 13px; color: var(--mute); margin-bottom: 24px; }
  .sa-badge { display: inline-block; padding: 1px 6px; border-radius: 0; font-size: 10px; font-weight: 400; font-family: 'IBM Plex Mono', monospace; letter-spacing: 0.06em; background: transparent; color: #5C6347; border: 1px solid #5C6347; margin-left: 8px; vertical-align: middle; }

  .stats-bar {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px;
    margin-bottom: 24px;
  }
  .stat-card {
    padding: 1.25rem 1.5rem; background: var(--bg); border: 1px solid var(--line);
    border-radius: 0; box-shadow: none;
  }
  .stat-card-value { font-family: 'IBM Plex Mono', monospace; font-size: 32px; font-weight: 300; line-height: 1; color: var(--ink); }
  .stat-card-label { font-size: 11px; color: var(--mute); margin-top: 2px; }

  .create-section {
    margin-top: 24px; background: var(--bg); border: 1px solid var(--line);
    border-radius: 0; box-shadow: none; overflow: hidden;
  }
  .create-header {
    padding: 14px 18px; font-size: 14px; font-weight: 500; color: var(--ink);
    border-bottom: 1px solid var(--line); cursor: pointer;
    display: flex; justify-content: space-between; align-items: center;
  }
  .create-body { padding: 18px; display: none; }
  :global(.create-body.open) { display: block; }
  .form-row { display: flex; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
  .form-group { flex: 1; min-width: 180px; }
  .form-group label { display: block; font-size: 11px; font-weight: 500; color: var(--ink); margin-bottom: 3px; text-transform: uppercase; }
  .form-group input, .form-group select {
    width: 100%; padding: 7px 10px; border: 1px solid var(--line-strong);
    border-radius: 4px; font-size: 13px; font-family: inherit; background: #EDEAE3;
  }
  .btn-create {
    padding: 10px 24px; background: var(--moutarde); color: var(--bg);
    border: 0.5px solid var(--ink); font-size: 13px;
    font-weight: 500; cursor: pointer; font-family: inherit;
    box-shadow: none;
  }
  .result-box {
    margin-top: 12px; padding: 12px 16px; background: rgba(92,99,71,0.1);
    border: 1px solid #5C6347; border-radius: 0; font-size: 13px; display: none;
  }
  :global(.result-box.visible) { display: block; }
  .loading { padding: 40px; text-align: center; color: var(--mute); font-size: 14px; }
</style>

<style is:global>
  .tenant-table {
    width: 100%; border-collapse: collapse;
    border: 1px solid var(--line); border-radius: 0; overflow: hidden;
    box-shadow: none; background: var(--bg);
  }
  .tenant-table thead th {
    background: var(--bg); color: var(--taupe); font-family: 'IBM Plex Mono', monospace; font-size: 10px;
    font-weight: 400; text-align: left; padding: 8px 14px;
    text-transform: uppercase; letter-spacing: 0.08em;
    border-bottom: 1px solid var(--line);
  }
  .tenant-table tbody tr { transition: background 0.1s; }
  .tenant-table tbody tr:nth-child(even) { background: rgba(246,241,233,0.5); }
  .tenant-table tbody tr:hover { background: #F6F1E9; }
  .tenant-table td { padding: 10px 12px; font-size: 13px; color: var(--ink); border-top: 1px solid var(--line); }

  .plan-badge { padding: 1px 6px; border-radius: 0; font-weight: 400; font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.06em; }
  .plan-demo { background: transparent; color: #5C6347; border: 1px solid #5C6347; }
  .plan-starter { background: transparent; color: #5C6347; border: 1px solid #5C6347; }
  .plan-pro { background: transparent; color: #5C6347; border: 1px solid #5C6347; }

  .module-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 3px; }
  .dot-on { background: var(--moutarde); }
  .dot-off { background: var(--line); }

  .sa-btn-sm {
    padding: 4px 10px; border-radius: 4px; border: 1px solid var(--ink);
    font-size: 11px; cursor: pointer; font-family: inherit;
    background: var(--bg); color: var(--ink); transition: all 0.15s;
  }
  .sa-btn-sm:hover { background: var(--bg-side); }
  .sa-btn-sm-kaki { background: var(--moutarde); color: var(--bg); border-color: var(--moutarde); }
</style>

<script>
  import { api, toast } from '../scripts/api';
  import { planLabel, isPaidPlan } from '../scripts/plans';
  import { bootstrapAuth } from '../scripts/bootstrap-auth';

  let allTenants: any[] = [];

  document.getElementById('create-header-toggle')!.addEventListener('click', () => {
    document.getElementById('create-body')!.classList.toggle('open');
  });

  document.getElementById('btn-create-tenant')!.addEventListener('click', () => {
    createTenant();
  });

  async function loadTenants(): Promise<void> {
    try {
      const data: any = await api('/api/v1/admin/tenants');
      allTenants = data.tenants || [];
      const stats: any = data.stats || {};

      document.getElementById('s-tenants')!.textContent = stats.tenants_active || 0;
      document.getElementById('s-procs')!.textContent = stats.total_procedures || 0;
      document.getElementById('s-reminders')!.textContent = stats.total_reminders || 0;
      document.getElementById('s-articles')!.textContent = stats.articles_7d || 0;

      renderTable();
    } catch (e: any) {
      document.getElementById('table-container')!.innerHTML = `<div class="loading">Erreur : ${e.message}</div>`;
    }
  }

  function renderTable(): void {
    if (!allTenants.length) {
      document.getElementById('table-container')!.innerHTML = '<div class="loading">Aucun tenant.</div>';
      return;
    }

    let html: string = `<table class="tenant-table">
      <thead><tr>
        <th>Tenant</th><th>Type</th><th>Plan</th><th>Users</th>
        <th>Procs</th><th>Reminders</th><th>Modules</th><th>Actions</th>
      </tr></thead><tbody>`;

    for (const t of allTenants) {
      const planCls: string = t.plan === 'pro' || isPaidPlan(t.plan) ? 'plan-pro' : t.plan === 'starter' ? 'plan-starter' : 'plan-demo';
      const procPct: number = t.procedures_count ? Math.round(t.procedures_validated / t.procedures_count * 100) : 0;

      const modules: any[] = [
        { key: 'procedures_enabled', label: 'Proc', on: t.procedures_enabled },
        { key: 'newsletter_enabled', label: 'News', on: t.newsletter_enabled },
        { key: 'alert_email_enabled', label: 'Email', on: t.alert_email_enabled },
      ];
      const moduleDots: string = modules.map((m: any) =>
        `<span class="module-dot ${m.on ? 'dot-on' : 'dot-off'}" title="${m.label}: ${m.on ? 'ON' : 'OFF'}"></span>`
      ).join('');

      const created: string = t.created_at ? new Date(t.created_at).toLocaleDateString('fr-FR', { day:'numeric', month:'short' }) : '';

      html += `<tr>
        <td>
          <div style="font-weight:500">${t.name}</div>
          <div style="font-size:11px;color:var(--mute)">${created}</div>
        </td>
        <td>${t.entity_type || '\u2014'}</td>
        <td><span class="plan-badge ${planCls}">${planLabel(t.plan)}</span></td>
        <td>${t.users_count}</td>
        <td>${t.procedures_validated}/${t.procedures_count} <span style="font-size:11px;color:var(--mute)">(${procPct}%)</span></td>
        <td>${t.reminders_pending > 0 ? '<b style="color:#5C6347">' + t.reminders_pending + '</b>' : '0'}</td>
        <td>${moduleDots}</td>
        <td>
          <button class="sa-btn-sm" data-toggle-module="${t.id}" data-module="procedures_enabled" data-enabled="${!t.procedures_enabled}">
            ${t.procedures_enabled ? 'Desact. Proc' : 'Act. Proc'}
          </button>
          <button class="sa-btn-sm sa-btn-sm-kaki" data-grant-all="${t.id}">+ Procs</button>
        </td>
      </tr>`;
    }

    html += '</tbody></table>';
    document.getElementById('table-container')!.innerHTML = html;

    // Bind buttons
    document.querySelectorAll('[data-toggle-module]').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        toggleModule(btn.dataset.toggleModule, btn.dataset.module, btn.dataset.enabled === 'true');
      });
    });
    document.querySelectorAll('[data-grant-all]').forEach((btn: any) => {
      btn.addEventListener('click', () => {
        grantAll(btn.dataset.grantAll);
      });
    });
  }

  async function toggleModule(tenantId: string, module: string, enabled: boolean): Promise<void> {
    try {
      await api('/api/v1/admin/tenants/toggle-module', {
        method: 'POST',
        body: { tenant_id: tenantId, module, enabled },
      });
      toast(`Module ${enabled ? 'active' : 'desactive'}`, 'success');
      loadTenants();
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  async function grantAll(tenantId: string): Promise<void> {
    try {
      await api('/api/v1/admin/procedures/grant', {
        method: 'POST',
        body: { tenant_id: tenantId, procedure_refs: [] },
      });
      toast('19 procedures attribuees', 'success');
      loadTenants();
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  async function createTenant(): Promise<void> {
    const name: string = (document.getElementById('c-name') as HTMLInputElement).value.trim();
    const email: string = (document.getElementById('c-email') as HTMLInputElement).value.trim();
    if (!name || !email) { toast('Nom et email requis', 'error'); return; }

    try {
      const result: any = await api('/api/v1/admin/tenants', {
        method: 'POST',
        body: {
          name,
          entity_type: (document.getElementById('c-type') as HTMLSelectElement).value,
          admin_email: email,
          admin_first_name: (document.getElementById('c-fn') as HTMLInputElement).value.trim(),
          admin_last_name: (document.getElementById('c-ln') as HTMLInputElement).value.trim(),
          plan: (document.getElementById('c-plan') as HTMLSelectElement).value,
        },
      });

      const box: HTMLElement = document.getElementById('create-result')!;
      const emailSent: boolean = result.welcome_email_sent === true;
      box.innerHTML = `<b>Client cree !</b><br>
        ID : ${result.tenant_id}<br>
        Email : ${result.admin_email}<br>
        ${emailSent
          ? '<span style="color:#4A5240;font-weight:500">&#10003; Email d\'acces (lien d\'activation) envoye au client.</span>'
          : '<span style="color:#C4603A;font-weight:500">&#9888; Email d\'acces NON envoye (SMTP desactive ou erreur) — verifier la config ou communiquer l\'acces autrement.</span>'}<br>
        <span style="font-size:11px;color:#6B6860">Le client definit son mot de passe via le lien recu par email.</span>`;
      box.classList.add('visible');

      (document.getElementById('c-name') as HTMLInputElement).value = '';
      (document.getElementById('c-email') as HTMLInputElement).value = '';
      (document.getElementById('c-fn') as HTMLInputElement).value = '';
      (document.getElementById('c-ln') as HTMLInputElement).value = '';

      toast('Client cree avec succes', 'success');
      loadTenants();
    } catch (e: any) {
      toast(e.message, 'error');
    }
  }

  bootstrapAuth();
  loadTenants();
</script>
