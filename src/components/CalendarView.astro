---
// Calendrier réglementaire — contenu partagé par /calendrier (back-office) et
// /app/calendrier (espace client).
//
// Statut calculé À LA DATE DU JOUR dans le navigateur (src/scripts/calendrier-dates.js) :
// une échéance passée passe en « Échue » (section dédiée), jamais « À venir ».
// Le statut de la source (colonne `statut`, figé au 07/08/2026) n'est plus affiché.
// Filtre par profil selon le champ `perimetre` des données ; liste des profils de
// l'API (GET /auth/signup-profiles, référentiel app/core/profiles.py), professions
// non financières comprises ; profil du client présélectionné.
import { calendrier, type EntreeCalendrier } from '../data/calendrier';

const aVenir: EntreeCalendrier[] = calendrier.filter((e) => e.registre === 'a_venir');
const enVigueur: EntreeCalendrier[] = calendrier.filter((e) => e.registre === 'en_vigueur');

// L'ancre structurante : application de l'AMLR — concerne TOUS.
const estAncre = (e: EntreeCalendrier): boolean => e.date === '10 juillet 2027';

// Étiquette de périmètre (champ `perimetre` des données).
const PROFIL_COURT: Record<string, string> = { casp: 'CASP', agent_sportif: 'Agents sportifs' };
const perimetreLabel = (e: EntreeCalendrier): string => {
  if (Array.isArray(e.perimetre)) return e.perimetre.map((c) => PROFIL_COURT[c] || c).join(', ');
  return { tous: 'Tous profils', financier: 'Secteur financier', etat: 'État / superviseur' }[e.perimetre] || e.perimetre;
};
const perimetreAttr = (e: EntreeCalendrier): string =>
  Array.isArray(e.perimetre) ? JSON.stringify(e.perimetre) : e.perimetre;
---
  <div class="cal-wrap">
    <div class="ew-header" style="margin-bottom:4px">
      <h1 class="ew-h-title">Calendrier réglementaire</h1>
    </div>
    <div class="cal-page-sub">
      Échéances LCB-FT vérifiées — AMLR / AMLA · MiCA-CASP · transpositions FR
    </div>

    <div class="cal-filters">
      <label class="cal-filter-label" for="cal-profile">Profil</label>
      <select id="cal-profile" class="cal-select">
        <option value="">Tous les profils</option>
        <option value="family:financier">Secteur financier (tous)</option>
        <option value="family:non_financier">Professions non financières (toutes)</option>
      </select>
      <span class="cal-today ew-mono" id="cal-today"></span>
    </div>

    <!-- ===================== À VENIR (deadline board) ===================== -->
    <section class="cal-section" data-section="a_venir">
      <h2 class="cal-section-label">À venir</h2>
      <div class="cal-list" id="cal-list-a-venir">
        {aVenir.map((e) => (
          <article
            class:list={['cal-card', { ancre: estAncre(e) }]}
            data-perimetre={perimetreAttr(e)}
            data-date={e.date}
            data-registre={e.registre}
          >
            <div class="cal-when">
              <div class="cal-date ew-mono">{e.date}</div>
              <div class="cal-rel" data-rel></div>
            </div>
            <div class="cal-body">
              <div class="cal-tags">
                {estAncre(e) && <span class="cal-pill cal-pill-ancre">Concerne tous</span>}
                <span class="cal-type ew-mono">{perimetreLabel(e)}</span>
              </div>
              <div class="cal-oblig">{e.obligation}</div>
              <div class="cal-acte ew-mono">{e.acte}</div>
              {e.note && <div class="cal-note">{e.note}</div>}
              <a class="cal-src" href={e.source_url} target="_blank" rel="noopener">Source officielle</a>
            </div>
          </article>
        ))}
      </div>
      <div class="cal-empty" data-empty="a_venir" hidden>Aucune échéance à venir pour ce profil.</div>
    </section>

    <!-- ===================== ÉCHUES (déplacées ici selon la date du jour) ===================== -->
    <section class="cal-section" data-section="echues" hidden>
      <h2 class="cal-section-label">Échéances passées</h2>
      <div class="cal-list" id="cal-list-echues"></div>
    </section>

    <!-- ===================== EN VIGUEUR (contexte) ===================== -->
    <section class="cal-section" data-section="en_vigueur">
      <h2 class="cal-section-label">En vigueur</h2>
      <div class="cal-section-hint">Ce qui s'applique déjà — contexte, pas des échéances.</div>
      <div class="cal-list">
        {enVigueur.map((e) => (
          <article
            class="cal-card"
            data-perimetre={perimetreAttr(e)}
            data-date={e.date}
            data-registre={e.registre}
          >
            <div class="cal-when">
              <div class="cal-date ew-mono">{e.date}</div>
            </div>
            <div class="cal-body">
              <div class="cal-tags">
                <span class="cal-type ew-mono">{perimetreLabel(e)}</span>
              </div>
              <div class="cal-oblig">{e.obligation}</div>
              <div class="cal-acte ew-mono">{e.acte}</div>
              {e.note && <div class="cal-note">{e.note}</div>}
              <a class="cal-src" href={e.source_url} target="_blank" rel="noopener">Source officielle</a>
            </div>
          </article>
        ))}
      </div>
      <div class="cal-empty" data-empty="en_vigueur" hidden>Aucune entrée en vigueur pour ce profil.</div>
    </section>
  </div>

<style>
  .cal-wrap { max-width: 1000px; margin: 0 auto; }

  .cal-page-sub { font-size: 13px; color: var(--mute); margin-bottom: 24px; }

  /* ---- Filtre par profil ---- */
  .cal-filters { display: flex; gap: 10px 12px; flex-wrap: wrap; align-items: center; margin-bottom: 32px; }
  .cal-filter-label { font-family: var(--font); font-size: var(--label-size); font-weight: var(--label-weight); color: var(--label-color); letter-spacing: normal; text-transform: none; }
  .cal-select {
    font-family: inherit; font-size: 13px; color: var(--ink); background: var(--bg);
    border: 0.5px solid var(--line-strong); border-radius: var(--radius);
    padding: 7px 10px; min-width: 0; max-width: 100%; flex: 0 1 340px;
  }
  .cal-today { font-size: 11px; color: var(--mute); margin-left: auto; }

  /* ---- Sections ---- */
  .cal-section { margin-bottom: 40px; }
  .cal-section-label { font-family: var(--font); font-size: var(--label-size); font-weight: var(--label-weight); color: var(--label-color); letter-spacing: normal; text-transform: none; margin: 0 0 6px; }
  .cal-section-hint { font-size: 12px; color: var(--mute); margin-bottom: 16px; }
  .cal-list { display: flex; flex-direction: column; gap: 12px; }

  /* ---- Lignes à filets, date en colonne de gauche ---- */
  .cal-list { display: block; border-top: 0.5px solid var(--line); }
  .cal-card {
    display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 4px 24px;
    padding: 16px 0 18px; border-bottom: 0.5px solid var(--line);
  }
  .cal-when { padding-top: 1px; }
  .cal-date { font-size: 13px; font-weight: 500; color: var(--ink); }
  .cal-rel { font-size: 12px; color: var(--accent); margin-top: 3px; }
  .cal-rel:empty { display: none; }
  .cal-card.is-echue .cal-date, .cal-card.is-echue .cal-oblig { color: var(--ink-soft); }
  .cal-body { min-width: 0; }

  .cal-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 6px; }
  .cal-type, .cal-pill {
    font-size: 10px; padding: 2px 7px; border: 0.5px solid var(--line-strong);
    border-radius: var(--radius-sm); white-space: nowrap;
  }
  .cal-type { color: var(--taupe); background: transparent; }
  .cal-pill-ancre {
    color: var(--on-accent); background: var(--accent); border-color: var(--accent);
    font-weight: 500; letter-spacing: normal;
  }

  .cal-oblig { font-size: 14px; font-weight: 500; line-height: 1.45; color: var(--ink); margin-bottom: 6px; }
  .cal-acte  { font-size: 10.5px; color: var(--mute); margin-bottom: 6px; overflow-wrap: anywhere; }
  .cal-note  { font-size: 12.5px; color: var(--taupe); line-height: 1.6; margin-bottom: 8px; }

  .cal-src { font-size: 11px; color: var(--taupe); text-decoration: underline; text-underline-offset: 2px; }
  .cal-src:hover { color: var(--ink); }

  .cal-empty { font-size: 13px; color: var(--mute); padding: 20px 0; }

  @media (max-width: 640px) {
    .cal-card { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .cal-when { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
    .cal-rel { margin-top: 0; }
    .cal-today { margin-left: 0; width: 100%; }
  }
</style>

<script>
  import { API, getToken } from '../scripts/api';
  import { statusOf, daysUntil, relativeLabel, isExactDate, concerns, normalizeProfileCode } from '../scripts/calendrier-dates.js';

  type Profile = { code: string | null; family: string | null };
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.cal-card'));
  const select = document.getElementById('cal-profile') as HTMLSelectElement;
  let profiles: { code: string; label: string; family: string }[] = [];

  // ── Statut du jour ────────────────────────────────────────────────────────
  const now = new Date();
  const todayEl = document.getElementById('cal-today');
  if (todayEl) todayEl.textContent = 'Au ' + now.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

  const echuesList = document.getElementById('cal-list-echues')!;
  // Pas d'étiquette de statut : la section le dit déjà. Sous la date, « dans N jours »
  // pour un jour précis, « aujourd'hui », ou « en cours » pour une période entamée.
  cards.forEach((card) => {
    const entry = { date: card.dataset.date, registre: card.dataset.registre };
    const st = statusOf(entry, now);
    if (!st) return;
    const rel = card.querySelector<HTMLElement>('[data-rel]');
    if (rel) rel.textContent = relativeLabel(st, daysUntil(entry, now), isExactDate(entry.date)) || '';
    if (st === 'echue') {
      card.classList.add('is-echue');
      echuesList.appendChild(card);   // quitte « À venir »
    }
  });

  // ── Filtre par profil ─────────────────────────────────────────────────────
  function current(): Profile | null {
    const v = select.value;
    if (!v) return null;
    if (v.startsWith('family:')) return { code: null, family: v.slice(7) };
    const p = profiles.find((x) => x.code === v);
    return p ? { code: p.code, family: p.family } : null;
  }

  const familyOf = (code: string) => profiles.find((p) => p.code === code)?.family || null;

  function apply(): void {
    const profile = current();
    cards.forEach((card) => {
      const show = concerns({ perimetre: card.dataset.perimetre }, profile, familyOf);
      card.style.display = show ? '' : 'none';
    });
    document.querySelectorAll<HTMLElement>('.cal-section').forEach((section) => {
      const all = Array.from(section.querySelectorAll<HTMLElement>('.cal-card'));
      const visible = all.some((c) => c.style.display !== 'none');
      const empty = section.querySelector<HTMLElement>('.cal-empty');
      if (section.dataset.section === 'echues') section.hidden = !visible;
      else if (empty) empty.hidden = visible;
    });
  }

  function esc(s: string): string {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  }

  async function loadProfiles(): Promise<void> {
    try {
      const r = await fetch(`${API}/api/v1/auth/signup-profiles`);
      if (!r.ok) return;
      const list = await r.json();
      profiles = Array.isArray(list) ? list : [];
      const groups: Record<string, string> = { financier: 'Secteur financier', non_financier: 'Professions non financières' };
      for (const [family, label] of Object.entries(groups)) {
        const list = profiles.filter((p) => p.family === family);
        if (!list.length) continue;
        const og = document.createElement('optgroup');
        og.label = label;
        og.innerHTML = list.map((p) => `<option value="${esc(p.code)}">${esc(p.label)}</option>`).join('');
        select.appendChild(og);
      }
    } catch { /* liste indisponible : filtre par famille seulement */ }
  }

  // Profil du client présélectionné (settings.entity_type), si connu.
  async function preselect(): Promise<void> {
    const token = getToken();
    if (!token) return;
    try {
      const r = await fetch(`${API}/api/v1/settings`, { headers: { Authorization: `Bearer ${token}` } });
      if (!r.ok) return;
      const data = await r.json();
      const code = normalizeProfileCode(data?.settings?.entity_type);
      if (code && profiles.some((p) => p.code === code)) select.value = code;
    } catch { /* pas de présélection */ }
  }

  select.addEventListener('change', apply);
  apply();
  loadProfiles().then(preselect).then(apply);
</script>
