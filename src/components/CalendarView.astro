---
// Calendrier réglementaire — contenu partagé par /calendrier (back-office) et
// /app/calendrier (espace client).
import { calendrier, type EntreeCalendrier } from '../data/calendrier';

const aVenir: EntreeCalendrier[] = calendrier.filter((e) => e.registre === 'a_venir');
const enVigueur: EntreeCalendrier[] = calendrier.filter((e) => e.registre === 'en_vigueur');

// L'ancre structurante : application de l'AMLR — concerne TOUS.
const estAncre = (e: EntreeCalendrier): boolean => e.date === '10 juillet 2027';
// Jalons du processus de sélection (supervision directe) : périmètre restreint.
const estSelection = (e: EntreeCalendrier): boolean =>
  e.note.toLowerCase().includes('susceptibles de sélection');

const typeLabel: Record<string, string> = {
  tous: 'Tous',
  CASP: 'CASP',
  PSP: 'PSP',
  EME: 'EME',
};
---
  <div class="cal-wrap">
    <div class="ew-header" style="margin-bottom:4px">
      <h1 class="ew-h-title">Calendrier réglementaire</h1>
    </div>
    <div class="cal-page-sub">
      Échéances LCB-FT vérifiées — AMLR / AMLA · MiCA-CASP · transpositions FR
    </div>

    <div class="cal-filters" id="cal-filters" role="group" aria-label="Filtrer par type d'établissement">
      <button class="cal-fbtn active" data-type="tous">Tous</button>
      <button class="cal-fbtn" data-type="CASP">CASP</button>
      <button class="cal-fbtn" data-type="PSP">PSP</button>
      <button class="cal-fbtn" data-type="EME">EME</button>
    </div>

    <!-- ===================== À VENIR (deadline board) ===================== -->
    <section class="cal-section" data-section="a_venir">
      <div class="cal-section-label">À venir</div>
      <div class="cal-list">
        {aVenir.map((e) => (
          <article
            class:list={['cal-card', { ancre: estAncre(e), selection: estSelection(e) }]}
            data-type={e.type_etablissement}
          >
            <div class="cal-card-top">
              <div class="cal-date ew-mono">{e.date}</div>
              <div class="cal-tags">
                {estAncre(e) && <span class="cal-pill cal-pill-ancre">Concerne TOUS</span>}
                {estSelection(e) && <span class="cal-pill cal-pill-selection">Sélection uniquement</span>}
                <span class="cal-statut">{e.statut}</span>
                <span class="cal-type ew-mono">{typeLabel[e.type_etablissement]}</span>
              </div>
            </div>
            <div class="cal-oblig">{e.obligation}</div>
            <div class="cal-acte ew-mono">{e.acte}</div>
            {e.note && <div class="cal-note">{e.note}</div>}
            <a class="cal-src" href={e.source_url} target="_blank" rel="noopener">Source officielle</a>
          </article>
        ))}
      </div>
      <div class="cal-empty" data-empty="a_venir" hidden>Aucune échéance à venir pour ce type d'établissement.</div>
    </section>

    <!-- ===================== EN VIGUEUR (contexte) ===================== -->
    <section class="cal-section" data-section="en_vigueur">
      <div class="cal-section-label">En vigueur</div>
      <div class="cal-section-hint">Ce qui s'applique déjà — contexte, pas des échéances.</div>
      <div class="cal-list">
        {enVigueur.map((e) => (
          <article class="cal-card cal-card-context" data-type={e.type_etablissement}>
            <div class="cal-card-top">
              <div class="cal-date ew-mono">{e.date}</div>
              <div class="cal-tags">
                <span class="cal-statut">{e.statut}</span>
                <span class="cal-type ew-mono">{typeLabel[e.type_etablissement]}</span>
              </div>
            </div>
            <div class="cal-oblig">{e.obligation}</div>
            <div class="cal-acte ew-mono">{e.acte}</div>
            {e.note && <div class="cal-note">{e.note}</div>}
            <a class="cal-src" href={e.source_url} target="_blank" rel="noopener">Source officielle</a>
          </article>
        ))}
      </div>
      <div class="cal-empty" data-empty="en_vigueur" hidden>Aucune entrée en vigueur pour ce type d'établissement.</div>
    </section>
  </div>


<style>
  .cal-wrap { max-width: 1000px; margin: 0 auto; }

  .cal-page-sub   { font-size: 13px; color: var(--mute); margin-bottom: 28px; }

  /* ---- Filtres (calqué sur .fbtn de la roadmap) ---- */
  .cal-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 32px; }
  .cal-fbtn {
    padding: 5px 14px; border: 0.5px solid var(--line-strong);
    background: transparent; font-size: 12px; color: var(--taupe);
    cursor: pointer; font-family: inherit; transition: all 0.12s;
    border-radius: 0;
  }
  .cal-fbtn:hover  { background: var(--bg-side); color: var(--ink); }
  .cal-fbtn.active { background: var(--ink); border-color: var(--ink); color: var(--bg); }

  /* ---- Sections ---- */
  .cal-section { margin-bottom: 40px; }
  .cal-section-label {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.16em; color: var(--taupe); text-transform: uppercase;
    margin-bottom: 6px;
  }
  .cal-section-hint { font-size: 12px; color: var(--mute); margin-bottom: 16px; }
  .cal-list { display: flex; flex-direction: column; gap: 12px; }

  /* ---- Cartes ---- */
  .cal-card {
    background: var(--bg); border: 0.5px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 18px; transition: border-color 0.12s;
  }
  .cal-card:hover { border-color: var(--line-strong); }
  .cal-card-context { background: var(--bg-side); }
  .cal-card.ancre { border-left: 2px solid var(--moutarde); }

  .cal-card-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 12px; margin-bottom: 10px;
  }
  .cal-date { font-size: 13px; font-weight: 500; color: var(--ink); }

  .cal-tags { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .cal-statut, .cal-type, .cal-pill {
    font-size: 10px; padding: 3px 7px; border: 0.5px solid var(--line);
    border-radius: 0; white-space: nowrap;
  }
  .cal-statut { color: var(--mute); background: var(--bg-side); }
  .cal-type   { color: var(--taupe); background: transparent; }
  .cal-pill-ancre {
    color: var(--on-accent); background: var(--moutarde); border-color: var(--moutarde);
    font-weight: 500; letter-spacing: 0.02em;
  }
  .cal-pill-selection { color: var(--taupe); background: var(--bg-hover); }

  .cal-oblig { font-size: 14px; font-weight: 500; line-height: 1.4; color: var(--ink); margin-bottom: 8px; }
  .cal-acte  { font-size: 10.5px; color: var(--mute); margin-bottom: 8px; }
  .cal-note  { font-size: 12.5px; color: var(--taupe); line-height: 1.6; margin-bottom: 10px; }
  .cal-card.selection .cal-note { color: var(--ink-soft); }

  .cal-src { font-size: 11px; color: var(--taupe); text-decoration: underline; text-underline-offset: 2px; }
  .cal-src:hover { color: var(--ink); }

  .cal-empty { font-size: 13px; color: var(--mute); padding: 20px 0; }

  @media (max-width: 640px) {
    .cal-card-top { flex-direction: column; gap: 8px; }
    .cal-tags { justify-content: flex-start; }
  }
</style>

<script>
  // Filtrage client par type d'établissement. Une entrée "tous" reste visible
  // sous n'importe quel filtre (elle concerne tous les types).
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.cal-fbtn'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.cal-card'));

  function apply(type: string): void {
    cards.forEach((card) => {
      const t = card.dataset.type || 'tous';
      const show = type === 'tous' || t === 'tous' || t === type;
      card.style.display = show ? '' : 'none';
    });
    // État vide par section
    document.querySelectorAll<HTMLElement>('.cal-section').forEach((section) => {
      const visible = Array.from(section.querySelectorAll<HTMLElement>('.cal-card'))
        .some((c) => c.style.display !== 'none');
      const empty = section.querySelector<HTMLElement>('.cal-empty');
      if (empty) empty.hidden = visible;
    });
  }

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      btns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      apply(btn.dataset.type || 'tous');
    });
  });
</script>
