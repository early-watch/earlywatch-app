---
import { MENU_PAGES, HOME_PAGE } from '../data/client-pages';

interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside class="ew-side" id="ew-side">

  <a href={`${base}${HOME_PAGE.path}`} class="ew-logo">Early <span>Watch</span></a>

  <nav aria-label="Menu principal">
    {MENU_PAGES.map((p) => (
      <a href={`${base}${p.path}`} class:list={['ew-nav', { active: activePage === p.key }]}
         aria-current={activePage === p.key ? 'page' : undefined}>
        <span>{p.label}</span>
        {(p.key === 'fil' || p.key === 'suivis') && <span class="ew-count" data-count={p.key} hidden></span>}
      </a>
    ))}
  </nav>

  <!-- Footer utilisateur -->
  <div class="ew-user">
    <div id="client-nav-avatar" class="ew-avatar">?</div>
    <div style="min-width:0">
      <div id="client-nav-name" style="font-size:12px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
        Mon compte
      </div>
      <div id="client-nav-tenant" style="font-size:11px;color:var(--taupe);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
        &nbsp;
      </div>
    </div>
  </div>
  <a href="#" id="client-nav-logout" class="ew-settings-link" style="padding:0 22px 4px">Se déconnecter</a>

</aside>

<script>
  import { api, getUser, logout } from '../scripts/api';
  import { levelOf } from '../scripts/fil.js';

  function initClientNav() {
    const user = getUser();
    if (!user) return;

    // Avatar initiales
    const initials = (user.first_name?.[0] || '') + (user.last_name?.[0] || '');
    const avatarEl = document.getElementById('client-nav-avatar');
    if (avatarEl) avatarEl.textContent = initials || '?';

    // Nom + tenant
    const nameEl   = document.getElementById('client-nav-name');
    const tenantEl = document.getElementById('client-nav-tenant');
    if (nameEl) {
      nameEl.textContent = [user.first_name, user.last_name].filter(Boolean).join(' ') || 'Mon compte';
    }
    if (tenantEl) {
      tenantEl.textContent = user.tenant_name || '—';
    }
  }

  // Compteurs du menu, rafraîchis après une action (événement « ew:counts-changed ») :
  //   Fil    = publications de niveau Action à traiter (même règle que le titre du Fil) ;
  //   Suivis = publications suivies (statut to_process).
  function setCount(key, n) {
    const el = document.querySelector(`[data-count="${key}"]`);
    if (!el) return;
    el.textContent = n > 0 ? String(n) : '';
    el.hidden = !(n > 0);
  }
  async function loadCounts() {
    try {
      const [inbox, c] = await Promise.all([
        api('/api/v1/app/articles?status=inbox&page_size=200'),
        api('/api/v1/app/articles/counts'),
      ]);
      setCount('fil', (inbox?.articles || []).filter((a) => levelOf(a) === 'action').length);
      setCount('suivis', c?.to_process ?? 0);
    } catch { /* compteurs facultatifs */ }
  }

  document.getElementById('client-nav-logout')?.addEventListener('click', (e) => { e.preventDefault(); logout(); });

  initClientNav();
  loadCounts();
  window.addEventListener('ew:counts-changed', loadCounts);
  document.addEventListener('astro:after-swap', () => {
    initClientNav();
    loadCounts();
  });
</script>
