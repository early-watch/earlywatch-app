---
import { MENU_PAGES, HOME_PAGE } from '../data/client-pages';

interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside class="ew-side" id="ew-side">

  <!-- Bannière impersonation — visible uniquement quand Maria simule le tenant -->
  <div id="impersonate-banner" style="display:none;background:var(--accent);padding:8px 16px;margin-bottom:8px">
    <button
      id="btn-back-admin"
      style="width:100%;background:none;border:none;color:var(--on-accent);font-size:12px;font-weight:500;font-family:var(--font-mono);letter-spacing:0.08em;cursor:pointer;text-align:left;padding:0"
    >
      ← Retour admin Early Brief
    </button>
  </div>

  <a href={`${base}${HOME_PAGE.path}`} class="ew-logo">Early <span>Watch</span></a>

  <nav aria-label="Menu principal">
    {MENU_PAGES.map((p) => (
      <a href={`${base}${p.path}`} class:list={['ew-nav', { active: activePage === p.key }]}
         aria-current={activePage === p.key ? 'page' : undefined}>
        {p.label}
      </a>
    ))}
  </nav>

  <!-- Footer utilisateur -->
  <div class="ew-user">
    <div id="client-nav-avatar" class="ew-avatar">?</div>
    <div style="min-width:0">
      <div id="client-nav-name" style="font-size:12px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
        Mon compte
      </div>
      <div id="client-nav-tenant" style="font-size:11px;color:var(--taupe);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
        &nbsp;
      </div>
    </div>
  </div>
  <a href="#" id="client-nav-logout" class="ew-settings-link" style="padding:0 22px 4px">Se déconnecter</a>

</aside>

<script>
  import { getUser, isImpersonating, stopImpersonation, logout } from '../scripts/api';

  const BASE = import.meta.env.BASE_URL || '/earlywatch-app/';

  function initClientNav() {
    const user = getUser();
    if (!user) return;

    // Avatar initiales
    const initials = (user.first_name?.[0] || '') + (user.last_name?.[0] || '');
    const avatarEl = document.getElementById('client-nav-avatar');
    if (avatarEl) avatarEl.textContent = initials || '?';

    // Nom + tenant
    const nameEl   = document.getElementById('client-nav-name');
    const tenantEl = document.getElementById('client-nav-tenant');
    if (nameEl) {
      nameEl.textContent = [user.first_name, user.last_name].filter(Boolean).join(' ') || 'Mon compte';
    }
    if (tenantEl) {
      tenantEl.textContent = user.tenant_name || '—';
    }

    // Bannière impersonation
    const banner = document.getElementById('impersonate-banner');
    if (banner && isImpersonating()) {
      banner.style.display = 'block';
    }
  }

  function initBackAdmin() {
    const btn = document.getElementById('btn-back-admin');
    if (!btn) return;
    btn.addEventListener('click', () => {
      stopImpersonation();
      window.location.href = BASE + 'dashboard';
    });
  }

  document.getElementById('client-nav-logout')?.addEventListener('click', (e) => { e.preventDefault(); logout(); });

  initClientNav();
  initBackAdmin();
  document.addEventListener('astro:after-swap', () => {
    initClientNav();
    initBackAdmin();
  });
</script>
